    // ---- save + assign + reload preview ----  
    var applyTimer=null;  
    var applyBusy=false;  
    var applyQueued=false;  

    function appendShellFields(body, vals){  
      body.append('shell_kind',SHELL_KIND);  
      body.append('shell_name',SHELL_NAME);  
      for(var k in vals){ if(vals.hasOwnProperty(k)) body.append(k,vals[k]==null?'':vals[k]); }  
    }  

    function applyChanges(){  
      if(applyBusy){ applyQueued=true; return; }  
      applyBusy=true;  
      applyQueued=false;  
      status('Saving...');  
      var vals=collect();  
      var body=new FormData();  
      body.append('shell_action','save');  
      appendShellFields(body, vals);  
      var applyOk=false;  
      fetch('/PyScriptForm/'+SCRIPT_NAME,{method:'POST',body:body,credentials:'same-origin'})  
        .then(function(r){return r.text();})  
        .then(function(txt){  
          var err=shePostError(txt);  
          if(err) throw new Error(err);  
          return assignShell();  
        })  
        .then(function(){ applyOk=true; status('Updated'); })  
        .catch(function(e){ status('Error: '+((e&&e.message)||e)); })  
        .then(function(){  
          applyBusy=false;  
          // More edits landed during the save — coalesce into the next write.  
          if(applyQueued){ applyChanges(); return; }  
          // Debounced applyNow still pending — that save will refresh the preview.  
          if(applyTimer) return;  
          if(applyOk) reloadPreview();  
        });  
    }  

    function shePostError(txt){  
      var m=(txt||'').match(/ERROR:\\s*([^<\\r\\n]+)/);  
      if(m) return m[1].trim();  
      // Tracebacks are failures even without an ERROR: prefix.  
      if(/traceback \\(most recent call last\\)/i.test(txt||'')) return 'server error';  
      return '';  
    }  
    function shePostSaveAsName(txt, fallback){  
      var m=(txt||'').match(/OK:([A-Za-z][A-Za-z0-9_]*)/);  
      return m?m[1]:fallback;  
    }  

    function sheSaveAs(){  
      var name=window.prompt('New shell name (letters, numbers, underscore; no spaces):','');  
      if(name==null) return;  
      name=String(name).trim();  
      if(!SHELL_NAME_RE.test(name)){  
        status('Error: invalid shell name');  
        return;  
      }  
      if(applyBusy){ status('Wait for save to finish'); return; }  
      applyBusy=true;  
      status('Saving as '+name+'...');  
      var vals=collect();  
      var body=new FormData();  
      body.append('shell_action','save_as');  
      body.append('new_shell_name',name);  
      appendShellFields(body, vals);  
      fetch('/PyScriptForm/'+SCRIPT_NAME,{method:'POST',body:body,credentials:'same-origin'})  
        .then(function(r){return r.text();})  
        .then(function(txt){  
          var err=shePostError(txt);  
          if(err) throw new Error(err);  
          // Open the new shell in the editor (selected in the dropdown + preview assigned).  
          var saved=shePostSaveAsName(txt, name);  
          status('Opening '+saved+'...');  
          window.location=sheEditorUrl(SHELL_KIND, saved);  
        })  
        .catch(function(e){  
          status('Error: '+((e&&e.message)||e));  
          applyBusy=false;  
        });  
    }  

    var shellAssigned=false;  
    function sheSelectHasShell(name){  
      var sel=$('she-shell-select');  
      if(!sel || !name) return false;  
      for(var i=0;i<sel.options.length;i++){  
        if(sel.options[i].value===name) return true;  
      }  
      return false;  
    }  
    function assignShellFromSettings(settings){  
      // Registration preview pins the selected shell on the test involvement.  
      if(!settings) return;  
      if(settings.regShellId===SHELL_NAME){ shellAssigned=true; return; }  
      settings.regShellId=SHELL_NAME;  
      return fetch(SETTINGS_URL,{method:'POST',credentials:'same-origin',  
        headers:{'Content-Type':'application/json'},body:JSON.stringify(settings)})  
        .then(function(){ shellAssigned=true; });  
    }  
    function assignShell(){  
      // Giving working-copy + login SetSetting are handled server-side on load/save.  
      if(!CAN_ASSIGN || shellAssigned) return Promise.resolve();  
      return fetch(SETTINGS_URL,{method:'GET',credentials:'same-origin',headers:{'Accept':'application/json'}})  
        .then(function(r){return r.json();})  
        .then(function(settings){ return assignShellFromSettings(settings); });  
    }  
    function ensureRegistrationShell(){  
      // Before pinning, if no shell was chosen in the URL, jump to the involvement's  
      // current templated shell so we do not overwrite it with the template default.  
      if(!CAN_ASSIGN) return Promise.resolve();  
      if(shellAssigned) return Promise.resolve();  
      return fetch(SETTINGS_URL,{method:'GET',credentials:'same-origin',headers:{'Accept':'application/json'}})  
        .then(function(r){return r.json();})  
        .then(function(settings){  
          var cur=String((settings&&settings.regShellId)||'').trim();  
          if(!SHELL_NAME_EXPLICIT && cur && cur!==SHELL_NAME && sheSelectHasShell(cur)){  
            window.location=sheEditorUrl('registration', cur);  
            return new Promise(function(){});  
          }  
          return assignShellFromSettings(settings);  
        });  
    }  

    function sheSetView(mode){  
      var wrap=$('she-frame-wrap');  
      if(!wrap) return;  
      if(wrap.classList.contains(mode)) return;  
      wrap.classList.add('she-view-animating');  
      wrap.classList.remove('desktop','mobile');  
      wrap.classList.add(mode);  
      var d=$('she-view-desktop'), m=$('she-view-mobile');  
      if(d) d.classList.toggle('active', mode==='desktop');  
      if(m) m.classList.toggle('active', mode==='mobile');  
      clearTimeout(wrap._sheViewTimer);  
      wrap._sheViewTimer=setTimeout(function(){ wrap.classList.remove('she-view-animating'); },400);  
    }  
    function sheTogglePanel(){  
      var root=$('she-wrap');  
      if(!root) return;  
      root.classList.toggle('she-collapsed');  
    }  

    function reloadPreview(){  
      var f=$('she-frame');  
      if(!f) return;  
      var base=PREVIEW_URL||('/OnlineReg/'+INVID);  
      var sep=base.indexOf('?')>=0?'&':'?';  
      f.src=base+sep+'t='+Date.now();  
    }  

    // ---- image upload / preview helpers ----  
    function sheSetImageField(key,url){  
      var fld=$('fld_'+key), th=$('thumb_'+key), wrap=$('thumbwrap_'+key);  
      if(fld) fld.value=url||'';  
      if(th) th.src=url||'';  
      if(wrap){  
        wrap.classList.toggle('she-thumb-empty', !url);  
        var hint=wrap.querySelector('.she-thumb-hint');  
        if(hint) hint.textContent=url?'Click to edit':'No image yet';  
      }  
    }  
    function sheClearImage(key){  
      sheSetImageField(key,'');  
      var file=$('file_'+key); if(file) file.value='';  
      applyNow();  
    }  
    // PostUploadImage often converts PNGs to JPEG and drops alpha (transparent  
    // pixels become black). For transparent images we embed a resized PNG data  
    // URL in the shell instead of uploading through that API.  
    var SHE_MAX_UPLOAD_EDGE=1200;  
    function sheGuessImageFilename(blob, preferred){  
      var t=((blob&&blob.type)||'').toLowerCase();  
      if(t.indexOf('png')>=0) return 'image.png';  
      if(t.indexOf('webp')>=0) return 'image.webp';  
      if(t.indexOf('gif')>=0) return 'image.gif';  
      if(t.indexOf('jpeg')>=0||t.indexOf('jpg')>=0) return 'image.jpg';  
      var p=(preferred||'').toLowerCase();  
      if(/\.png$/i.test(p)) return preferred;  
      if(/\.webp$/i.test(p)) return preferred;  
      if(/\.gif$/i.test(p)) return preferred;  
      if(/\.jpe?g$/i.test(p)) return preferred;  
      return preferred||'image.png';  
    }  
    function sheFitUploadSize(w,h){  
      w=Math.max(1,Math.round(w)); h=Math.max(1,Math.round(h));  
      var edge=Math.max(w,h);  
      if(edge<=SHE_MAX_UPLOAD_EDGE) return {w:w,h:h};  
      var s=SHE_MAX_UPLOAD_EDGE/edge;  
      return {w:Math.max(1,Math.round(w*s)), h:Math.max(1,Math.round(h*s))};  
    }  
    function sheImgHasTransparency(img){  
      try{  
        if(!img||!img.naturalWidth||!img.naturalHeight) return false;  
        var w=Math.max(1,Math.min(img.naturalWidth,96));  
        var h=Math.max(1,Math.min(img.naturalHeight,96));  
        var cv=document.createElement('canvas');  
        cv.width=w; cv.height=h;  
        var ctx=cv.getContext('2d',{alpha:true,willReadFrequently:true});  
        if(!ctx) return false;  
        ctx.clearRect(0,0,w,h);  
        ctx.drawImage(img,0,0,w,h);  
        var data=ctx.getImageData(0,0,w,h).data;  
        for(var i=3;i<data.length;i+=4){ if(data[i]<250) return true; }  
      }catch(e){}  
      return false;  
    }  
    function sheCanvasToPngBlob(cv){  
      return new Promise(function(resolve,reject){  
        if(cv.toBlob){  
          cv.toBlob(function(b){  
            if(!b){ reject(new Error('toBlob failed')); return; }  
            if(!b.type || b.type!=='image/png'){  
              try{ b=new Blob([b],{type:'image/png'}); }catch(e){}  
            }  
            resolve(b);  
          },'image/png');  
          return;  
        }  
        try{  
          fetch(cv.toDataURL('image/png')).then(function(r){return r.blob();}).then(resolve,reject);  
        }catch(e){ reject(e); }  
      });  
    }  
    function sheImageRegionToPngBlob(img,sx,sy,sw,sh,dw,dh){  
      var cv=document.createElement('canvas');  
      cv.width=Math.max(1,Math.round(dw));  
      cv.height=Math.max(1,Math.round(dh));  
      var ctx=cv.getContext('2d',{alpha:true,willReadFrequently:true});  
      if(!ctx) return Promise.reject(new Error('no 2d context'));  
      ctx.clearRect(0,0,cv.width,cv.height);  
      ctx.drawImage(img,sx,sy,sw,sh,0,0,cv.width,cv.height);  
      try{ ctx.getImageData(0,0,1,1); }catch(err){ return Promise.reject(err); }  
      return sheCanvasToPngBlob(cv);  
    }  
    function sheBlobToDataURL(blob){  
      return new Promise(function(resolve,reject){  
        var fr=new FileReader();  
        fr.onload=function(){ resolve(fr.result); };  
        fr.onerror=function(){ reject(fr.error||new Error('read failed')); };  
        fr.readAsDataURL(blob);  
      });  
    }  
    function shePrepareImage(img, sourceBlob, filename, sx,sy,sw,sh){  
      // sx..sh optional crop in natural pixels; default = full image.  
      var nw=img&&img.naturalWidth||0, nh=img&&img.naturalHeight||0;  
      if(!nw||!nh) return Promise.reject(new Error('image not ready'));  
      if(sx==null){ sx=0; sy=0; sw=nw; sh=nh; }  
      var hasAlpha=sheImgHasTransparency(img);  
      var fit=sheFitUploadSize(sw,sh);  
      var needsEncode=hasAlpha || fit.w!==Math.round(sw) || fit.h!==Math.round(sh) || sx!==0 || sy!==0 || sw!==nw || sh!==nh;  
      if(needsEncode || hasAlpha){  
        status(hasAlpha?'Embedding transparent PNG...':'Preparing image...');  
        return sheImageRegionToPngBlob(img,sx,sy,sw,sh,fit.w,fit.h).then(function(b){  
          return {blob:b, filename:'image.png', embed:!!hasAlpha};  
        });  
      }  
      if(sourceBlob){  
        return Promise.resolve({  
          blob:sourceBlob,  
          filename:sheGuessImageFilename(sourceBlob,filename||'image.png'),  
          embed:false  
        });  
      }  
      return sheImageRegionToPngBlob(img,0,0,nw,nh,nw,nh).then(function(b){  
        return {blob:b, filename:'image.png', embed:false};  
      });  
    }  
    function sheCommitImage(key, prep){  
      var file=$('file_'+key);  
      if(prep.embed){  
        // Bypass PostUploadImage entirely — it strips alpha to black.  
        return sheBlobToDataURL(prep.blob).then(function(dataUrl){  
          sheSetImageField(key, dataUrl);  
          if(file) file.value='';  
          applyNow();  
          status('Updated');  
          return dataUrl;  
        });  
      }  
      status('Uploading image...');  
      var fd=new FormData();  
      var named=prep.filename||sheGuessImageFilename(prep.blob,'image.png');  
      var fileOut=prep.blob;  
      var mime=(prep.blob&&prep.blob.type)||(/\.png$/i.test(named)?'image/png':'');  
      try{  
        if(typeof File!=='undefined'){  
          fileOut=new File([prep.blob], named, {type: mime||'application/octet-stream'});  
        }  
      }catch(e){ fileOut=prep.blob; }  
      fd.append('file',fileOut,named);  
      return fetch(UPLOAD_URL,{method:'POST',body:fd,credentials:'same-origin'})  
        .then(function(r){return r.json();})  
        .then(function(data){  
          var url=data.url;  
          if(!url) throw 'no url in response';  
          // Host flattened PNG→JPEG: fall back to an embedded data URL.  
          if(/\.png$/i.test(named) && /\.jpe?g(\?|$)/i.test(url||'')){  
            return sheBlobToDataURL(prep.blob).then(function(dataUrl){  
              sheSetImageField(key, dataUrl);  
              if(file) file.value='';  
              applyNow();  
              status('Updated (embedded to keep transparency)');  
              return dataUrl;  
            });  
          }  
          sheSetImageField(key,url);  
          if(file) file.value='';  
          applyNow();  
          status('Updated');  
          return url;  
        });  
    }  
    function uploadBlob(blob,filename,key){  
      // Kept for any remaining callers; prefer sheCommitImage.  
      return sheCommitImage(key, {blob:blob, filename:filename||'image.png', embed:false})  
        .catch(function(e){ status('Upload error: '+e); throw e; });  
    }  

    // =================== IMAGE EDIT / CROPPER ===================  
    // Flow: open full image -> Cancel / Crop / Upload. Crop enables a full-size crop box.  
    var cropState={key:null,box:{x:0,y:0,w:0,h:0},objectUrl:null,sourceBlob:null,filename:'image.png',remoteUrl:null,cropping:false};  
    function sheRevokeCropUrl(){  
      if(cropState.objectUrl){  
        try{ URL.revokeObjectURL(cropState.objectUrl); }catch(e){}  
        cropState.objectUrl=null;  
      }  
    }  
    var cropBgDark=false;  
    function sheSyncCropBgUi(){  
      var stage=$('she-crop-stage'), btn=$('she-crop-bg-toggle');  
      if(stage) stage.classList.toggle('she-crop-dark', !!cropBgDark);  
      if(btn){  
        btn.classList.toggle('she-crop-dark', !!cropBgDark);  
        btn.title=cropBgDark?'Light background':'Dark background';  
        btn.setAttribute('aria-label', btn.title);  
        btn.setAttribute('aria-pressed', cropBgDark?'true':'false');  
      }  
    }  
    function sheToggleCropBg(){  
      cropBgDark=!cropBgDark;  
      sheSyncCropBgUi();  
    }  
    function sheSyncCropUi(){  
      var stage=$('she-crop-stage'), help=$('she-crop-help'), title=$('she-crop-title');  
      var startBtn=$('she-crop-start'), uploadBtn=$('she-crop-upload');  
      var cropping=!!cropState.cropping;  
      if(stage) stage.classList.toggle('she-cropping', cropping);  
      if(title) title.textContent=cropping?'Crop image':'Edit image';  
      if(help) help.textContent=cropping  
        ?'Drag to move the crop. Use the handles to resize, then upload.'  
        :'Upload the full image, or choose Crop to trim it first.';  
      if(startBtn) startBtn.style.display=cropping?'none':'';  
      if(uploadBtn) uploadBtn.textContent=cropping?'Upload cropped':'Upload';  
      sheSyncCropBgUi();  
    }  
    function sheShowImageEditor(key,src,opts){  
      opts=opts||{};  
      var img=$('she-crop-img');  
      sheRevokeCropUrl();  
      cropState.key=key;  
      cropState.objectUrl=opts.objectUrl||null;  
      cropState.sourceBlob=opts.sourceBlob||null;  
      cropState.filename=opts.filename||'image.png';  
      cropState.remoteUrl=opts.remoteUrl||null;  
      cropState.cropping=false;  
      cropState.box={x:0,y:0,w:0,h:0};  
      function ready(){  
        $('she-crop-modal').classList.add('open');  
        sheSyncCropUi();  
      }  
      img.onload=ready;  
      img.onerror=function(){  
        sheRevokeCropUrl();  
        status('');  
        alert('Could not load that image. Try choosing a local file instead.');  
      };  
      img.removeAttribute('crossorigin');  
      img.src=src;  
      if(img.complete&&img.naturalWidth) ready();  
    }  
    function sheOpenCrop(key){  
      var file=$('file_'+key);  
      var fld=$('fld_'+key);  
      var url=fld?(fld.value||'').trim():'';  
      if(file&&file.files&&file.files[0]){  
        var f=file.files[0];  
        var fr=new FileReader();  
        fr.onload=function(e){  
          sheShowImageEditor(key,e.target.result,{sourceBlob:f,filename:f.name||'image.png'});  
        };  
        fr.readAsDataURL(f);  
        return;  
      }  
      if(!url){  
        alert('Choose an image file or set an image URL first.');  
        return;  
      }  
      status('Loading image...');  
      fetch(url,{credentials:'same-origin',mode:'cors'})  
        .then(function(r){  
          if(!r.ok) throw new Error('HTTP '+r.status);  
          return r.blob();  
        })  
        .then(function(blob){  
          if(!blob||!blob.size) throw new Error('empty image');  
          var obj=URL.createObjectURL(blob);  
          status('');  
          sheShowImageEditor(key,obj,{  
            objectUrl:obj,  
            sourceBlob:blob,  
            filename:sheGuessImageFilename(blob, url.split('?')[0].split('/').pop()||'image.png'),  
            remoteUrl:url  
          });  
        })  
        .catch(function(){  
          status('');  
          sheShowImageEditor(key,url,{remoteUrl:url});  
        });  
    }  
    function sheStartCrop(){  
      var img=$('she-crop-img');  
      if(!img||!img.naturalWidth){ alert('Image is not ready yet.'); return; }  
      var w=img.clientWidth||img.naturalWidth, h=img.clientHeight||img.naturalHeight;  
      if(!w||!h) return;  
      // Start the crop box at the full image.  
      cropState.cropping=true;  
      cropState.box={x:0,y:0,w:w,h:h};  
      sheSyncCropUi();  
      drawCrop();  
    }  
    function drawCrop(){  
      var b=$('she-crop-box'), s=cropState.box;  
      if(!b||!s) return;  
      b.style.left=s.x+'px'; b.style.top=s.y+'px';  
      b.style.width=s.w+'px'; b.style.height=s.h+'px';  
    }  
    (function wireCrop(){  
      function clamp(){  
        var img=$('she-crop-img'); var s=cropState.box;  
        if(!img||!s) return;  
        var iw=img.clientWidth, ih=img.clientHeight;  
        if(s.w<20)s.w=20; if(s.h<20)s.h=20;  
        if(s.w>iw)s.w=iw; if(s.h>ih)s.h=ih;  
        if(s.x<0)s.x=0; if(s.y<0)s.y=0;  
        if(s.x+s.w>iw)s.x=iw-s.w;  
        if(s.y+s.h>ih)s.y=ih-s.h;  
      }  
      document.addEventListener('mousedown',function(ev){  
        var modal=$('she-crop-modal');  
        if(!modal||!modal.classList.contains('open')||!cropState.cropping) return;  
        var box=$('she-crop-box'); if(!box) return;  
        var handle=ev.target.getAttribute && ev.target.getAttribute('data-h');  
        var onBox=(ev.target===box);  
        if(!handle && !onBox) return;  
        ev.preventDefault();  
        var start={x:ev.clientX,y:ev.clientY,box:{x:cropState.box.x,y:cropState.box.y,w:cropState.box.w,h:cropState.box.h}};  
        function move(e){  
          var dx=e.clientX-start.x, dy=e.clientY-start.y, s=cropState.box, o=start.box;  
          if(onBox){ s.x=o.x+dx; s.y=o.y+dy; }  
          else{  
            if(handle.indexOf('e')>-1){ s.w=o.w+dx; }  
            if(handle.indexOf('s')>-1){ s.h=o.h+dy; }  
            if(handle.indexOf('w')>-1){ s.x=o.x+dx; s.w=o.w-dx; }  
            if(handle.indexOf('n')>-1){ s.y=o.y+dy; s.h=o.h-dy; }  
          }  
          clamp(); drawCrop();  
        }  
        function up(){ document.removeEventListener('mousemove',move); document.removeEventListener('mouseup',up); }  
        document.addEventListener('mousemove',move);  
        document.addEventListener('mouseup',up);  
      });  
    })();  
    function sheCropCancel(){  
      $('she-crop-modal').classList.remove('open');  
      var stage=$('she-crop-stage'); if(stage) stage.classList.remove('she-cropping');  
      sheRevokeCropUrl();  
      cropState.cropping=false;  
      cropState.sourceBlob=null;  
      cropState.remoteUrl=null;  
    }  
    function sheUploadImage(){  
      if(cropState.cropping){ sheCropConfirm(); return; }  
      var img=$('she-crop-img');  
      if(cropState.sourceBlob || (img&&img.src&&img.src.indexOf('data:')===0)){  
        var ready=cropState.sourceBlob  
          ? Promise.resolve(cropState.sourceBlob)  
          : fetch(img.src).then(function(r){return r.blob();});  
        ready  
          .then(function(blob){  
            return shePrepareImage(img, blob, cropState.filename||'image.png');  
          })  
          .then(function(prep){ return sheCommitImage(cropState.key, prep); })  
          .then(function(){ sheCropCancel(); })  
          .catch(function(e){ status('Error: '+e); alert('Could not save this image.'); });  
        return;  
      }  
      if(cropState.remoteUrl){  
        sheSetImageField(cropState.key,cropState.remoteUrl);  
        applyNow();  
        sheCropCancel();  
        return;  
      }  
      alert('Nothing to upload.');  
    }  
    function sheCropConfirm(){  
      var img=$('she-crop-img'), s=cropState.box;  
      if(!img||!img.naturalWidth){ alert('Image is not ready yet.'); return; }  
      var scaleX=img.naturalWidth/img.clientWidth, scaleY=img.naturalHeight/img.clientHeight;  
      if(!isFinite(scaleX)||!isFinite(scaleY)||scaleX<=0||scaleY<=0){  
        alert('Could not measure the image for cropping.'); return;  
      }  
      shePrepareImage(  
        img, null, 'cropped.png',  
        s.x*scaleX, s.y*scaleY, s.w*scaleX, s.h*scaleY  
      ).then(function(prep){ return sheCommitImage(cropState.key, prep); })  
        .then(function(){ sheCropCancel(); })  
        .catch(function(){  
          alert('This image cannot be cropped in the browser (cross-origin). Download it and Choose file instead.');  
        });  
    }  

    // ---- color wiring helper ----  
    function sheIsClearColor(v){  
      v=(v||'').trim().toLowerCase();  
      return !v || v==='transparent'||v==='none'  
        ||/^rgba?\(\s*0\s*,\s*0\s*,\s*0\s*,\s*0\s*\)$/.test(v)  
        ||/^rgba?\(\s*0\s+0\s+0\s*\/\s*0\s*\)$/.test(v);  
    }  
    function sheIsNoneColor(v){ return sheIsClearColor(v); }  
    function sheClampAlpha(n){  
      n=parseInt(n,10);  
      if(isNaN(n)) return 100;  
      return Math.max(0, Math.min(100, n));  
    }  
    function sheExpandHex(h){  
      h=(h||'').trim();  
      var m=h.match(/^#([0-9a-f]{3})$/i);  
      if(m) return '#'+m[1].split('').map(function(ch){ return ch+ch; }).join('').toLowerCase();  
      m=h.match(/^#([0-9a-f]{6})([0-9a-f]{2})?$/i);  
      if(m) return ('#'+m[1]).toLowerCase();  
      return '#000000';  
    }  
    function sheHexToRgb(hex6){  
      var h=sheExpandHex(hex6).slice(1);  
      return {  
        r:parseInt(h.slice(0,2),16),  
        g:parseInt(h.slice(2,4),16),  
        b:parseInt(h.slice(4,6),16)  
      };  
    }  
    function sheFormatColor(hex6, alpha){  
      alpha=sheClampAlpha(alpha);  
      var hx=sheExpandHex(hex6||'#000000');  
      if(alpha>=100) return hx;  
      var rgb=sheHexToRgb(hx);  
      var a=Math.round(alpha)/100;  
      var aStr=String(a);  
      if(aStr.indexOf('.')>=0) aStr=aStr.replace(/\.?0+$/,'');  
      return 'rgba('+rgb.r+', '+rgb.g+', '+rgb.b+', '+aStr+')';  
    }  
    function sheParseColor(v){  
      v=(v||'').trim();  
      // Blank / transparent / none → inherit (empty field).  
      if(sheIsClearColor(v)){  
        return {none:true, hex:'#000000', alpha:100, alphaOn:false};  
      }  
      var m=v.match(/^#([0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$/i);  
      if(m){  
        var h=m[1];  
        if(h.length===3) h=h.split('').map(function(ch){ return ch+ch; }).join('');  
        if(h.length===8){  
          var a8=sheClampAlpha(parseInt(h.slice(6,8),16)*100/255);  
          return {none:false, hex:('#'+h.slice(0,6)).toLowerCase(), alpha:a8, alphaOn:a8<100};  
        }  
        return {none:false, hex:('#'+h).toLowerCase(), alpha:100, alphaOn:false};  
      }  
      m=v.match(/^rgba?\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)(?:\s*,\s*([\d.]+%?))?\s*\)$/i)  
        || v.match(/^rgba?\(\s*([\d.]+)\s+([\d.]+)\s+([\d.]+)(?:\s*\/\s*([\d.]+%?))?\s*\)$/i);  
      if(m){  
        var r=Math.max(0,Math.min(255,Math.round(parseFloat(m[1]))));  
        var g=Math.max(0,Math.min(255,Math.round(parseFloat(m[2]))));  
        var b=Math.max(0,Math.min(255,Math.round(parseFloat(m[3]))));  
        var hex=('#'+[r,g,b].map(function(n){  
          var s=n.toString(16); return s.length===1?'0'+s:s;  
        }).join(''));  
        var alpha=100;  
        if(m[4]!=null && m[4]!==''){  
          if(String(m[4]).slice(-1)==='%') alpha=sheClampAlpha(m[4].slice(0,-1));  
          else alpha=sheClampAlpha(parseFloat(m[4])*100);  
        }  
        return {none:false, hex:hex, alpha:alpha, alphaOn:alpha<100};  
      }  
      return {none:false, hex:'#000000', alpha:100, alphaOn:false};  
    }  
    function wireColor(key){  
      var c=$('fld_'+key), hex=$('hex_'+key), clearBtn=$('clear_'+key);  
      var alphaToggle=$('alpha_toggle_'+key);  
      var alphaPanel=$('alpha_panel_'+key);  
      var alphaRange=$('alpha_range_'+key);  
      var alphaNum=$('alpha_num_'+key);  
      var wrap=hex?hex.closest('.she-colorwrap'):null;  
      var alphaOn=!!(wrap&&wrap.classList.contains('she-color-is-alpha'));  

      function isCleared(){  
        return sheIsClearColor(hex&&hex.value);  
      }  
      function syncClearUI(){  
        var off=isCleared();  
        if(wrap) wrap.classList.toggle('she-color-is-cleared', off);  
        if(clearBtn) clearBtn.disabled=!!off;  
        if(alphaToggle) alphaToggle.disabled=!!off;  
        // Normalize legacy "transparent" / "none" to blank (inherit).  
        if(hex && off && (hex.value||'').trim()) hex.value='';  
        if(off) setAlphaUI(false, false);  
      }  
      function setAlphaUI(on, syncValue){  
        alphaOn=!!on && !isCleared();  
        if(wrap) wrap.classList.toggle('she-color-is-alpha', alphaOn);  
        if(alphaToggle){  
          alphaToggle.classList.toggle('active', alphaOn);  
          alphaToggle.setAttribute('aria-pressed', alphaOn?'true':'false');  
        }  
        if(alphaPanel){  
          if(alphaOn) alphaPanel.removeAttribute('hidden');  
          else alphaPanel.setAttribute('hidden','');  
        }  
        if(syncValue!==false) writeHexFromParts();  
      }  
      function readAlpha(){  
        if(alphaNum && alphaNum.value!=='') return sheClampAlpha(alphaNum.value);  
        if(alphaRange) return sheClampAlpha(alphaRange.value);  
        return 100;  
      }  
      function setAlphaInputs(a){  
        a=sheClampAlpha(a);  
        if(alphaRange) alphaRange.value=String(a);  
        if(alphaNum) alphaNum.value=String(a);  
      }  
      function writeHexFromParts(){  
        if(!hex) return;  
        if(isCleared()){  
          hex.value='';  
          syncClearUI();  
          return;  
        }  
        var hx=c?c.value:'#000000';  
        hex.value=sheFormatColor(hx, alphaOn?readAlpha():100);  
        if(wrap) wrap.classList.remove('she-color-is-cleared');  
        if(clearBtn) clearBtn.disabled=false;  
        if(alphaToggle) alphaToggle.disabled=false;  
      }  
      function clearColor(){  
        if(hex) hex.value='';  
        setAlphaInputs(100);  
        setAlphaUI(false, false);  
        syncClearUI();  
        applyNow();  
      }  

      if(c){  
        c.addEventListener('input',function(){  
          if(isCleared()){ if(hex) hex.value=c.value; }  
          writeHexFromParts();  
        });  
        c.addEventListener('change',function(){  
          if(isCleared()){ if(hex) hex.value=c.value; }  
          writeHexFromParts();  
          applyNow();  
        });  
      }  
      if(hex){  
        hex.addEventListener('input',function(){  
          if(isCleared()){  
            if((hex.value||'').trim()) hex.value='';  
            setAlphaInputs(100);  
            setAlphaUI(false, false);  
            syncClearUI();  
            return;  
          }  
          var parsed=sheParseColor(hex.value);  
          if(c) c.value=parsed.hex;  
          setAlphaInputs(parsed.alpha);  
          if(parsed.alphaOn) setAlphaUI(true, false);  
          else if(!alphaOn) setAlphaUI(false, false);  
          syncClearUI();  
        });  
        wireCommitText(hex);  
      }  
      if(clearBtn){  
        clearBtn.addEventListener('click', clearColor);  
      }  
      if(alphaToggle){  
        alphaToggle.addEventListener('click',function(){  
          if(isCleared()) return;  
          if(alphaOn){  
            setAlphaInputs(100);  
            setAlphaUI(false);  
          }else{  
            if(readAlpha()>=100) setAlphaInputs(80);  
            setAlphaUI(true);  
          }  
          applyNow();  
        });  
      }  
      function onAlphaInput(fromRange){  
        if(isCleared() || !alphaOn) return;  
        var a=sheClampAlpha(fromRange && alphaRange ? alphaRange.value : (alphaNum?alphaNum.value:100));  
        setAlphaInputs(a);  
        writeHexFromParts();  
      }  
      if(alphaRange){  
        alphaRange.addEventListener('input', function(){ onAlphaInput(true); });  
        alphaRange.addEventListener('change', function(){ onAlphaInput(true); applyNow(); });  
      }  
      if(alphaNum){  
        alphaNum.addEventListener('input', function(){ onAlphaInput(false); });  
        wireCommitText(alphaNum, function(){  
          if(isCleared() || !alphaOn) return;  
          setAlphaInputs(alphaNum.value);  
          writeHexFromParts();  
        });  
      }  
      // Initial UI from rendered value.  
      if(isCleared()){  
        if(hex) hex.value='';  
        setAlphaInputs(100);  
        setAlphaUI(false, false);  
        syncClearUI();  
      }else{  
        var init=sheParseColor(hex.value);  
        if(c) c.value=init.hex;  
        setAlphaInputs(init.alpha);  
        setAlphaUI(!!init.alphaOn, false);  
        if(hex && !sheIsClearColor(hex.value)) writeHexFromParts();  
        syncClearUI();  
      }  
    }  

    function wireRadiusControl(fk){  
      var wrap=$('radius_'+fk);  
      if(!wrap) return;  
      var uni=$('btn_'+fk+'_br'), uniu=$('unit_btn_'+fk+'_br');  
      enforceDecimal(uni); wireUnitToggle(uniu);  
      var corners=['tl','tr','br','bl'];  
      function cornerEl(c){ return $('btn_'+fk+'_br_'+c); }  
      function cornerUnit(c){ return $('unit_btn_'+fk+'_br_'+c); }  
      function readPair(el, tu){  
        if(!el) return {n:'', u:'px'};  
        return {n:el.value, u:tu?(tu.getAttribute('data-unit')||tu.textContent.trim()):'px'};  
      }  
      function writePair(el, tu, n, u){  
        if(el) el.value=n;  
        if(tu){ tu.setAttribute('data-unit',u); tu.textContent=u; }  
      }  
      function syncUniformToCorners(){  
        var p=readPair(uni, uniu);  
        corners.forEach(function(c){ writePair(cornerEl(c), cornerUnit(c), p.n, p.u); });  
      }  
      function syncCornersToUniform(){  
        var first=null, same=true;  
        corners.forEach(function(c){  
          var p=readPair(cornerEl(c), cornerUnit(c));  
          var key=p.n+'|'+p.u;  
          if(first===null) first=p;  
          else if(key!==(first.n+'|'+first.u)) same=false;  
        });  
        if(same&&first) writePair(uni, uniu, first.n, first.u);  
      }  
      function setExpanded(on){  
        wrap.classList.toggle('expanded', !!on);  
        var box=wrap.querySelector('.she-radius-box');  
        if(box){ if(on) box.removeAttribute('hidden'); else box.setAttribute('hidden',''); }  
        var btn=wrap.querySelector('.she-radius-toggle');  
        if(btn) btn.setAttribute('aria-expanded', on?'true':'false');  
        if(uni) uni.disabled=!!on;  
        if(on) syncUniformToCorners();  
        else syncCornersToUniform();  
      }  
      // Match initial server-rendered expanded state.  
      if(wrap.classList.contains('expanded') && uni) uni.disabled=true;  
      var tbtn=wrap.querySelector('.she-radius-toggle');  
      if(tbtn) tbtn.addEventListener('click', function(){  
        setExpanded(!wrap.classList.contains('expanded'));  
      });  
      if(uni){  
        uni.addEventListener('input', function(){  
          if(!wrap.classList.contains('expanded')) syncUniformToCorners();  
        });  
      }  
      if(uniu){  
        // unit toggle already calls applyNow; also mirror into corners when collapsed  
        uniu.addEventListener('click', function(){  
          setTimeout(function(){  
            if(!wrap.classList.contains('expanded')) syncUniformToCorners();  
          }, 0);  
        });  
      }  
      corners.forEach(function(c){  
        var el=cornerEl(c), tu=cornerUnit(c);  
        enforceDecimal(el); wireUnitToggle(tu);  
        if(el) el.addEventListener('input', function(){  
          /* live-edit only; commit on blur via enforceDecimal/wireCommitText */  
        });  
      });  
      // Live preview of corner radii on the sample rectangle.  
      function paintRect(){  
        var rect=wrap.querySelector('.she-radius-rect');  
        if(!rect) return;  
        var vals=corners.map(function(c){  
          var p=readPair(cornerEl(c), cornerUnit(c));  
          return (p.n===''?'0':p.n)+p.u;  
        });  
        rect.style.borderRadius=vals.join(' ');  
      }  
      wrap.addEventListener('input', paintRect);  
      wrap.addEventListener('click', function(ev){  
        if(ev.target&&ev.target.classList&&ev.target.classList.contains('she-unit-toggle')){  
          setTimeout(paintRect, 0);  
        }  
      });  
      paintRect();  
    }  

    function wireBtnstyle(fk){  
      wireColor(fk+'_bg');  
      wireColor(fk+'_fg');  
      wireColor(fk+'_bdr');  
      enforceDecimal($('btn_'+fk+'_bw')); wireUnitToggle($('unit_btn_'+fk+'_bw'));  
