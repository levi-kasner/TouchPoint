    var APPLY_IDLE_MS=1000;  
    function applyNow(){  
      if(applyTimer) clearTimeout(applyTimer);  
      applyTimer=setTimeout(function(){  
        applyTimer=null;  
        applyChanges();  
      }, APPLY_IDLE_MS);  
    }  
    function wireCommitText(el, before){  
      if(!el) return;  
      function commit(){ if(before) before(); applyNow(); }  
      el.addEventListener('keydown',function(ev){  
        if(ev.key==='Enter' || ev.keyCode===13){  
          ev.preventDefault();  
          el.blur(); // blur runs commit once  
        }  
      });  
      el.addEventListener('blur', commit);  
    }  

    // ---- numeric enforcement + unit toggles ----  
    function enforceInt(el){  
      if(!el) return;  
      el.addEventListener('input',function(){  
        var v=el.value.replace(/[^0-9\\-]/g,'');  
        if(v!==el.value) el.value=v;  
      });  
      wireCommitText(el);  
    }  
    // Allow decimals (and a leading minus) for typography values like 0.1em / 2.5em.  
    function enforceDecimal(el){  
      if(!el) return;  
      el.addEventListener('input',function(){  
        var v=el.value.replace(/[^0-9.\\-]/g,'');  
        var neg=v.charAt(0)==='-';  
        v=v.replace(/-/g,'');  
        var parts=v.split('.');  
        v=parts[0]+(parts.length>1?'.'+parts.slice(1).join(''):'');  
        if(neg) v='-'+v;  
        if(v!==el.value) el.value=v;  
      });  
      wireCommitText(el);  
    }  
    function wireUnitToggle(t){  
      if(!t) return;  
      // Locked units use .she-unit-fixed (grayed out) — never cycle those.  
      if(!t.classList || !t.classList.contains('she-unit-toggle')) return;  
      t.addEventListener('click',function(){  
        var units=(t.getAttribute('data-units')||'px,%').split(',').map(function(s){return s.trim();}).filter(Boolean);  
        if(!units.length) units=['px','%'];  
        if(units.length<2) return; // single-unit lock  
        var u=t.getAttribute('data-unit')||units[0];  
        var i=units.indexOf(u);  
        u=units[(i<0?0:i+1)%units.length];  
        t.setAttribute('data-unit',u);  
        t.textContent=u;  
        applyNow();  
      });  
    }  

    // ---- collect all field values into an object ----  
    // Host may drop empty form fields; use a sentinel so clears reach the server.  
    var CLEAR_VALUE='__CLEAR__';  
    function clearable(v){ return (v===''||v==null)?CLEAR_VALUE:v; }  
    function readVal(f){  
      var key=f.key;  
      if(f.type==='box'){return null;}  
      if(f.type==='color'){  
        var hex=$('hex_'+key); return hex?hex.value:'';  
      }  
      if(f.type==='number'){  
        var el=$('fld_'+key); var t=$('unit_'+key);  
        var unit=t?(t.getAttribute('data-unit')||t.textContent.trim()):'px';  
        return el.value===''?'':(el.value+unit);  
      }  
      var e=$('fld_'+key); return e?e.value:'';  
    }  
    function collectFont(out, fk){  
      out['font_'+fk+'_family']=clearable((function(e){return e?e.value:'';})($('font_'+fk+'_family')));  
      out['font_'+fk+'_weight']=clearable((function(e){return e?e.value:'';})($('font_'+fk+'_weight')));  
      var sz=$('font_'+fk+'_size'), szu=$('unit_font_'+fk+'_size');  
      var su=szu?(szu.getAttribute('data-unit')||szu.textContent.trim()):'em';  
      out['font_'+fk+'_size']=clearable((sz&&sz.value!=='')?(sz.value+su):'');  
      var sp=$('font_'+fk+'_spacing'), spu=$('unit_font_'+fk+'_spacing');  
      var u=spu?(spu.getAttribute('data-unit')||spu.textContent.trim()):'em';  
      out['font_'+fk+'_spacing']=clearable((sp&&sp.value!=='')?(sp.value+u):'');  
      out['font_'+fk+'_lineheight']=clearable((function(e){return e?e.value:'';})($('font_'+fk+'_lineheight')));  
      out['font_'+fk+'_bold']=($('font_'+fk+'_bold')&&$('font_'+fk+'_bold').checked)?'true':'false';  
      out['font_'+fk+'_italic']=($('font_'+fk+'_italic')&&$('font_'+fk+'_italic').checked)?'true':'false';  
    }  
    function collect(){  
      var out={};  
      FIELDS.forEach(function(f){  
        if(f.type==='heading'){ return; }  
        if(f.type==='box'){  
          ['padding','margin'].forEach(function(kind){  
            ['top','right','bottom','left'].forEach(function(side){  
              var id='box_'+f.key+'_'+kind+'_'+side;  
              var el=$(id); var t=$('unit_'+id);  
              if(el){  
                var unit=t?(t.getAttribute('data-unit')||t.textContent.trim()):'px';  
                out[id]= clearable(el.value===''?'':(el.value+unit));  
              }  
            });  
          });  
          var j=$('box_'+f.key+'_justify');  
          out['box_'+f.key+'_justify']=j?j.value:'center';  
        }else if(f.type==='font'){  
          collectFont(out, f.key);  
        }else if(f.type==='textstyle'){  
          var fk=f.key;  
          var hex=$('hex_'+fk); out[fk]=clearable(hex?hex.value:'');  
          collectFont(out, fk);  
        }else if(f.type==='btnstyle'){  
          var fk=f.key;  
          var hbg=$('hex_'+fk+'_bg'), hfg=$('hex_'+fk+'_fg'), hbdr=$('hex_'+fk+'_bdr');  
          out[fk+'_bg']=clearable(hbg?hbg.value:'');  
          out[fk+'_fg']=clearable(hfg?hfg.value:'');  
          out[fk+'_bdr']=clearable(hbdr?hbdr.value:'');  
          var bw=$('btn_'+fk+'_bw'), bwu=$('unit_btn_'+fk+'_bw');  
          var bu=bwu?(bwu.getAttribute('data-unit')||bwu.textContent.trim()):'px';  
          out[fk+'_bw']=clearable((bw&&bw.value!=='')?(bw.value+bu):'');  
          var br=$('btn_'+fk+'_br'), bru=$('unit_btn_'+fk+'_br');  
          var ru=bru?(bru.getAttribute('data-unit')||bru.textContent.trim()):'px';  
          out[fk+'_br']=clearable((br&&br.value!=='')?(br.value+ru):'');  
          // Corner inputs stay in the DOM (hidden when collapsed) and are kept in  
          // sync with the uniform field, so always read per-corner values.  
          ['tl','tr','br','bl'].forEach(function(c){  
            var el=$('btn_'+fk+'_br_'+c), tu=$('unit_btn_'+fk+'_br_'+c);  
            var u=tu?(tu.getAttribute('data-unit')||tu.textContent.trim()):'px';  
            out[fk+'_br_'+c]=clearable((el&&el.value!=='')?(el.value+u):'');  
          });  
          collectFont(out, fk);  
        }else if(f.type==='formborder'){  
          var fk=f.key;  
          var hbdr=$('hex_'+fk+'_bdr');  
          out[fk+'_bdr']=clearable(hbdr?hbdr.value:'');  
          var bw=$('btn_'+fk+'_bw'), bwu=$('unit_btn_'+fk+'_bw');  
          var bu=bwu?(bwu.getAttribute('data-unit')||bwu.textContent.trim()):'px';  
          out[fk+'_bw']=clearable((bw&&bw.value!=='')?(bw.value+bu):'');  
          var br=$('btn_'+fk+'_br'), bru=$('unit_btn_'+fk+'_br');  
          var ru=bru?(bru.getAttribute('data-unit')||bru.textContent.trim()):'px';  
          out[fk+'_br']=clearable((br&&br.value!=='')?(br.value+ru):'');  
        }else if(f.type==='image'){  
          out[f.key]=clearable(readVal(f));  
        }else if(f.type==='bgpanel'){  
          // Editor UI only — not persisted on the shell.  
        }else{  
          out[f.key]=clearable(readVal(f));  
        }  
      });  
      return out;  
