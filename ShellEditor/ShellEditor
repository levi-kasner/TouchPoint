FA_ICON_FONT = 'FontAwesome, "Font Awesome 5 Free", "Font Awesome 6 Free"'  

def heal_giving_signin_icon(html):  
    """Pin icon glyphs to Font Awesome so Sign In text font can change freely."""  
    # Fast path: already healed.  
    ff = (get_css(html, GIVING_SIGNIN_ICON_SELS[0], "font-family") or "").lower()  
    if "awesome" in ff.replace(" ", ""):  
