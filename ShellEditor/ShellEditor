    // ---- font wiring helper ----  
    function wireFont(fk){  
      var fam=$('font_'+fk+'_family'), wt=$('font_'+fk+'_weight');  
      var b=$('font_'+fk+'_bold'), it=$('font_'+fk+'_italic');  
      if(fam) fam.addEventListener('change',applyNow);  
      if(wt) wt.addEventListener('change',function(){  
        if(b) b.checked=(wt.value==='bold'||wt.value==='700');  
        applyNow();  
      });  
      var sz=$('font_'+fk+'_size'); if(sz){ enforceDecimal(sz); }  
      wireUnitToggle($('unit_font_'+fk+'_size'));  
      var sp=$('font_'+fk+'_spacing'); if(sp){ enforceDecimal(sp); }  
      wireUnitToggle($('unit_font_'+fk+'_spacing'));  
      var lh=$('font_'+fk+'_lineheight'); if(lh){ enforceDecimal(lh); }  
      if(b) b.addEventListener('change',function(){  
        if(b.checked && wt) wt.value='bold';  
        else if(!b.checked && wt && (wt.value==='bold'||wt.value==='700')) wt.value='normal';  
        applyNow();  
      });  
      if(it) it.addEventListener('change',applyNow);  
    }  

    // =================== WIRE EVERYTHING ON LOAD ===================  
    function sheNavOffset(){  
      // Measure the lowest edge of navbar chrome. getBoundingClientRect on #top-navbar  
      // alone can miss overflowing / absolutely-positioned children (the actual buttons).  
      var top=50;  
      function consider(el){  
        if(!el||!el.getBoundingClientRect) return;  
        var r=el.getBoundingClientRect();  
        if(!r||r.width<1&&r.height<1) return;  
        // Ignore open dropdowns that stretch far down the page.  
        if(r.top>120||r.bottom>220) return;  
        if(r.bottom>top) top=Math.round(r.bottom);  
      }  
      consider(document.getElementById('top-navbar'));  
      var fixed=document.querySelectorAll('.navbar-fixed-top');  
      for(var i=0;i<fixed.length;i++){  
        consider(fixed[i]);  
        var kids=fixed[i].children;  
        for(var k=0;k<kids.length;k++) consider(kids[k]);  
        var deep=fixed[i].querySelectorAll('.container,.navbar-header,.navbar-nav,.nav,.btn,.navbar-brand,.navbar-right,.navbar-left,.navbar-collapse');  
        for(var d=0;d<deep.length;d++) consider(deep[d]);  
      }  
      return Math.max(top,50);  
    }  
    function shePinBelowNavbar(){  
      var wrap=$('she-wrap');  
      if(!wrap) return;  
      wrap.style.top=sheNavOffset()+'px';  
    }  
    window.addEventListener('resize',shePinBelowNavbar);  
    window.addEventListener('load',function(){  
      // Remount TouchPoint's Vue navbar if the host left it unmounted.  
      try{  
        var nav=document.querySelector('#top-navbar[data-mount-vue]');  
        if(nav&&window.Vue){  
          nav.removeAttribute('data-mount-vue');  
          new window.Vue({el:nav,data:Object.assign({},nav.dataset)});  
        }  
      }catch(e){}  
      (function(){  
        var wrap=document.querySelector('.she-bg-panel');  
        var panel=wrap?(wrap.getAttribute('data-panel')||'color'):'color';  
        sheSetBgPanel(panel);  
      })();  
      shePinBelowNavbar();  
      // Remeasure after layout/fonts/async nav widgets settle.  
      requestAnimationFrame(shePinBelowNavbar);  
      setTimeout(shePinBelowNavbar,0);  
      setTimeout(shePinBelowNavbar,250);  
      setTimeout(shePinBelowNavbar,1000);  
      // Load preview after chrome is interactive; pin registration shell first.  
      var frame=$('she-frame');  
      if(frame){  
        var src=frame.getAttribute('data-src');  
        if(src){  
          status('Loading preview...');  
          frame.addEventListener('load',function onPrev(){  
            frame.removeEventListener('load',onPrev);  
            status('');  
          });  
          var boot=CAN_ASSIGN?ensureRegistrationShell:function(){ return Promise.resolve(); };  
          boot().then(function(){ frame.src=src; })  
            .catch(function(){ frame.src=src; });  
        }  
      }  
      // Collapsible panels:  
      // - Top-level sections are exclusive (opening one closes the others).  
      // - Subsections within a section can all stay open together.  
      // - Collapsing a section also collapses every subsection inside it.  
      function shePanelBody(panel){  
        for(var i=0;i<panel.children.length;i++){  
          var c=panel.children[i];  
          if(c.classList&&(c.classList.contains('she-sec-body')||c.classList.contains('she-subsec-body'))) return c;  
        }  
        return null;  
      }  
      function shePanelCloseImmediate(panel){  
        var body=shePanelBody(panel);  
        panel.classList.remove('she-open');  
        panel.open=false;  
        if(body){ body.style.height=''; body.style.opacity=''; }  
      }  
      function sheCollapseNestedSubsecs(section){  
        Array.prototype.forEach.call(section.querySelectorAll('details.she-subsec'), function(sub){  
          if(sub.open||sub.classList.contains('she-open')) shePanelCloseImmediate(sub);  
        });  
      }  
      function shePanelClose(panel,done){  
        var body=shePanelBody(panel);  
        if(!body||!panel.open){  
          if(panel.classList.contains('she-sec')) sheCollapseNestedSubsecs(panel);  
          if(done) done();  
          return;  
        }  
        if(panel.classList.contains('she-sec')) sheCollapseNestedSubsecs(panel);  
        panel.classList.remove('she-open');  
        body.style.height=body.scrollHeight+'px';  
        body.offsetHeight;  
        body.style.height='0px';  
        body.style.opacity='0';  
        var finished=false;  
        function finish(){  
          if(finished) return;  
          finished=true;  
          panel.open=false;  
          body.style.height='';  
          body.style.opacity='';  
          if(done) done();  
        }  
        body.addEventListener('transitionend',function te(ev){  
          if(ev.propertyName&&ev.propertyName!=='height') return;  
          body.removeEventListener('transitionend',te);  
          finish();  
        });  
        setTimeout(finish,360);  
      }  
      function shePanelOpen(panel,exclusiveGroup){  
        var body=shePanelBody(panel);  
        if(!body) return;  
        if(exclusiveGroup){  
          exclusiveGroup.forEach(function(other){ if(other!==panel&&other.open) shePanelClose(other); });  
        }  
        panel.open=true;  
        panel.classList.add('she-open');  
        body.style.height='0px';  
        body.style.opacity='0';  
        body.offsetHeight;  
        body.style.height=body.scrollHeight+'px';  
        body.style.opacity='1';  
        function clearH(ev){  
          if(ev&&ev.propertyName&&ev.propertyName!=='height') return;  
          body.removeEventListener('transitionend',clearH);  
          if(panel.open) body.style.height='auto';  
        }  
        body.addEventListener('transitionend',clearH);  
        setTimeout(function(){ if(panel.open) body.style.height='auto'; },360);  
      }  
      function sheWirePanels(panels,exclusive){  
        panels.forEach(function(panel){  
          var sum=panel.querySelector(':scope > summary')||panel.querySelector('summary');  
          if(!sum) return;  
          sum.addEventListener('click',function(ev){  
            ev.preventDefault();  
            ev.stopPropagation();  
            if(panel.open) shePanelClose(panel);  
            else shePanelOpen(panel, exclusive?panels:null);  
          });  
        });  
      }  
      var secs=Array.prototype.slice.call(document.querySelectorAll('details.she-sec'));  
      sheWirePanels(secs,true);  
      // Wire subsections per section so they never accordion across the whole editor.  
      secs.forEach(function(sec){  
        var subs=Array.prototype.slice.call(sec.querySelectorAll('details.she-subsec'));  
        sheWirePanels(subs,false);  
      });  
      FIELDS.forEach(function(f){  
        if(f.type==='text'||f.type==='url'){  
          wireCommitText($('fld_'+f.key));  
        }else if(f.type==='color'){  
          wireColor(f.key);  
        }else if(f.type==='number'){  
          enforceInt($('fld_'+f.key)); wireUnitToggle($('unit_'+f.key));  
        }else if(f.type==='image'){  
          var t=$('fld_'+f.key);  
          if(t){  
            t.addEventListener('input',function(){ sheSetImageField(f.key,t.value.trim()); });  
            wireCommitText(t, function(){ sheSetImageField(f.key,t.value.trim()); });  
          }  
          var file=$('file_'+f.key);  
          if(file) file.addEventListener('change',function(){  
            if(file.files&&file.files[0]) sheOpenCrop(f.key);  
          });  
        }else if(f.type==='font'){  
          wireFont(f.key);  
        }else if(f.type==='textstyle'){  
          wireColor(f.key); wireFont(f.key);  
        }else if(f.type==='btnstyle'){  
          wireBtnstyle(f.key);  
        }else if(f.type==='formborder'){  
          wireFormborder(f.key);  
        }  
      });  
      // box-model inputs + justify  
      BOXKEYS.forEach(function(key){  
        ['padding','margin'].forEach(function(kind){  
          ['top','right','bottom','left'].forEach(function(side){  
            var id='box_'+key+'_'+kind+'_'+side;  
            enforceInt($(id)); wireUnitToggle($('unit_'+id));  
          });  
        });  
        var wrap=document.querySelector('.she-boxmodel[data-key="'+key+'"]');  
        if(!wrap) return;  
        var hidden=$('box_'+key+'_justify');  
        Array.prototype.forEach.call(wrap.querySelectorAll('.she-justify-btn'), function(btn){  
          btn.addEventListener('click', function(){  
            var align=btn.getAttribute('data-align')||'center';  
            if(hidden) hidden.value=align;  
            Array.prototype.forEach.call(wrap.querySelectorAll('.she-justify-btn'), function(b){  
              b.classList.toggle('active', b===btn);  
            });  
            applyNow();  
          });  
        });  
      });  
    });  
