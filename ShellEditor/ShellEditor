def sync_giving_working_copy(html):  
    wc = SHELL_TARGET.get("working_copy")  
    if not wc or not html:  
        return  
    write_shell_file(wc, html, "giving")  

def ensure_giving_working_copy():  
    wc = SHELL_TARGET.get("working_copy")  
    if not wc:  
        return  
    if content_exists(wc):  
        return  
    src = model.HtmlContent(SHELL_TARGET["template"])  
    if src:  
        write_shell_file(wc, src, "giving")  

def assign_preview_server(shell_name, html):  
    """Server-side preview wiring for giving + login (registration uses browser API)."""  
    mode = SHELL_TARGET.get("assign")  
    if mode == "giving_working_copy":  
        ensure_giving_working_copy()  
        sync_giving_working_copy(html)  
        set_model_setting(GIVING_ACTIVE_SHELL_SETTING, shell_name)  
    elif mode == "login_setting":  
        set_model_setting(LOGIN_SHELL_SETTING, shell_name)  


