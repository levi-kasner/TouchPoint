def _sql_lit(s):  
    return (s or "").replace("'", "''")  

def kind_marker_prefix(kind):  
    return "<!-- SHELL-EDITOR-KIND:" + kind  

def kind_marker_block(kind):  
    """Protected leading comment — must stay at the start of shell HTML."""  
    label = SHELL_TARGETS.get(kind, {}).get("label", kind)  
    return (  
        "<!-- SHELL-EDITOR-KIND:" + kind + "\n"  
        "     =====================================================================\n"  
        "     DO NOT REMOVE OR EDIT THIS COMMENT.\n"  
        "     The Shell Editor identifies this Special Content as a " + label + " shell\n"  
        "     using this marker at the top of the file.\n"  
        "     Content Keyword must be exactly: Shell\n"  
        "     (TouchPoint cannot store multiple keywords via WriteContentHtml).\n"  
        "     Removing or changing this marker hides the shell from the editor dropdown.\n"  
        "     =====================================================================\n"  
        "-->\n"  
    )  

_KIND_MARKER_STRIP_RE = re.compile(  
    r'^<!--\s*SHELL-EDITOR-KIND:(?:registration|giving|login)\b.*?-->\s*',  
    re.I | re.S,  
)  
_KIND_MARKER_READ_RE = re.compile(  
    r'^<!--\s*SHELL-EDITOR-KIND:(registration|giving|login)\b',  
    re.I,  
)  
_SHELL_VERSION_RE = re.compile(  
    r'<!--\s*SHELL-EDITOR-SHELL-VERSION:\s*(\d+)\s*-->',  
    re.I,  
)  
_SHELL_VERSION_STRIP_RE = re.compile(  
    r'^<!--\s*SHELL-EDITOR-SHELL-VERSION:\s*\d+\s*-->\s*',  
    re.I,  
)  
  
def strip_kind_marker(html):  
    """Remove a leading SHELL-EDITOR-KIND comment (and BOM / leading space)."""  
    if not html:  
        return html or ""  
    s = html.lstrip("\ufeff").lstrip()  
    m = _KIND_MARKER_STRIP_RE.match(s)  
    if m:  
        return s[m.end():]  
    return s  
  
def get_shell_version(html):  
    """Return stamped shell format version, or 0 when missing (pre-versioning)."""  
    m = _SHELL_VERSION_RE.search(html or "")  
    if not m:  
        return 0  
    try:  
        return int(m.group(1))  
    except Exception:  
        return 0  
  
def strip_shell_meta(html):  
    """Remove leading kind + shell-version markers for body compares / rewrites."""  
    s = strip_kind_marker(html)  
    s = s.lstrip("\ufeff").lstrip()  
    m = _SHELL_VERSION_STRIP_RE.match(s)  
    if m:  
        s = s[m.end():]  
    return s  
  
def shell_version_marker(version):  
    return "<!-- SHELL-EDITOR-SHELL-VERSION:" + str(int(version)) + " -->\n"  
  
def set_shell_version_marker(html, kind, version):  
    """Rewrite leading meta as kind marker + version marker + body."""  
    kind = kind or "registration"  
    body = strip_shell_meta(html).lstrip()  
    return kind_marker_block(kind) + shell_version_marker(version) + body  
  
def html_shell_kind(html):  
    """Return registration|giving|login if body starts with our kind marker."""  
    if not html:  
        return ""  
    s = html.lstrip("\ufeff").lstrip()  
    m = _KIND_MARKER_READ_RE.match(s)  
    return m.group(1).lower() if m else ""  
  
def ensure_kind_marker(html, kind):  
    """Guarantee kind marker is first; preserve shell-version marker when present."""  
    ver = get_shell_version(html)  
    body = strip_shell_meta(html).lstrip()  
    out = kind_marker_block(kind)  
    if ver:  
        out += shell_version_marker(ver)  
    return out + body  
  
def _migrate_shell_to_v1(html, kind):  
    """Baseline: kind marker + background media layer/script/CSS."""  
    html = ensure_kind_marker(html, kind)  
    html = ensure_bg_media(html)  
    return html  
  
# Ordered migrators: each entry upgrades FROM any lower version TO target.  
# Add (2, _migrate_shell_to_v2), etc. when shipping breaking structural heals.  
SHELL_MIGRATIONS = [  
    (1, _migrate_shell_to_v1),  
]  
  
def migrate_shell_html(html, kind=None):  
    """Run pending shell migrators in order. Returns (html, changed)."""  
    kind = kind or SHELL_KIND  
    html = html or ""  
    ver = get_shell_version(html)  
    original = html  
    for target, fn in SHELL_MIGRATIONS:  
        if ver < target:  
            html = fn(html, kind)  
            ver = target  
            html = set_shell_version_marker(html, kind, ver)  
    if get_shell_version(html) == 0:  
        html = set_shell_version_marker(html, kind, SHELL_FORMAT_VERSION)  
    elif get_shell_version(html) < SHELL_FORMAT_VERSION:  
        # Format bumped without a migrator — still stamp so we don't loop forever.  
        html = set_shell_version_marker(html, kind, SHELL_FORMAT_VERSION)  
    return html, (html != original)  

def list_shells_for_kind(kind):  
    """Special Content whose body starts with this kind's Shell Editor marker."""  
    tgt = SHELL_TARGETS[kind]  
    template = tgt["template"]  
    exclude = set()  
    wc = tgt.get("working_copy")  
    if wc:  
        exclude.add(wc)  
    names = []  
    seen = set()  
    marker = _sql_lit(kind_marker_prefix(kind))  
    sql = (  
        "SELECT Name FROM Content "  
        "WHERE LTRIM(ISNULL(Body,'')) LIKE '" + marker + "%' "  
        "ORDER BY Name"  
    )  
    try:  
        for row in q.QuerySql(sql):  
            n = str(getattr(row, "Name", "") or "").strip()  
            if not n or n in exclude or n in seen:  
                continue  
            seen.add(n)  
            names.append(n)  
    except Exception:  
        pass  
    if template and template not in exclude and template not in seen:  
        names.insert(0, template)  
    return names  

def valid_new_shell_name(name):  
    return bool(name and SHELL_NAME_RE.match(name))  

def content_exists(name):  
    try:  
        body = model.HtmlContent(name)  
        return bool(body)  
    except Exception:  
        return False  

def looks_like_shell_html(html):  
    """Heuristic for older shells missing the kind marker (migration heal)."""  
    if not html:  
        return False  
    low = html.lower()  
    return ("form-box" in low) or ("<!--form start-->" in low) or ("form start" in low)  

def write_shell_file(name, html, kind=None):  
    """Write shell HTML with kind/version markers + Content Keyword 'Shell'."""  
    kind = kind or SHELL_KIND  
    html, _changed = migrate_shell_html(html, kind)  
    html = ensure_kind_marker(html, kind)  
    if get_shell_version(html) == 0:  
        html = set_shell_version_marker(html, kind, SHELL_FORMAT_VERSION)  
    model.WriteContentHtml(name, html, SHELL_CONTENT_KEYWORD)  
    return html  

def shell_name_from_request():  
    if model.DataHas("shell_name"):  
        return str(model.Dictionary("shell_name") or "").strip()  
    return ""  

def get_model_setting(key):  
    try:  
        return str(model.GetSetting(key) or "").strip()  
    except Exception:  
        try:  
            return str(model.Setting(key) or "").strip()  
        except Exception:  
            return ""  

def set_model_setting(key, value):  
    try:  
        model.SetSetting(key, value)  
    except Exception:  
        pass  

def is_templated_shell(name, kind, allowed=None):  
    """True when name is an editor-managed shell for this kind (marker or list)."""  
    if not name or not valid_new_shell_name(name):  
        return False  
    if allowed is not None and name in allowed:  
        return True  
    try:  
        body = model.HtmlContent(name)  
    except Exception:  
        body = ""  
    return html_shell_kind(body) == kind  

def current_login_shell_name(allowed):  
    name = get_model_setting(LOGIN_SHELL_SETTING)  
    return name if is_templated_shell(name, "login", allowed) else ""  

def current_giving_shell_name(allowed):  
    name = get_model_setting(GIVING_ACTIVE_SHELL_SETTING)  
    if is_templated_shell(name, "giving", allowed):  
        return name  
    # Fall back: match working-copy body to a named giving shell.  
    wc = GIVING_WORKING_COPY  
    try:  
        wc_body = strip_shell_meta(model.HtmlContent(wc) or "").strip()  
    except Exception:  
        wc_body = ""  
    if not wc_body:  
        return ""  
    for n in (allowed or []):  
        try:  
            body = strip_shell_meta(model.HtmlContent(n) or "").strip()  
        except Exception:  
            continue  
        if body and body == wc_body:  
            return n  
    return ""  

def current_registration_shell_name(allowed):  
    """Read the involvement's HTML shell from Organizations.RegSetting when possible."""  
    rs = ""  
    try:  
        row = q.QuerySqlTop1(  
            "SELECT RegSetting FROM Organizations WHERE OrganizationId = "  
            + str(int(INVOLVEMENT_ID))  
        )  
        if row is not None:  
            rs = str(getattr(row, "RegSetting", "") or "")  
    except Exception:  
        rs = ""  
    name = ""  
    if rs:  
        m = re.search(r"<Shell>\s*([^<]+?)\s*</Shell>", rs, re.I)  
        if m:  
            name = m.group(1).strip()  
        if not name:  
            m = re.search(r'"regShellId"\s*:\s*"([^"]*)"', rs)  
            if m:  
                name = m.group(1).strip()  
        if not name:  
            m = re.search(r"(?:^|[\s;,])Shell=([A-Za-z][A-Za-z0-9_]*)", rs)  
            if m:  
                name = m.group(1)  
    return name if is_templated_shell(name, "registration", allowed) else ""  

def current_live_shell_name(kind, allowed):  
    if kind == "login":  
        return current_login_shell_name(allowed)  
    if kind == "giving":  
        return current_giving_shell_name(allowed)  
    if kind == "registration":  
        return current_registration_shell_name(allowed)  
    return ""  

def resolve_shell_name(kind, allowed):  
    name = shell_name_from_request()  
    if name and name in allowed:  
        return name  
    tgt = SHELL_TARGETS[kind]  
    wc = tgt.get("working_copy")  
    # Save As / deep link: accept shell-shaped content; heal marker + Shell keyword.  
    if name and valid_new_shell_name(name) and name != wc:  
        try:  
            body = model.HtmlContent(name)  
        except Exception:  
            body = ""  
        if not body:  
            return tgt["template"]  
        marked = html_shell_kind(body)  
        if marked == kind or (not marked and looks_like_shell_html(body)):  
            write_shell_file(name, body, kind)  
            return name  
    # No usable shell_name — prefer the shell currently live for this preview target.  
    live = current_live_shell_name(kind, allowed)  
    if live and (live in allowed or is_templated_shell(live, kind, allowed)):  
        return live  
    return tgt["template"]  

def alert_hidden_for(kind):  
    key = ALERT_HIDE_KEYS.get(kind)  
    if not key:  
        return True  
    try:  
        return bool(model.ExtraValueBit(model.UserPeopleId, key))  
    except Exception:  
        return False  

def hide_alert_for(kind):  
    key = ALERT_HIDE_KEYS.get(kind)  
    if not key:  
        return  
    pid = model.UserPeopleId  
    model.AddExtraValueBool("peopleid=" + str(pid), key, True)  

