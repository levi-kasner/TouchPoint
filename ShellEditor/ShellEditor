RADIUS_CORNERS = ("tl", "tr", "br", "bl")  
RADIUS_CORNER_PROPS = {  
    "tl": "border-top-left-radius",  
    "tr": "border-top-right-radius",  
    "br": "border-bottom-right-radius",  
    "bl": "border-bottom-left-radius",  
}  

def parse_radius_shorthand(val):  
    """Expand border-radius shorthand into tl/tr/br/bl (num, unit) pairs."""  
    empty = {c: ("", "px") for c in RADIUS_CORNERS}  
    if not val:  
        return empty  
    # Ignore elliptical second half: "10px / 5px"  
    val = _strip_important(val).split("/")[0].strip()  
    toks = [t for t in val.split() if t]  
    if not toks:  
        return empty  
    def part(tok):  
        n, u = split_num_unit(tok)  
        return (n, u or "px")  
    if len(toks) == 1:  
        p = part(toks[0])  
        return {"tl": p, "tr": p, "br": p, "bl": p}  
    if len(toks) == 2:  
        a, b = part(toks[0]), part(toks[1])  
        return {"tl": a, "tr": b, "br": a, "bl": b}  
    if len(toks) == 3:  
        a, b, c = part(toks[0]), part(toks[1]), part(toks[2])  
        return {"tl": a, "tr": b, "br": c, "bl": b}  
    a, b, c, d = part(toks[0]), part(toks[1]), part(toks[2]), part(toks[3])  
    return {"tl": a, "tr": b, "br": c, "bl": d}  

def read_border_radius_corners(html, sel):  
    """Return {tl/tr/br/bl: (n,u)} and whether corners differ."""  
    corners = {}  
    any_long = False  
    for c, prop in RADIUS_CORNER_PROPS.items():  
        v = get_css(html, sel, prop)  
        if v:  
            any_long = True  
            n, u = split_num_unit(v)  
            corners[c] = (n, u or "px")  
        else:  
            corners[c] = ("", "px")  
    if not any_long:  
        corners = parse_radius_shorthand(get_css(html, sel, "border-radius"))  
    # Fill empties from uniform shorthand when only some longhands exist.  
    shorthand = parse_radius_shorthand(get_css(html, sel, "border-radius"))  
    for c in RADIUS_CORNERS:  
        if not corners[c][0] and shorthand[c][0]:  
            corners[c] = shorthand[c]  
    vals = [corners[c] for c in RADIUS_CORNERS]  
    uniform = all(v == vals[0] for v in vals)  
    return corners, uniform  

def _radius_corner_cell(key, corner, cell):  
    fid = "btn_" + key + "_br_" + corner  
    n, u = cell  
    return (  
        '<span class="she-boxcell she-radius-cell" data-corner="' + corner + '">'  
