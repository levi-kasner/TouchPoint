        html = set_css(html, sel, "font-style", "normal")  
        html = set_css(html, sel, "color", "inherit")  
        html = set_css(html, sel, "background", "none")  
        html = set_css(html, sel, "border", "none")  
    return html  

def _strip_comments_for_decl_fix(body):  
    """Apply a replacer only to non-comment slices of a CSS rule body."""  
    def fix_decl(dm):  
        prefix, val, semi = dm.group(1), dm.group(2), dm.group(3)  
        if re.search(r'!important', val, re.I):  
            return prefix + val.rstrip() + semi  
        return prefix + val.rstrip() + " !important" + semi  
    out = []  
    i = 0  
    n = len(body)  
    while i < n:  
        if body.startswith("/*", i):  
            end = body.find("*/", i + 2)  
            end = n if end < 0 else end + 2  
            out.append(body[i:end])  
            i = end  
            continue  
        next_c = body.find("/*", i)  
        chunk = body[i:] if next_c < 0 else body[i:next_c]  
        out.append(re.sub(  
            r'(?<![@\w-])([\w-]+\s*:\s*)([^;{}]+?)(\s*;)',  
            fix_decl,  
            chunk))  
        i = n if next_c < 0 else next_c  
    return "".join(out)  

def ensure_all_css_important(html):  
    """Add !important to declarations inside CSS rules (not @import / preamble)."""  
    def fix_style_content(content):  
        # Only rewrite property: value; pairs that live inside { ... } bodies.  
        # Never touch @import URLs or comment text.  
        out = []  
        i = 0  
        n = len(content)  
        while i < n:  
            if content.startswith("/*", i):  
                end = content.find("*/", i + 2)  
                end = n if end < 0 else end + 2  
                out.append(content[i:end])  
                i = end  
                continue  
            brace = content.find("{", i)  
            if brace < 0:  
                out.append(content[i:])  
                break  
            out.append(content[i:brace + 1])  
            depth = 1  
            j = brace + 1  
            while j < n and depth:  
                if content.startswith("/*", j):  
                    end = content.find("*/", j + 2)  
                    j = n if end < 0 else end + 2  
                    continue  
                if content[j] == "{":  
                    depth += 1  
                elif content[j] == "}":  
                    depth -= 1  
                j += 1  
            out.append(_strip_comments_for_decl_fix(content[brace + 1:j - 1]))  
            out.append("}")  
            i = j  
        return "".join(out)  
    parts = []  
    last = 0  
    for content, base in _iter_style_blocks(html):  
        parts.append(html[last:base])  
        parts.append(fix_style_content(content))  
        last = base + len(content)  
    parts.append(html[last:])  
    return "".join(parts)  

# ---- background-image url() convenience ----------------------------------  
def get_bg_url(html, selector):  
    raw = get_css(html, selector, "background-image")  
    m = re.search(r'url\(\s*[\'"]?([^\'")]+)[\'"]?\s*\)', raw or "", re.I)  
    return m.group(1) if m else ""  

def set_bg_url(html, selector, url):  
    val = ("url('" + url + "')") if url else "none"  
    return set_css(html, selector, "background-image", val)  

