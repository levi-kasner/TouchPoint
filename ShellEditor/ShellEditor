        '<span class="she-unit-toggle" id="unit_' + fid + '" data-unit="' + esc(u or "px")  
        + '" data-units="px,em,rem,%">' + esc(u or "px") + '</span>'  
        '</span>')  

def render_radius_control(key, corners, uniform):  
    """Collapsed: one radius. Expanded: rectangle with per-corner inputs."""  
    # Uniform display value from tl (or first non-empty).  
    uni_n, uni_u = corners["tl"]  
    if not uni_n:  
        for c in RADIUS_CORNERS:  
            if corners[c][0]:  
                uni_n, uni_u = corners[c]  
                break  
    if not uni_u:  
        uni_u = "px"  
    expanded = not uniform  
    exp_cls = "she-radius" + (" expanded" if expanded else "")  
    return (  
        '<div class="' + exp_cls + '" data-key="' + esc(key) + '" id="radius_' + esc(key) + '">'  
        '  <div class="she-fontrow she-radius-head">'  
        '    <span class="she-fontlab">Border radius</span>'  
        '    <span class="she-numwrap she-radius-uniform">'  
        '      <input class="she-in she-num" id="btn_' + key + '_br" type="text" inputmode="decimal" value="'  
        + esc(uni_n) + '"/>'  
        '      <span class="she-unit-toggle" id="unit_btn_' + key + '_br" data-unit="' + esc(uni_u)  
        + '" data-units="px,em,rem,%">' + esc(uni_u) + '</span>'  
        '    </span>'  
        '    <button type="button" class="she-radius-toggle" title="Edit each corner" aria-expanded="'  
        + ("true" if expanded else "false") + '">'  
        '      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">'  
        '        <rect x="2" y="2" width="12" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/>'  
        '        <circle cx="4" cy="4" r="1.2" fill="currentColor"/>'  
        '        <circle cx="12" cy="4" r="1.2" fill="currentColor"/>'  
        '        <circle cx="4" cy="12" r="1.2" fill="currentColor"/>'  
        '        <circle cx="12" cy="12" r="1.2" fill="currentColor"/>'  
        '      </svg>'  
        '    </button>'  
        '  </div>'  
        '  <div class="she-radius-box" ' + ("" if expanded else 'hidden ') + '>'  
        '    <div class="she-bm-label she-radius-label">corners</div>'  
        '    <div class="she-radius-frame">'  
        '      <div class="she-radius-row">'  
        + _radius_corner_cell(key, "tl", corners["tl"])  
        + '<span class="she-radius-gap"></span>'  
        + _radius_corner_cell(key, "tr", corners["tr"]) +  
        '      </div>'  
        '      <div class="she-radius-rect" title="border radius" aria-hidden="true"></div>'  
        '      <div class="she-radius-row">'  
        + _radius_corner_cell(key, "bl", corners["bl"])  
        + '<span class="she-radius-gap"></span>'  
        + _radius_corner_cell(key, "br", corners["br"]) +  
        '      </div>'  
        '    </div>'  
        '  </div>'  
        '</div>')  

def render_btnstyle(key, sel, html, fam_opts):  
    bg = get_css(html, sel, "background-color")  
    fg = get_css(html, sel, "color")  
    bw, bc, _bs = read_border_parts(html, sel)  
    corners, uniform = read_border_radius_corners(html, sel)  
    bw_n, bw_u = split_num_unit(bw) if bw else ("", "px")  
    if bw and not bw_u:  
        bw_u = "px"  
    if not bw_n and not bw:  
        bw_n, bw_u = "", "px"  
    rows = (  
        _color_input_row(key + "_bg", "Background", bg)  
        + _color_input_row(key + "_fg", "Text", fg)  
        + _color_input_row(key + "_bdr", "Border", bc)  
        + _num_input_row("btn_" + key + "_bw", "Border width", bw_n, bw_u or "px", "px,em,rem")  
        + render_radius_control(key, corners, uniform)  
        + _font_rows(key, sel, html, fam_opts)  
    )  
    return '<div class="she-fontctl she-btnstyle" data-key="' + key + '">' + rows + '</div>'  

def btnstyle_selectors(f):  
    sel = f["loc"][1]  
    out = [sel]  
    for s in f.get("also") or []:  
        if s and s not in out:  
            out.append(s)  
    return out  

def apply_btnstyle(html, f):  
    """Write background / border / text / font for a btnstyle field."""  
    fk = f["key"]  
    sels = btnstyle_selectors(f)  
    for sel in sels:  
        html = ensure_selector_rule(html, sel)  
    def set_all(h, prop, value):  
        for sel in sels:  
            h = write_css_prop(h, sel, prop, value)  
        return h  
    if model.DataHas(fk + "_bg"):  
        html = set_all(html, "background-color", model.Dictionary(fk + "_bg"))  
    if model.DataHas(fk + "_fg"):  
        html = set_all(html, "color", model.Dictionary(fk + "_fg"))  
    bdr = model.Dictionary(fk + "_bdr") if model.DataHas(fk + "_bdr") else None  
    bw = model.Dictionary(fk + "_bw") if model.DataHas(fk + "_bw") else None  
    if bdr is not None:  
        html = set_all(html, "border-color", bdr)  
    if bw is not None:  
        html = set_all(html, "border-width", bw)  
    if (bdr is not None and not is_clear_value(bdr)) or (bw is not None and not is_clear_value(bw)):  
        html = set_all(html, "border-style", "solid")  
    elif (bdr is not None and is_clear_value(bdr)) and (bw is not None and is_clear_value(bw)):  
        html = set_all(html, "border-style", CLEAR_VALUE)  
    # Prefer per-corner radius when any corner field is posted; else uniform.  
    corner_vals = {}  
    any_corner = False  
    corners_posted = False  
    for c in RADIUS_CORNERS:  
        ck = fk + "_br_" + c  
        if model.DataHas(ck):  
            corners_posted = True  
            raw = model.Dictionary(ck)  
            corner_vals[c] = "" if is_clear_value(raw) else (raw or "")  
            if corner_vals[c] != "":  
                any_corner = True  
        else:  
            corner_vals[c] = ""  
    br_raw = model.Dictionary(fk + "_br") if model.DataHas(fk + "_br") else None  
    br = "" if br_raw is None or is_clear_value(br_raw) else br_raw  
    if any_corner:  
        # Fill blanks from uniform / matching corners so shorthand stays complete.  
        fill = br or next((corner_vals[c] for c in RADIUS_CORNERS if corner_vals[c]), "0px")  
        for c in RADIUS_CORNERS:  
            if corner_vals[c] == "":  
                corner_vals[c] = fill  
        shorthand = " ".join(corner_vals[c] for c in RADIUS_CORNERS)  
        html = set_all(html, "border-radius", shorthand)  
        for c, prop in RADIUS_CORNER_PROPS.items():  
            html = set_all(html, prop, corner_vals[c])  
    elif corners_posted or br_raw is not None:  
        # Cleared uniform/corners — drop radius declarations.  
        if is_clear_value(br_raw if br_raw is not None else CLEAR_VALUE) and not any_corner:  
            html = set_all(html, "border-radius", CLEAR_VALUE)  
            for prop in RADIUS_CORNER_PROPS.values():  
                html = set_all(html, prop, CLEAR_VALUE)  
        elif br:  
            html = set_all(html, "border-radius", br)  
            for prop in RADIUS_CORNER_PROPS.values():  
                html = set_all(html, prop, br)  
    for sel in sels:  
        html = apply_font(html, sel, fk)  
    return html  

def formborder_selectors(f):  
    """Return (form_sel, footer_sel). footer_sel is None when the footer  
    lives inside the form wrapper (login) — border/radius apply once."""  
    loc = f.get("loc") or ("formborder", ".form-box", ".footer-box")  
    form_sel = loc[1] if len(loc) > 1 else ".form-box"  
    footer_sel = loc[2] if len(loc) > 2 else None  
    return form_sel, footer_sel  

def read_formborder_radius(html, form_sel, footer_sel):  
    """Uniform radius from form corners (or split top/bottom when footer separate)."""  
    corners, _ = read_border_radius_corners(html, form_sel)  
    if not footer_sel:  
        for c in ("tl", "tr", "br", "bl"):  
            n, u = corners.get(c, ("", "px"))  
            if n:  
                return n, u or "px"  
        return "", "px"  
    for c in ("tl", "tr"):  
        n, u = corners.get(c, ("", "px"))  
        if n:  
            return n, u or "px"  
    fcorners, _ = read_border_radius_corners(html, footer_sel)  
    for c in ("br", "bl"):  
        n, u = fcorners.get(c, ("", "px"))  
        if n:  
            return n, u or "px"  
    return "", "px"  

def read_formborder_width(html, form_sel):  
    """Visible edge width (skip the open seam side when using per-side widths)."""  
    bw = get_css(html, form_sel, "border-width")  
    if bw and _strip_important(bw) not in ("0", "0px"):  
        return bw  
    for prop in ("border-top-width", "border-right-width", "border-left-width"):  
        side = get_css(html, form_sel, prop)  
        if side and _strip_important(side) not in ("0", "0px"):  
            return side  
    return bw or ""  

def render_formborder(key, html, form_sel, footer_sel):  
    bw = read_formborder_width(html, form_sel)  
    _bw, bc, _bs = read_border_parts(html, form_sel)  
    bw_n, bw_u = split_num_unit(bw) if bw else ("", "px")  
    if bw and not bw_u:  
        bw_u = "px"  
    if not bw_n and not bw:  
        bw_n, bw_u = "", "px"  
    br_n, br_u = read_formborder_radius(html, form_sel, footer_sel)  
    rows = (  
        _color_input_row(key + "_bdr", "Border", bc)  
        + _num_input_row("btn_" + key + "_bw", "Border width", bw_n, bw_u or "px", "px,em,rem")  
        + _num_input_row("btn_" + key + "_br", "Corner radius", br_n, br_u or "px", "px,em,rem")  
    )  
    return '<div class="she-fontctl she-formborder" data-key="' + key + '">' + rows + '</div>'  

def _clear_border_box_props(html, sel):  
    """Remove border shorthand + per-side width/style so a fresh write is clean."""  
    for prop in (  
        "border", "border-width", "border-style",  
        "border-top-width", "border-right-width",  
        "border-bottom-width", "border-left-width",  
        "border-top-style", "border-right-style",  
        "border-bottom-style", "border-left-style",  
        "border-top", "border-right", "border-bottom", "border-left",  
    ):  
        html = remove_css(html, sel, prop)  
    return html  

def apply_formborder(html, f):  
    """Border + radius. Split across form/footer when footer is a sibling;  
    otherwise apply once to the form wrapper (login).  

    Important: never set the border-width / border-style shorthands on the  
    split path — those reset all four sides and reintroduce the seam.  
    """  
    fk = f["key"]  
    form_sel, footer_sel = formborder_selectors(f)  
    html = ensure_selector_rule(html, form_sel)  
    if footer_sel:  
        html = ensure_selector_rule(html, footer_sel)  

    bdr = model.Dictionary(fk + "_bdr") if model.DataHas(fk + "_bdr") else None  
    bw = model.Dictionary(fk + "_bw") if model.DataHas(fk + "_bw") else None  
    br_raw = model.Dictionary(fk + "_br") if model.DataHas(fk + "_br") else None  

    def set_targets(h, prop, value):  
        h = write_css_prop(h, form_sel, prop, value)  
        if footer_sel:  
            h = write_css_prop(h, footer_sel, prop, value)  
        return h  

    if bdr is not None or bw is not None:  
        html = remove_css(html, form_sel, "border")  
        if footer_sel:  
            html = remove_css(html, footer_sel, "border")  
    if bdr is not None:  
        html = set_targets(html, "border-color", bdr)  

    has_edge = (  
        (bdr is not None and not is_clear_value(bdr))  
        or (bw is not None and not is_clear_value(bw)))  
    clearing = (  
        bdr is not None and is_clear_value(bdr)  
        and bw is not None and is_clear_value(bw))  

    if clearing:  
        html = _clear_border_box_props(html, form_sel)  
        if footer_sel:  
            html = _clear_border_box_props(html, footer_sel)  
        else:  
            html = write_css_prop(html, form_sel, "border-style", CLEAR_VALUE)  
    elif has_edge or bw is not None:  
        if footer_sel:  
            # Read width before dropping shorthands that still carry the value.  
            side_w = ""  
            if bw is not None and not is_clear_value(bw):  
                side_w = bw  
            else:  
                side_w = read_formborder_width(html, form_sel) or "1px"  
            if is_clear_value(side_w) or not side_w:  
                side_w = "1px"  
            # Per-side only — form open on bottom, footer open on top.  
            # Never write border-width/border-style shorthands (they reset the seam).  
            html = remove_css(html, form_sel, "border-width")  
            html = remove_css(html, form_sel, "border-style")  
            html = remove_css(html, footer_sel, "border-width")  
            html = remove_css(html, footer_sel, "border-style")  
            html = set_css(html, form_sel, "border-top-width", side_w)  
            html = set_css(html, form_sel, "border-right-width", side_w)  
            html = set_css(html, form_sel, "border-left-width", side_w)  
            html = set_css(html, form_sel, "border-bottom-width", "0")  
            html = set_css(html, form_sel, "border-top-style", "solid")  
            html = set_css(html, form_sel, "border-right-style", "solid")  
            html = set_css(html, form_sel, "border-left-style", "solid")  
            html = set_css(html, form_sel, "border-bottom-style", "none")  
            html = set_css(html, footer_sel, "border-top-width", "0")  
            html = set_css(html, footer_sel, "border-right-width", side_w)  
            html = set_css(html, footer_sel, "border-bottom-width", side_w)  
            html = set_css(html, footer_sel, "border-left-width", side_w)  
            html = set_css(html, footer_sel, "border-top-style", "none")  
            html = set_css(html, footer_sel, "border-right-style", "solid")  
            html = set_css(html, footer_sel, "border-bottom-style", "solid")  
            html = set_css(html, footer_sel, "border-left-style", "solid")  
        else:  
            if bw is not None:  
                html = write_css_prop(html, form_sel, "border-width", bw)  
            if has_edge:  
                html = set_css(html, form_sel, "border-style", "solid")  

    if br_raw is not None:  
        html = remove_css(html, form_sel, "border-radius")  
        if footer_sel:  
            html = remove_css(html, footer_sel, "border-radius")  
        if is_clear_value(br_raw):  
            for prop in RADIUS_CORNER_PROPS.values():  
                html = remove_css(html, form_sel, prop)  
                if footer_sel:  
                    html = remove_css(html, footer_sel, prop)  
        elif not footer_sel:  
            r = br_raw  
            html = set_css(html, form_sel, "border-radius", r)  
            for prop in RADIUS_CORNER_PROPS.values():  
                html = set_css(html, form_sel, prop, r)  
        else:  
            r = br_raw  
            # Form: top corners only.  
            html = set_css(html, form_sel, "border-radius", r + " " + r + " 0 0")  
            html = set_css(html, form_sel, "border-top-left-radius", r)  
            html = set_css(html, form_sel, "border-top-right-radius", r)  
            html = set_css(html, form_sel, "border-bottom-right-radius", "0")  
            html = set_css(html, form_sel, "border-bottom-left-radius", "0")  
            # Footer: bottom corners only.  
            html = set_css(html, footer_sel, "border-radius", "0 0 " + r + " " + r)  
            html = set_css(html, footer_sel, "border-top-left-radius", "0")  
            html = set_css(html, footer_sel, "border-top-right-radius", "0")  
            html = set_css(html, footer_sel, "border-bottom-right-radius", r)  
            html = set_css(html, footer_sel, "border-bottom-left-radius", r)  
    return html  

def render_subsec(key, label, inner_html):  
    """Independently collapsible subsection (starts collapsed)."""  
    return (  
        '<details class="she-subsec" data-key="' + esc(key) + '">'  
        '<summary><span class="she-subsec-label">' + esc(label) + '</span>'  
        '<span class="she-subsec-chevron" aria-hidden="true"></span></summary>'  
        '<div class="she-subsec-body">' + inner_html + '</div>'  
        '</details>')  

def render_section_fields(fields, html, fam_opts):  
    """Group fields under heading markers into independently collapsible subsections."""  
    parts = []  
    i = 0  
    n = len(fields)  
    leading = []  
    while i < n and fields[i]["type"] != "heading":  
        leading.append(control(fields[i], read_field(html, fields[i]), html, fam_opts))  
        i += 1  
    if leading:  
        parts.append('<div class="she-sec-ungrouped">' + "".join(leading) + '</div>')  
    while i < n:  
        heading = fields[i]  
        i += 1  
        group = []  
        while i < n and fields[i]["type"] != "heading":  
            group.append(control(fields[i], read_field(html, fields[i]), html, fam_opts))  
            i += 1  
        parts.append(render_subsec(heading["key"], heading["label"], "".join(group)))  
    return "".join(parts)  

def control(f, value, html, fam_opts=None):  
    key = esc(f["key"])  
    typ = f["type"]  
    if typ == "heading":  
        # Headings are grouped by render_section_fields; keep a fallback.  
        return ('<div class="she-subhead" data-key="' + key + '">'  
                + esc(f["label"]) + '</div>')  
    help_html = '<div class="she-help">' + esc(f.get("help", "")) + '</div>'  
    label = f["label"]  

    # Font / textstyle = multi-control styling for one selector -> collapsible subsection.  
    if typ == "font":  
        ctl = render_font(f["key"], f["loc"][1], html, fam_opts or [""] + GENERIC_FONTS)  
        return render_subsec(f["key"], label, ctl + help_html)  
    if typ == "textstyle":  
        loc = f["loc"]  
        colorprop = loc[2] if len(loc) > 2 else "color"  
        ctl = render_textstyle(f["key"], loc[1], html, colorprop, fam_opts or [""] + GENERIC_FONTS)  
        return render_subsec(f["key"], label, ctl + help_html)  
    if typ == "btnstyle":  
        ctl = render_btnstyle(  
            f["key"], f["loc"][1], html, fam_opts or [""] + GENERIC_FONTS)  
        return render_subsec(f["key"], label, ctl + help_html)  
    if typ == "formborder":  
        form_sel, footer_sel = formborder_selectors(f)  
        ctl = render_formborder(f["key"], html, form_sel, footer_sel)  
        return render_subsec(f["key"], label, ctl + help_html)  
    if typ == "bgpanel":  
        panel = default_bg_panel(html)  
        def bg_btn(name, lab):  
            cls = "btn btn-default btn-sm"  
            if name == panel:  
                cls += " active"  
            return (  
                '<button type="button" class="' + cls + '" data-bg-panel="' + name  
                + '" onclick="sheSetBgPanel(\'' + name + '\')">' + lab + '</button>'  
            )  
        return (  
            '<div class="she-field she-bg-panel" data-key="' + key  
            + '" data-type="bgpanel" data-panel="' + esc(panel) + '">'  
            '<div class="she-bg-switch" role="group" aria-label="Background settings">'  
            + bg_btn("color", "Color")  
            + bg_btn("image", "Image")  
            + bg_btn("video", "Video")  
            + '</div>'  
            + help_html  
            + '</div>'  
        )  

    head = '<div class="she-field" data-key="' + key + '" data-type="' + esc(typ) + '">'  
    lab  = '<label class="she-lab">' + esc(label) + '</label>'  

    if typ in ("text", "url"):  
        ctl = '<input class="she-in" id="fld_' + key + '" type="text" value="' + esc(value) + '"/>'  

    elif typ == "color":  
        ctl = _color_control_html(key, value)  

    elif typ == "number":  
        num, unit = split_num_unit(value)  
        toggle = ""  
        if f.get("unit") is True:  
            toggle = ('<span class="she-unit-toggle" id="unit_' + key + '" data-unit="' + esc(unit)  
                      + '" data-units="px,%">' + esc(unit) + '</span>')  
        else:  
            toggle = ('<span class="she-unit-fixed" id="unit_' + key + '" aria-disabled="true" title="Unit locked">'  
                      + esc(f.get("unit", "px")) + '</span>')  
        ctl = ('<span class="she-numwrap">'  
               '<input class="she-in she-num" id="fld_' + key + '" type="text" inputmode="numeric" value="' + esc(num) + '"/>'  
               + toggle + '</span>')  

    elif typ == "image":  
        thumb_cls = "she-thumb" + ("" if value else " she-thumb-empty")  
        ctl = ('<div class="she-imgctl" data-key="' + key + '">'  
               '  <input class="she-in" id="fld_' + key + '" type="text" value="' + esc(value) + '" placeholder="Paste an image URL or choose a file below"/>'  
               '  <div class="she-imgbtns">'  
               '    <input type="file" accept="image/*" id="file_' + key + '" class="she-file"/>'  
               '    <button type="button" class="btn btn-default btn-sm" onclick="sheOpenCrop(\'' + key + '\')">Edit</button>'  
               '    <button type="button" class="btn btn-default btn-sm" onclick="sheClearImage(\'' + key + '\')">Clear</button>'  
               '  </div>'  
               '  <div class="' + thumb_cls + '" id="thumbwrap_' + key + '" onclick="sheOpenCrop(\'' + key + '\')" title="Click to edit">'  
               '    <img id="thumb_' + key + '" src="' + esc(value) + '" alt=""/>'  
               '    <div class="she-thumb-hint">' + ("Click to edit" if value else "No image yet") + '</div>'  
               '  </div>'  
               '</div>')  

    elif typ == "box":  
        primary = f["loc"][1]  
        vals = {}  
        for kind in ("padding", "margin"):  
            for side in BOX_SIDES:  
                if kind == "margin" and side in ("left", "right"):  
                    cur = read_box_gutter(html, primary, side)  
                    n, u = split_num_unit(cur)  
                    if not n:  
                        n, u = "0", "px"  
                else:  
                    sel, prop = box_css_target(f, kind, side)  
                    cur = get_css(html, sel, prop)  
                    # Legacy: remapped cell empty but old value still on primary.  
                    if (not cur or cur in ("auto",)) and sel != primary:  
                        legacy = get_css(html, primary, kind + "-" + side)  
                        if legacy and legacy not in ("auto", "0", "0px"):  
                            cur = legacy  
                    if cur in ("auto",):  
                        n, u = "0", "px"  
                    else:  
                        n, u = split_num_unit(cur)  
                vals[kind + "_" + side] = {"n": n, "u": u}  
        ctl = render_box(key, vals, read_box_justify(html, primary))  

    else:  
        ctl = '<input class="she-in" id="fld_' + key + '" type="text" value="' + esc(value) + '"/>'  

    return head + lab + ctl + help_html + '</div>'  

def _box_input(key, kind, side, cell):  
    fid = "box_" + key + "_" + kind + "_" + side  
    uid = "unit_" + fid  
    return ('<span class="she-boxcell she-boxcell-' + kind + '">'  
            '<input class="she-in she-boxnum" id="' + fid + '" type="text" inputmode="numeric" value="' + esc(cell["n"]) + '"/>'  
            '<span class="she-unit-toggle" id="' + uid + '" data-unit="' + esc(cell["u"]) + '">' + esc(cell["u"]) + '</span>'  
            '</span>')  

def render_box(key, vals, justify="center"):  
    if justify not in BOX_JUSTIFY_OPTS:  
        justify = "center"  
    def cell(kind, side):  
        return _box_input(key, kind, side, vals[kind + "_" + side])  
    def jbtn(align, title, svg):  
        cls = "she-justify-btn"  
        if align == justify:  
            cls += " active"  
        return ('<button type="button" class="' + cls + '" data-align="' + align  
                + '" title="' + title + '" aria-label="' + title + '">' + svg + '</button>')  
    # Simple align icons (left / center / right).  
    icon_l = ('<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">'  
              '<path fill="currentColor" d="M2 3h12v1.5H2zm0 4h8v1.5H2zm0 4h12v1.5H2z"/></svg>')  
    icon_c = ('<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">'  
              '<path fill="currentColor" d="M2 3h12v1.5H2zm2 4h8v1.5H4zm-2 4h12v1.5H2z"/></svg>')  
    icon_r = ('<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">'  
              '<path fill="currentColor" d="M2 3h12v1.5H2zm4 4h8v1.5H6zm-4 4h12v1.5H2z"/></svg>')  
    return ('<div class="she-boxmodel" data-key="' + key + '">'  
            '  <div class="she-justify" role="group" aria-label="Horizontal align">'  
            + jbtn("left", "Align left", icon_l)  
            + jbtn("center", "Align center", icon_c)  
            + jbtn("right", "Align right", icon_r) +  
            '  </div>'  
            '  <input type="hidden" id="box_' + key + '_justify" value="' + esc(justify) + '"/>'  
            '  <div class="she-bm-label she-bm-margin-label">margin</div>'  
            '  <div class="she-bm-margin">'  
            + cell("margin", "top") +  
            '    <div class="she-bm-row">' + cell("margin", "left") +  
            '      <div class="she-bm-padding">'  
            '        <div class="she-bm-plabel">padding</div>'  
            + cell("padding", "top") +  
            '        <div class="she-bm-row">' + cell("padding", "left") +  
            '          <div class="she-bm-content" title="content">&#9635;</div>'  
            + cell("padding", "right") +  
            '        </div>'  
            + cell("padding", "bottom") +  
            '      </div>'  
            + cell("margin", "right") +  
            '    </div>'  
            + cell("margin", "bottom") +  
            '  </div>'  
            '</div>')  

