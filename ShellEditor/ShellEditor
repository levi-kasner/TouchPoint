def giving_preview_src(raw):  
    s = (raw or "").strip()  
    if not s:  
        return "/Give/"  
    if "://" in s:  
        # Full URL: keep path (+ query) so the iframe stays same-origin.  
        m = re.search(r'://[^/]+(/.*)$', s)  
        return m.group(1) if m else "/Give/"  
    if s.startswith("/"):  
        return s  
    if s.lower().startswith("give/"):  
        return "/" + s  
    return "/Give/" + s.lstrip("/")  

