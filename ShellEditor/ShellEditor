_BG_MEDIA_ONLOAD_FILE = "window.__sheBgMediaReveal&&window.__sheBgMediaReveal(this)"  
_BG_MEDIA_ONLOAD_EMBED = "window.__sheBgMediaEmbedLoad&&window.__sheBgMediaEmbedLoad(this)"  

def _html_attr(s):  
    return (s or "").replace("&", "&amp;").replace('"', "&quot;").replace("<", "&lt;")  

def _html_unattr(s):  
    return (s or "").replace("&quot;", '"').replace("&lt;", "<").replace("&amp;", "&")  

def _strip_legacy_bg_mode_classes(html):  
    """Remove exclusive image/video body classes from older shells."""  
    def repl(m):  
        attrs = m.group(1) or ""  
        cm = re.search(r'\bclass=(["\'])(.*?)\1', attrs, re.I | re.S)  
        if not cm:  
            return m.group(0)  
        quote = cm.group(1)  
        drop = set(c.lower() for c in _BG_LEGACY_MODE_CLASSES)  
        classes = [c for c in cm.group(2).split() if c.lower() not in drop]  
        if not classes:  
            new_attrs = (attrs[:cm.start()] + attrs[cm.end():]).rstrip()  
        else:  
            new_attrs = (attrs[:cm.start()]  
                         + "class=" + quote + " ".join(classes) + quote  
                         + attrs[cm.end():])  
        return "<body" + new_attrs + ">"  

    out, n = re.subn(r'<body([^>]*)>', repl, html, count=1, flags=re.I)  
    return out if n else html  

def parse_bg_video_url(url):  
    """Return (kind, id, play_url). kind is youtube|vimeo|file|''."""  
    url = (url or "").strip()  
    if not url:  
        return ("", "", "")  
    m = re.search(  
        r'(?:youtube\.com/watch\?(?:[^#]*&)?v=|youtu\.be/|youtube\.com/embed/'  
        r'|youtube\.com/shorts/)([A-Za-z0-9_-]{6,})',  
        url, re.I)  
    if m:  
        vid = m.group(1)  
        play = (  
            "https://www.youtube.com/embed/" + vid  
            + "?autoplay=1&mute=1&controls=0&playsinline=1&loop=1&playlist=" + vid  
            + "&modestbranding=1&rel=0&showinfo=0&iv_load_policy=3&disablekb=1&fs=0"  
            + "&enablejsapi=1"  
        )  
        return ("youtube", vid, play)  
    m = re.search(  
        r'(?:player\.vimeo\.com/video/|(?:www\.)?vimeo\.com/(?:video/)?)(\d+)',  
        url, re.I)  
    if m:  
        vid = m.group(1)  
        play = (  
            "https://player.vimeo.com/video/" + vid  
            + "?background=1&autoplay=1&loop=1&muted=1&autopause=0&api=1"  
            + "&title=0&byline=0&portrait=0"  
        )  
        return ("vimeo", vid, play)  
    return ("file", "", url)  

def build_bg_media_markup(url):  
    """Build the fixed background media wrapper for a user-entered URL."""  
    raw = (url or "").strip()  
    if not raw:  
        return (  
            '<div class="' + BG_MEDIA_CLASS + '" data-she-bg-src="" '  
            'aria-hidden="true" hidden></div>'  
        )  
    kind, _vid, play = parse_bg_video_url(raw)  
    attr_src = _html_attr(raw)  
    # Keep hidden until play; iframe load alone must not reveal the layer.  
    wrap_open = (  
        '<div class="' + BG_MEDIA_CLASS + '" data-she-bg-src="' + attr_src  
        + '" data-she-bg-kind="' + _html_attr(kind) + '" aria-hidden="true" '  
        'style="opacity:0 !important">'  
    )  
    if kind in ("youtube", "vimeo"):  
        onload = _html_attr(_BG_MEDIA_ONLOAD_EMBED)  
        return (  
            wrap_open  
            + '<iframe class="she-bg-media-frame" src="' + _html_attr(play) + '" '  
            'title="Background video" '  
            'allow="autoplay; encrypted-media; picture-in-picture; fullscreen" '  
            'referrerpolicy="strict-origin-when-cross-origin" '  
            'allowfullscreen frameborder="0" tabindex="-1" '  
            'onload="' + onload + '"></iframe>'  
            + '</div>'  
        )  
    onplay = _html_attr(_BG_MEDIA_ONLOAD_FILE)  
    return (  
        wrap_open  
        + '<video class="she-bg-media-frame" src="' + _html_attr(play) + '" '  
        'autoplay muted loop playsinline preload="auto" '  
        'onplaying="' + onplay + '"></video>'  
        + '</div>'  
    )  

def get_bg_video_url(html):  
    """User-entered background video URL (YouTube / Vimeo / direct file)."""  
    m = re.search(  
        r'<div\b[^>]*\bclass="[^"]*\bshe-bg-media\b[^"]*"[^>]*\bdata-she-bg-src="([^"]*)"',  
        html or "", re.I | re.S)  
    if m:  
        return _html_unattr(m.group(1)).strip()  
    m = re.search(  
        r'<div\b[^>]*\bdata-she-bg-src="([^"]*)"[^>]*\bclass="[^"]*\bshe-bg-media\b',  
        html or "", re.I | re.S)  
    if m:  
        return _html_unattr(m.group(1)).strip()  
    # Legacy bare <video class="she-bg-video">  
    m = re.search(  
        r'<video\b[^>]*\bclass="[^"]*\bshe-bg-video\b[^"]*"[^>]*\bsrc="([^"]*)"',  
        html or "", re.I | re.S)  
    if not m:  
        m = re.search(  
            r'<video\b[^>]*\bsrc="([^"]*)"[^>]*\bclass="[^"]*\bshe-bg-video\b',  
            html or "", re.I | re.S)  
    return _html_unattr(m.group(1)).strip() if m else ""  

def _inject_or_replace_bg_video_css(html):  
    """Ensure the layered background-video CSS block is present and current."""  
    if _BG_VIDEO_CSS_MARKER in html:  
        out, n = _BG_VIDEO_CSS_BLOCK_RE.subn(_BG_VIDEO_CSS.rstrip("\n") + "\n", html, count=1)  
        return out if n else html  
    masked = _mask_html_comments(html)  
    sm = _STYLE_BLOCK_RE.search(masked)  
    if not sm:  
        return html  
    start, end = sm.start(), sm.end()  
    block = html[start:end]  
    close_at = block.lower().rfind("</style>")  
    if close_at < 0:  
        return html  
    return html[:start] + block[:close_at] + _BG_VIDEO_CSS + block[close_at:] + html[end:]  

def _inject_or_replace_bg_media_script(html):  
    """Ensure fade-in helper script is present immediately after <body>."""  
    # Drop any prior copy (end-of-body or mid-document) before re-inserting.  
    out = _BG_MEDIA_SCRIPT_RE.sub("", html)  
    out2, n = re.subn(  
        r"(<body[^>]*>)",  
        r"\1" + _BG_MEDIA_SCRIPT,  
        out, count=1, flags=re.I)  
    return out2 if n else out  

def ensure_bg_media(html):  
    """Add/migrate background media wrapper + layered CSS + fade-in script."""  
    if not html:  
        return html or ""  
    out = _strip_legacy_bg_mode_classes(html)  
    # Script first (right after <body>) so iframe onload can call the reveal helper.  
    out = _inject_or_replace_bg_media_script(out)  
    if _BG_MEDIA_TAG_RE.search(out):  
        # Migrate legacy <video class="she-bg-video"> or refresh wrapper markup.  
        cur = get_bg_video_url(out)  
        out2, n = _BG_MEDIA_TAG_RE.subn(build_bg_media_markup(cur), out, count=1)  
        if n:  
            out = out2  
    else:  
        out2, n = re.subn(  
            r'(<body[^>]*>)',  
            r'\1' + build_bg_media_markup(""),  
            out, count=1, flags=re.I)  
        if n:  
            out = out2  
        # If body inject of empty media ran without script prefix, restore order.  
        out = _inject_or_replace_bg_media_script(out)  
    out = _inject_or_replace_bg_video_css(out)  
    return out  

def set_bg_video_url(html, url):  
    html = ensure_bg_media(html)  
    url = (url or "").strip()  
    out, n = _BG_MEDIA_TAG_RE.subn(build_bg_media_markup(url), html, count=1)  
    if n:  
        _invalidate_css_cache()  
        return out  
    # ensure_bg_media should have inserted a tag; fall back to body inject.  
    out2, n2 = re.subn(  
        r'(<body[^>]*>)',  
        r'\1' + build_bg_media_markup(url),  
        html, count=1, flags=re.I)  
    if n2:  
        _invalidate_css_cache()  
        return out2  
    return html  

def default_bg_panel(html):  
    """Editor-only initial Color/Image/Video panel (not stored on the shell)."""  
    if get_bg_video_url(html):  
        return "video"  
    if get_bg_url(html, "body"):  
        return "image"  
    return "color"  

# ---- footer text / href on class-scoped elements -------------------------  
def get_el_text(html, cls):  
    m = re.search(r'<[^>]*class="[^"]*\b' + re.escape(cls) + r'\b[^"]*"[^>]*>(.*?)</', html, re.I | re.S)  
    return (m.group(1).strip() if m else "")  

def set_el_text(html, cls, value):  
    pat = r'(<[^>]*class="[^"]*\b' + re.escape(cls) + r'\b[^"]*"[^>]*>)(.*?)(</)'  
    return re.sub(pat, lambda mm: mm.group(1) + value + mm.group(3), html, count=1, flags=re.I | re.S)  

def get_href(html, cls):  
    m = re.search(r'<a[^>]*class="[^"]*\b' + re.escape(cls) + r'\b[^"]*"[^>]*href="([^"]*)"', html, re.I | re.S)  
    if not m:  
        m = re.search(r'<a[^>]*href="([^"]*)"[^>]*class="[^"]*\b' + re.escape(cls) + r'\b[^"]*"', html, re.I | re.S)  
    return m.group(1) if m else ""  

def set_href(html, cls, url):  
    pat = r'(<a[^>]*class="[^"]*\b' + re.escape(cls) + r'\b[^"]*"[^>]*>)'  
    def repl(mtag):  
        tag = mtag.group(1)  
        if re.search(r'\bhref="', tag, re.I):  
            return re.sub(r'(\bhref=")[^"]*(")', lambda mm: mm.group(1) + url + mm.group(2), tag, count=1, flags=re.I)  
        return re.sub(r'(<a)', r'\1 href="' + url + '"', tag, count=1, flags=re.I)  
    return re.sub(pat, repl, html, count=1, flags=re.I | re.S)  

# ---- font @import url ----------------------------------------------------  
def get_font_import(html):  
    m = re.search(r'@import\s+url\(\s*[\'"]?([^\'")]+)[\'"]?\s*\)', html, re.I)  
    return m.group(1) if m else ""  

def set_font_import(html, url):  
    url = (url or "").strip()  
    if not url:  
        # Remove the Google Fonts @import when the URL field is cleared.  
        return re.sub(  
            r'[ \t]*@import\s+url\(\s*[\'"]?[^\'")]*[\'"]?\s*\)\s*;?[ \t]*\r?\n?',  
            "", html, count=1, flags=re.I)  
    if re.search(r'@import\s+url\(', html, re.I):  
        return re.sub(r'(@import\s+url\(\s*[\'"]?)[^\'")]*([\'"]?\s*\))',  
                      lambda mm: mm.group(1) + url + mm.group(2), html, count=1, flags=re.I)  
    return html  

# ---- family names from the @import Google Fonts URL ----------------------  
def get_font_families(html):  
    url = get_font_import(html)  
    out = []  
    for fam in re.findall(r'family=([^:&]+)', url or "", re.I):  
        name = fam.replace("+", " ").strip()  
        if name and name not in out:  
            out.append(name)  
    return out  

# ---- split a number and its unit:  "25px" -> (25,"px"),  ".97em" -> (.97,"em")  
def split_num_unit(val):  
    if not val:  
        return ("", "px")  
    m = re.match(r'\s*(-?(?:\d+\.?\d*|\.\d+))\s*(px|%|em|rem|vw|vh)?\s*$', str(val))  
    if not m:  
        return ("", "px")  
    num = m.group(1)  
    if "." in num:  
        num = num.rstrip("0").rstrip(".")  
        if num in ("", "-", "-."):  
            num = m.group(1)  
    return (num, m.group(2) or "px")  

# ========================= FIELD READ / WRITE =========================  
# loc tuple conventions:  
#   ("imgsrc", cls)                          logo image src attribute  
#   ("css", selector, prop, is_number)       css property (is_number => unit editing)  
#   ("bgurl", selector)                      background-image url()  
#   ("bgvideo",)                             page background <video> src  
#   ("bgpanel",)                             editor-only Color/Image/Video switch  
#   ("eltext", cls)                          inner text of a class-scoped element  
#   ("href", cls)                            href of a class-scoped anchor  
#   ("fontimport",)                          @import font url  
#   ("font", selector)                       grouped font controls  
#   ("textstyle", selector, colorprop)       color + font under one heading  
def read_field(html, f):  
    loc = f["loc"]  
    k = loc[0]  
    if k == "imgsrc":     return get_img_src(html, loc[1])  
    if k == "css":  
        sel, prop = loc[1], loc[2]  
        if prop == "max-width":  
            base = get_css(html, sel, "--she-max-w")  
            if base:  
                return base  
            return parse_max_width_base(get_css(html, sel, "max-width"))  
        return get_css(html, sel, prop)  
    if k == "bgurl":      return get_bg_url(html, loc[1])  
    if k == "bgvideo":    return get_bg_video_url(html)  
    if k == "bgpanel":    return ""  
    if k == "eltext":     return get_el_text(html, loc[1])  
    if k == "href":       return get_href(html, loc[1])  
    if k == "fontimport": return get_font_import(html)  
    if k == "font":       return ""  
    if k == "textstyle":  return ""  
    return ""  

# Posted by the browser when a field is intentionally cleared.  
# Empty strings are often omitted from PyScriptForm DataHas/Dictionary.  
CLEAR_VALUE = "__CLEAR__"  
IMAGE_CLEAR = CLEAR_VALUE  # backwards-compatible alias  

def is_clear_value(value):  
    return value is None or value == "" or value == CLEAR_VALUE  

def normalize_posted(value):  
    """Map the clear sentinel to "" for writers that store empty strings."""  
    if is_clear_value(value):  
        return ""  
    return value  

def write_css_prop(html, selector, prop, value):  
    """Set a CSS property, or remove it when the editor value was cleared."""  
    if is_clear_value(value):  
        return remove_css(html, selector, prop)  
    return set_css(html, selector, prop, value)  

def write_field(html, f, value):  
    loc = f["loc"]  
    k = loc[0]  
    clearing = is_clear_value(value)  
    value = normalize_posted(value)  
    if k == "imgsrc":     return set_img_src(html, loc[1], value)  
    if k == "css":  
        sels = [loc[1]] + list(f.get("also") or [])  
        prop = loc[2]  
        for sel in sels:  
            if clearing:  
                html = remove_css(html, sel, prop)  
                if prop == "max-width":  
                    html = remove_css(html, sel, "--she-max-w")  
            else:  
                html = ensure_selector_rule(html, sel)  
                html = set_css(html, sel, prop, value)  
                if prop == "max-width":  
                    html = set_css(html, sel, "--she-max-w", value)  
                    html = sync_gutter_max_width(html, sel)  
        return html  
    if k == "bgurl":      return set_bg_url(html, loc[1], value)  
    if k == "bgvideo":    return set_bg_video_url(html, value)  
    if k == "bgpanel":    return html  
    if k == "eltext":     return set_el_text(html, loc[1], value)  
    if k == "href":       return set_href(html, loc[1], value)  
    if k == "fontimport": return set_font_import(html, value)  
    return html  

# ---- apply all font sub-properties for a given field key (POST) ----------  
def apply_font(html, sel, fk):  
    if model.DataHas("font_" + fk + "_family"):  
        html = write_css_prop(html, sel, "font-family", model.Dictionary("font_" + fk + "_family"))  
    # Weight dropdown is authoritative; bold checkbox is only a UI shortcut that syncs the select.  
    weight = model.Dictionary("font_" + fk + "_weight") if model.DataHas("font_" + fk + "_weight") else ""  
    if is_clear_value(weight) and model.DataHas("font_" + fk + "_bold") and model.Dictionary("font_" + fk + "_bold") == "true":  
        weight = "bold"  
    if model.DataHas("font_" + fk + "_weight") or weight == "bold":  
        html = write_css_prop(html, sel, "font-weight", weight)  
    if model.DataHas("font_" + fk + "_size"):  
        html = write_css_prop(html, sel, "font-size", model.Dictionary("font_" + fk + "_size"))  
    if model.DataHas("font_" + fk + "_spacing"):  
        html = write_css_prop(html, sel, "letter-spacing", model.Dictionary("font_" + fk + "_spacing"))  
    if model.DataHas("font_" + fk + "_lineheight"):  
        html = write_css_prop(html, sel, "line-height", model.Dictionary("font_" + fk + "_lineheight"))  
    if model.DataHas("font_" + fk + "_italic"):  
        style = "italic" if model.Dictionary("font_" + fk + "_italic") == "true" else "normal"  
        html = set_css(html, sel, "font-style", style)  
    return html  

# ========================= FIELD REGISTRY =========================  
# type: "text" | "url" | "image" | "color" | "number" | "box" | "font" |  
#       "textstyle" | "btnstyle" | "formborder" | "bgpanel" | "heading"  
# Optional "shells": iterable of shell kinds this field applies to (default: all).  
# Optional "*_by_shell" overrides (loc/label/help/also/box_bottom_sel/box_align_also).  
#   A value of None removes that key for the shell.  
# Optional "also": extra selectors to keep in sync (btnstyle / css).  
_FIELD_BY_SHELL_KEYS = (  
    "loc", "label", "help", "also", "box_bottom_sel", "box_align_also")  

def field_applies(f, kind):  
    shells = f.get("shells")  
    return (not shells) or (kind in shells)  

def resolve_field(f, kind):  
    out = dict(f)  
    for key in _FIELD_BY_SHELL_KEYS:  
        by = f.get(key + "_by_shell")  
        if not by or kind not in by:  
            continue  
        val = by[kind]  
        if val is None:  
            out.pop(key, None)  
        else:  
            out[key] = val  
    return out  

def active_fields(kind):  
    return [resolve_field(f, kind) for f in FIELDS if field_applies(f, kind)]  

