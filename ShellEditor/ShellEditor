def esc(s):  
    if s is None:  
        return ""  
    s = str(s)  
    return (s.replace("&", "&amp;").replace("<", "&lt;")  
             .replace(">", "&gt;").replace('"', "&quot;"))  

# ---- image src on an element carrying a given class (order-independent) ----  
def _img_class_list(tag):  
    """Return class tokens from an <img ...> tag (double or single quotes)."""  
    m = re.search(r'\bclass\s*=\s*"([^"]*)"', tag, re.I)  
    if not m:  
        m = re.search(r"\bclass\s*=\s*'([^']*)'", tag, re.I)  
    if not m:  
        return []  
    return [c for c in re.split(r'\s+', m.group(1).strip()) if c]  
  
def _iter_img_tags(html, cls):  
    """Yield (start, end, tag) for each <img> whose class list contains cls.  
  
    Uses plain '>' scans instead of [^>]* regex over huge data-URL tags  
    (footer/header logos can be 60KB+ base64).  
    """  
    if not html or not cls:  
        return  
    low = html.lower()  
    i = 0  
    while True:  
        j = low.find("<img", i)  
        if j < 0:  
            return  
        # Only match a real tag start ("<img" / "<img " / "<img\n"), not "<imgs...".  
        nxt = low[j + 4:j + 5]  
        if nxt and nxt not in ("", " ", "\t", "\n", "\r", "/", ">"):  
            i = j + 4  
            continue  
        k = html.find(">", j)  
        if k < 0:  
            return  
        tag = html[j:k + 1]  
        if cls in _img_class_list(tag):  
            yield j, k + 1, tag  
        i = k + 1  
  
def get_img_src(html, cls):  
    for _start, _end, tag in _iter_img_tags(html, cls):  
        m = re.search(r'\bsrc\s*=\s*"([^"]*)"', tag, re.I)  
        if not m:  
            m = re.search(r"\bsrc\s*=\s*'([^']*)'", tag, re.I)  
        return m.group(1) if m else ""  
    return ""  
  
def _inject_logo_img(html, cls, url):  
    """Insert a missing header/footer logo img at a conventional location."""  
    tag = '<img alt="" class="' + cls + '" src="' + (url or "") + '" />'  
    if cls == "header-logo":  
        m = _BG_MEDIA_TAG_RE.search(html or "")  
        if m:  
            return html[:m.end()] + tag + html[m.end():]  
        m = re.search(  
            r"(<!-- ==== SHELL-EDITOR BACKGROUND MEDIA SCRIPT ==== -->.*?</script>)",  
            html or "", re.I | re.S)  
        if m:  
            return html[:m.end()] + tag + html[m.end():]  
        m = re.search(r"(<body[^>]*>)", html or "", re.I)  
        if m:  
            return html[:m.end()] + tag + html[m.end():]  
        return html  
    if cls == "footer-logo":  
        m = re.search(  
            r'(<p\b[^>]*\bclass="[^"]*\bfooter-box\b[^"]*"[^>]*>)',  
            html or "", re.I)  
        if not m:  
            m = re.search(  
                r"(<p\b[^>]*\bclass='[^']*\bfooter-box\b[^']*'[^>]*>)",  
                html or "", re.I)  
        if m:  
            return html[:m.end()] + tag + html[m.end():]  
    return html  
  
def set_img_src(html, cls, url):  
    """Set (or create) the src on the logo <img class='cls'> tag."""  
    url = url or ""  
    for start, end, tag in _iter_img_tags(html, cls):  
        if re.search(r'\bsrc\s*=\s*"', tag, re.I):  
            new_tag = re.sub(  
                r'(\bsrc\s*=\s*")[^"]*(")',  
                lambda mm: mm.group(1) + url + mm.group(2),  
                tag, count=1, flags=re.I)  
        elif re.search(r"\bsrc\s*=\s*'", tag, re.I):  
            new_tag = re.sub(  
                r"(\bsrc\s*=\s*')[^']*(')",  
                lambda mm: mm.group(1) + url + mm.group(2),  
                tag, count=1, flags=re.I)  
        else:  
            # No src yet — insert before the closing > or />.  
            if tag.endswith("/>"):  
                new_tag = tag[:-2] + ' src="' + url + '" />'  
            else:  
                new_tag = tag[:-1] + ' src="' + url + '">'  
        return html[:start] + new_tag + html[end:]  
    # Tag missing (e.g. removed by an earlier heal) — put it back.  
    return _inject_logo_img(html, cls, url)  

# ---- a single CSS property inside a `.selector { ... }` rule -------------  
# Index every rule in <style> blocks once. Do NOT use a "comma-prefix + selector"  
# regex over the full HTML — Google Font @import URLs with many commas  
# (common on giving shells) make that pattern catastrophically slow.  
_css_html_id = None  
_css_index = {}       # selector -> {'body_start','body_end'} absolute offsets  
_css_props_cache = {} # selector -> {prop.lower(): value}  
_STYLE_BLOCK_RE = re.compile(r'<style\b[^>]*>(.*?)</style>', re.I | re.S)  

def _invalidate_css_cache():  
    global _css_html_id, _css_index, _css_props_cache  
    _css_html_id = None  
    _css_index = {}  
    _css_props_cache = {}  

def _mask_html_comments(html):  
    """Replace HTML comments with spaces (same length) so offsets still match."""  
    return re.sub(r'<!--.*?-->', lambda m: " " * len(m.group(0)), html, flags=re.S)  

def _iter_style_blocks(html):  
    """Yield (content, absolute_content_start) for each real <style> block.  

    Templates mention `<style>` inside HTML comments; matching on raw HTML would  
    start there and swallow the page until the real </style>, missing `body`.  
    """  
    masked = _mask_html_comments(html)  
    for sm in _STYLE_BLOCK_RE.finditer(masked):  
        yield html[sm.start(1):sm.end(1)], sm.start(1)  

def _build_css_index(html):  
    """Map each selector to every rule body that includes it (grouped OK).  

    `.form-box` appears both in a shared background rule and a layout rule;  
    callers pick the right entry per property.  
    """  
    index = {}  
    for content, base in _iter_style_blocks(html):  
        i = 0  
        n = len(content)  
        while i < n:  
            if content.startswith("/*", i):  
                end = content.find("*/", i + 2)  
                i = n if end < 0 else end + 2  
                continue  
            ch = content[i]  
            if ch.isspace():  
                i += 1  
                continue  
            if ch == "@":  
                # @import url('...'); — Google Fonts URLs often contain ';' inside  
                # the query string; only treat a ';' outside quotes/parens as EOL.  
                if content[i:i + 7].lower() == "@import":  
                    j = i + 7  
                    in_quote = None  
                    paren = 0  
                    while j < n:  
                        c = content[j]  
                        if in_quote:  
                            if c == in_quote:  
                                in_quote = None  
                        elif c in ("'", '"'):  
                            in_quote = c  
                        elif c == "(":  
                            paren += 1  
                        elif c == ")":  
                            if paren > 0:  
                                paren -= 1  
                        elif c == ";" and paren == 0:  
                            j += 1  
                            break  
                        j += 1  
                    i = j  
                    continue  
                # @media / @supports / @keyframes { ... }  
                j = i + 1  
                while j < n and content[j] not in ";{":  
                    if content.startswith("/*", j):  
                        end = content.find("*/", j + 2)  
                        j = n if end < 0 else end + 2  
                        continue  
                    j += 1  
                if j < n and content[j] == ";":  
                    i = j + 1  
                    continue  
                if j < n and content[j] == "{":  
                    depth = 1  
                    j += 1  
                    while j < n and depth:  
                        if content.startswith("/*", j):  
                            end = content.find("*/", j + 2)  
                            j = n if end < 0 else end + 2  
                            continue  
                        if content[j] == "{":  
                            depth += 1  
                        elif content[j] == "}":  
                            depth -= 1  
                        j += 1  
                    i = j  
                    continue  
                break  
            brace = content.find("{", i)  
            if brace < 0:  
                break  
            selectors_raw = content[i:brace]  
            depth = 1  
            j = brace + 1  
            while j < n and depth:  
                if content.startswith("/*", j):  
                    end = content.find("*/", j + 2)  
                    j = n if end < 0 else end + 2  
                    continue  
                if content[j] == "{":  
                    depth += 1  
                elif content[j] == "}":  
                    depth -= 1  
                j += 1  
            body_start = base + brace + 1  
            body_end = base + (j - 1)  
            sels = [s.strip() for s in selectors_raw.split(",") if s.strip()]  
            info = {  
                "body_start": body_start,  
                "body_end": body_end,  
                "standalone": len(sels) == 1,  
            }  
            for sel in sels:  
                index.setdefault(sel, []).append(info)  
            i = j  
    return index  

def _ensure_css_cache(html):  
    global _css_html_id, _css_index, _css_props_cache  
    hid = id(html)  
    if hid != _css_html_id:  
        _css_html_id = hid  
        _css_index = _build_css_index(html)  
        _css_props_cache = {}  

def _splice_html(html, start, end, new_chunk):  
    """Replace html[start:end] with new_chunk and keep CSS rule offsets in sync.  

    Button/style saves call set_css many times; rebuilding the full index after  
    every edit was the main slowdown on giving shells.  
    """  
    global _css_html_id, _css_index, _css_props_cache  
    new_html = html[:start] + new_chunk + html[end:]  
    delta = len(new_chunk) - (end - start)  
    if delta == 0 and new_chunk == html[start:end]:  
        return html  
    if id(html) != _css_html_id or not _css_index:  
        return new_html  
    if delta == 0:  
        _css_html_id = id(new_html)  
        _css_props_cache = {}  
        return new_html  
    seen = set()  
    for infos in _css_index.values():  
        for info in infos:  
            iid = id(info)  
            if iid in seen:  
                continue  
            seen.add(iid)  
            bs = info["body_start"]  
            be = info["body_end"]  
            if be < start:  
                continue  
            if bs >= end:  
                info["body_start"] = bs + delta  
                info["body_end"] = be + delta  
            elif bs <= start and be >= end:  
                info["body_end"] = be + delta  
            else:  
                # Overlapping edit — fall back to a full rebuild.  
                _invalidate_css_cache()  
                return new_html  
    _css_html_id = id(new_html)  
    _css_props_cache = {}  
    return new_html  

def _strip_important(val):  
    return re.sub(r'\s*!important\s*$', '', (val or "").strip(), flags=re.I).strip()  

def _with_important(val):  
    val = _strip_important(val)  
    if val == "":  
        return ""  
    return val + " !important"  

def _css_rule_info_for_prop(html, selector, prop):  
    """Choose which rule to edit when a selector appears more than once."""  
    _ensure_css_cache(html)  
    infos = _css_index.get(selector) or []  
    if not infos:  
        return None  
    prop = (prop or "").lower()  
    found = None  
    if prop:  
        prop_re = re.compile(r'(?<![-\w])' + re.escape(prop) + r'\s*:', re.I)  
        for info in infos:  
            body = html[info["body_start"]:info["body_end"]]  
            if prop_re.search(body):  
                found = info  
    if found:  
        return found  
    for info in reversed(infos):  
        if info.get("standalone"):  
            return info  
    return infos[-1]  

def _css_props(html, selector):  
    """Merged props for a selector (later rules win — matches cascade)."""  
    _ensure_css_cache(html)  
    if selector in _css_props_cache:  
        return _css_props_cache[selector]  
    props = {}  
    for info in _css_index.get(selector) or []:  
        body = html[info["body_start"]:info["body_end"]]  
        for m in re.finditer(r'(?<![-\w])([\w-]+)\s*:\s*([^;]+);', body):  
            props[m.group(1).lower()] = _strip_important(m.group(2))  
    _css_props_cache[selector] = props  
    return props  

def get_css(html, selector, prop):  
    return _css_props(html, selector).get((prop or "").lower(), "")  

def set_css(html, selector, prop, value):  
    info = _css_rule_info_for_prop(html, selector, prop)  
    if not info:  
        return html  
    value = _with_important(value)  
    if value == "":  
        return html  
    body = html[info["body_start"]:info["body_end"]]  
    prop_re = re.compile(r'((?<![-\w])' + re.escape(prop) + r'\s*:\s*)([^;]+)(;)', re.I)  
    m = prop_re.search(body)  
    if m and _strip_important(m.group(2)) == _strip_important(value):  
        return html  # already set — avoid rewrite + string copy  
    if m:  
        newbody = prop_re.sub(lambda mm: mm.group(1) + value + mm.group(3), body, count=1)  
    else:  
        newbody = body.rstrip()  
        if newbody and not newbody.endswith(";"):  
            newbody += ";"  
        newbody = newbody + "\n    " + prop + ": " + value + ";\n"  
    if newbody == body:  
        return html  
    return _splice_html(html, info["body_start"], info["body_end"], newbody)  

def remove_css(html, selector, prop):  
    """Delete a property declaration from a selector’s rule body."""  
    info = _css_rule_info_for_prop(html, selector, prop)  
    if not info:  
        return html  
    body = html[info["body_start"]:info["body_end"]]  
    prop_re = re.compile(  
        r'(?<![-\w])' + re.escape(prop) + r'\s*:\s*[^;]+;?[ \t]*', re.I)  
    newbody, n = prop_re.subn("", body, count=1)  
    if not n:  
        return html  
    return _splice_html(html, info["body_start"], info["body_end"], newbody)  

# Icon selectors beside Sign In / signed-in name. ::before inherits font from  
