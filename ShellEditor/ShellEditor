def box_css_target(f, kind, side):  
    """Return (selector, css_property) for one box-model cell.  

    Form spacing: bottom cells target the footer strip.  
    Footer logo: top margin remaps to footer-box padding-top (keeps strips joined).  
    Left/right margin cells are gutters (handled separately via --she-gutter-*).  
    """  
    if side == "bottom" and f.get("box_bottom_sel"):  
        return f["box_bottom_sel"], kind + "-" + side  
    remap = f.get("box_remap") or {}  
    hit = remap.get((kind, side))  
    if hit:  
        return hit[0], hit[1]  
    return f["loc"][1], kind + "-" + side  

def box_align_selectors(f):  
    primary = f["loc"][1]  
    out = [primary]  
    for sel in f.get("box_align_also") or []:  
        if sel and sel not in out:  
            out.append(sel)  
    return out  

def ensure_selector_rule(html, selector):  
    """Make sure a `{ }` rule exists for selector so set_css can write to it."""  
    global _css_html_id, _css_index  
    _ensure_css_cache(html)  
    if _css_index.get(selector):  
        return html  
    idx = html.lower().rfind("</style>")  
    if idx < 0:  
        return html  
    insertion = "\n\t" + selector + " {\n\t}\n"  
    new_html = _splice_html(html, idx, idx, insertion)  
    # Register the new empty rule in the live index (splice has no body to find).  
    if id(new_html) == _css_html_id and _css_index is not None:  
        brace = insertion.find("{")  
        rbrace = insertion.rfind("}")  
        info = {  
            "body_start": idx + brace + 1,  
            "body_end": idx + rbrace,  
            "standalone": True,  
        }  
        _css_index.setdefault(selector, []).append(info)  
    return new_html  

def parse_max_width_base(mw):  
    """Unwrap min(BASE, calc(...)) written for side gutters; else return mw."""  
    if not mw:  
        return ""  
    mw = _strip_important(mw).strip()  
    m = re.match(r'min\(\s*([^,]+?)\s*,', mw, re.I)  
    if m:  
        return m.group(1).strip()  
    return mw  

def sync_gutter_max_width(html, selector):  
    """Keep max-width as min(base, 100% - gutters) so side gaps stay honored."""  
    base = get_css(html, selector, "--she-max-w") or parse_max_width_base(  
        get_css(html, selector, "max-width"))  
    if not base:  
        return html  
    gl = get_css(html, selector, "--she-gutter-l") or "0px"  
    gr = get_css(html, selector, "--she-gutter-r") or "0px"  
    html = set_css(html, selector, "--she-max-w", base)  
    if gl in ("0", "0px") and gr in ("0", "0px"):  
        return set_css(html, selector, "max-width", base)  
    return set_css(  
        html, selector, "max-width",  
        "min(" + base + ", calc(100% - " + gl + " - " + gr + "))")  

def read_box_justify(html, selector):  
    j = (get_css(html, selector, "--she-justify") or "").strip().lower()  
    if j in BOX_JUSTIFY_OPTS:  
        return j  
    ml = (get_css(html, selector, "margin-left") or "").strip().lower()  
    mr = (get_css(html, selector, "margin-right") or "").strip().lower()  
    if ml == "auto" and mr == "auto":  
        return "center"  
    if ml == "auto":  
        return "right"  
    if mr == "auto":  
        return "left"  
    return "center"  

def read_box_gutter(html, selector, side):  
    prop = "--she-gutter-l" if side == "left" else "--she-gutter-r"  
    cur = get_css(html, selector, prop)  
    if cur:  
        return cur  
    # Legacy: leftover side margin (ignore auto).  
    m = get_css(html, selector, "margin-" + side)  
    if m and m.strip().lower() != "auto":  
        return m  
    return "0px"  

def apply_box_align(html, selectors, justify, gutter_l, gutter_r):  
    """Apply L/C/R justify; left/right values are min side gutters only."""  
    gl = gutter_l or "0px"  
    gr = gutter_r or "0px"  
    if justify not in BOX_JUSTIFY_OPTS:  
        justify = "center"  
    for sel in selectors:  
        html = ensure_selector_rule(html, sel)  
        html = set_css(html, sel, "--she-gutter-l", gl)  
        html = set_css(html, sel, "--she-gutter-r", gr)  
        html = set_css(html, sel, "--she-justify", justify)  
        if justify == "left":  
            html = set_css(html, sel, "margin-left", gl)  
            html = set_css(html, sel, "margin-right", "auto")  
        elif justify == "right":  
            html = set_css(html, sel, "margin-left", "auto")  
            html = set_css(html, sel, "margin-right", gr)  
        else:  
            html = set_css(html, sel, "margin-left", "auto")  
            html = set_css(html, sel, "margin-right", "auto")  
        html = sync_gutter_max_width(html, sel)  
    return html  
