def _select(id_, options, current):  
    seen_current = current in options  
    if current and not seen_current:  
        options = [current] + list(options)  
    opts = []  
    for o in options:  
        sel = ' selected' if o == current else ''  
        label = o if o != "" else "(inherit)"  
        opts.append('<option value="' + esc(o) + '"' + sel + '>' + esc(label) + '</option>')  
    return '<select class="she-in she-fontsel" id="' + id_ + '">' + "".join(opts) + '</select>'  

def _font_rows(key, sel, html, fam_opts):  
    fam   = get_css(html, sel, "font-family")  
    wt    = get_css(html, sel, "font-weight")  
    fsz   = get_css(html, sel, "font-size")  
    ls    = get_css(html, sel, "letter-spacing")  
    lh    = get_css(html, sel, "line-height")  
    style = get_css(html, sel, "font-style")  

    if fsz:  
        sz_n, sz_u = split_num_unit(fsz)  
        if not re.search(r'(px|%|em|rem|vw|vh)\s*$', fsz.strip(), re.I):  
            sz_u = "em"  
    else:  
        sz_n, sz_u = "", "em"  
    if ls:  
        ls_n, ls_u = split_num_unit(ls)  
        if not re.search(r'(px|%|em|rem|vw|vh)\s*$', ls.strip(), re.I):  
            ls_u = "em"  
    else:  
        ls_n, ls_u = "", "em"  
    lh_n, _ = split_num_unit(lh) if lh else ("", "")  

    italic_checked = ' checked' if (style or "").strip().lower() == "italic" else ''  
    bold_checked   = ' checked' if (wt or "").strip().lower() in ("bold", "700") else ''  

    return (  
      '  <div class="she-fontrow"><span class="she-fontlab">Font</span>'  
      + _select("font_" + key + "_family", fam_opts, fam) + '</div>'  
      '  <div class="she-fontrow"><span class="she-fontlab">Weight</span>'  
      + _select("font_" + key + "_weight", FONT_WEIGHTS, wt) + '</div>'  
      '  <div class="she-fontrow"><span class="she-fontlab">Font size</span>'  
      '    <span class="she-numwrap">'  
      '      <input class="she-in she-num" id="font_' + key + '_size" type="text" inputmode="decimal" value="' + esc(sz_n) + '"/>'  
      '      <span class="she-unit-toggle" id="unit_font_' + key + '_size" data-unit="' + esc(sz_u) + '" data-units="em,px,rem">' + esc(sz_u) + '</span>'  
      '    </span></div>'  
      '  <div class="she-fontrow"><span class="she-fontlab">Letter spacing</span>'  
      '    <span class="she-numwrap">'  
      '      <input class="she-in she-num" id="font_' + key + '_spacing" type="text" inputmode="decimal" value="' + esc(ls_n) + '"/>'  
      '      <span class="she-unit-toggle" id="unit_font_' + key + '_spacing" data-unit="' + esc(ls_u) + '" data-units="em,px">' + esc(ls_u) + '</span>'  
      '    </span></div>'  
      '  <div class="she-fontrow"><span class="she-fontlab">Line height</span>'  
      '    <input class="she-in she-num" id="font_' + key + '_lineheight" type="text" inputmode="decimal" value="' + esc(lh_n) + '"/></div>'  
      '  <div class="she-fontrow">'  
      '    <label class="she-check"><input type="checkbox" id="font_' + key + '_bold"' + bold_checked + '/> Bold</label>'  
      '    <label class="she-check"><input type="checkbox" id="font_' + key + '_italic"' + italic_checked + '/> Italic</label>'  
      '  </div>')  

def render_font(key, sel, html, fam_opts):  
    return '<div class="she-fontctl" data-key="' + key + '">' + _font_rows(key, sel, html, fam_opts) + '</div>'  

def is_clear_color(val):  
    """True for blank / transparent / none / fully-clear color values (inherit)."""  
    v = (val or "").strip().lower()  
    if not v or v in ("transparent", "none"):  
        return True  
    if re.match(r'^rgba?\(\s*0\s*,\s*0\s*,\s*0\s*,\s*0\s*\)$', v):  
        return True  
    if re.match(r'^rgba?\(\s*0\s+0\s+0\s*/\s*0\s*\)$', v):  
        return True  
    return False  

# Backwards-compatible alias (older call sites / comments).  
is_none_color = is_clear_color  

def _clamp_alpha_pct(n):  
    try:  
        return max(0, min(100, int(round(float(n)))))  
    except Exception:  
        return 100  

def parse_css_color(val):  
    """Parse a CSS color into picker hex (#rrggbb), opacity 0–100, and flags.  

    Blank / transparent / none → empty display (inherit). Opacity slider is  
    disabled until a real color is chosen.  
    """  
    shown = (val or "").strip()  
    if is_clear_color(shown):  
        return {  
            "none": True,  
            "hex": "#000000",  
            "alpha": 100,  
            "alpha_on": False,  
            "display": "",  
        }  
    m = re.match(r'^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$', shown)  
    if m:  
        h = m.group(1)  
        if len(h) == 3:  
            h = "".join(ch * 2 for ch in h)  
        if len(h) == 8:  
            alpha = _clamp_alpha_pct(int(h[6:8], 16) * 100 / 255.0)  
            hex6 = "#" + h[:6].lower()  
            return {  
                "none": False,  
                "hex": hex6,  
                "alpha": alpha,  
                "alpha_on": alpha < 100,  
                "display": shown if alpha < 100 else hex6,  
            }  
        hex6 = "#" + h.lower()  
        return {  
            "none": False,  
            "hex": hex6,  
            "alpha": 100,  
            "alpha_on": False,  
            "display": hex6,  
        }  
    m = re.match(  
        r'^rgba?\(\s*([\d.]+)\s*,\s*([\d.]+)\s*,\s*([\d.]+)'  
        r'(?:\s*,\s*([\d.]+%?))?\s*\)$',  
        shown, re.I)  
    if not m:  
        m = re.match(  
            r'^rgba?\(\s*([\d.]+)\s+([\d.]+)\s+([\d.]+)'  
            r'(?:\s*/\s*([\d.]+%?))?\s*\)$',  
            shown, re.I)  
    if m:  
        r = max(0, min(255, int(round(float(m.group(1))))))  
        g = max(0, min(255, int(round(float(m.group(2))))))  
        b = max(0, min(255, int(round(float(m.group(3))))))  
        hex6 = "#%02x%02x%02x" % (r, g, b)  
        raw_a = m.group(4)  
        if raw_a is None or raw_a == "":  
            alpha = 100  
        elif str(raw_a).endswith("%"):  
            alpha = _clamp_alpha_pct(raw_a[:-1])  
        else:  
            alpha = _clamp_alpha_pct(float(raw_a) * 100.0)  
        return {  
            "none": False,  
            "hex": hex6,  
            "alpha": alpha,  
            "alpha_on": alpha < 100,  
            "display": shown if alpha < 100 else hex6,  
        }  
    # Named / unknown: keep text, opaque picker fallback.  
    return {  
        "none": False,  
        "hex": "#000000",  
        "alpha": 100,  
        "alpha_on": False,  
        "display": shown,  
    }  

