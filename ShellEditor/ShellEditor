def apply_posted_fields(html, fields):  
    """Apply posted editor values onto shell HTML (shared by save / save_as)."""  
    html = ensure_bg_media(html)  
    # Image src writes are re-applied after heals below — collect them here.  
    image_writes = []  
    for f in fields:  
        typ = f["type"]  
        if typ in ("heading", "bgpanel"):  
            continue  
        if typ == "box":  
            primary = f["loc"][1]  
            for kind in ("padding", "margin"):  
                for side in BOX_SIDES:  
                    # Side margins are gutters — applied with justify below.  
                    if kind == "margin" and side in ("left", "right"):  
                        continue  
                    dk = "box_" + f["key"] + "_" + kind + "_" + side  
                    if not model.DataHas(dk):  
                        continue  
                    raw = model.Dictionary(dk)  
                    sel, prop = box_css_target(f, kind, side)  
                    html = write_css_prop(html, sel, prop, raw)  
                    # Remapped cells (form bottom → footer, logo top margin  
                    # → footer padding-top): zero the primary so it does  
                    # not add a second gap / pull the footer apart.  
                    if sel != primary:  
                        orig_prop = kind + "-" + side  
                        if is_clear_value(raw):  
                            html = write_css_prop(html, primary, orig_prop, CLEAR_VALUE)  
                        else:  
                            html = set_css(html, primary, orig_prop, "0")  
            gl_k = "box_" + f["key"] + "_margin_left"  
            gr_k = "box_" + f["key"] + "_margin_right"  
            j_k = "box_" + f["key"] + "_justify"  
            gl = model.Dictionary(gl_k) if model.DataHas(gl_k) else ""  
            gr = model.Dictionary(gr_k) if model.DataHas(gr_k) else ""  
            # Side gutters default to 0 when cleared (align still needs a value).  
            if is_clear_value(gl):  
                gl = "0px"  
            if is_clear_value(gr):  
                gr = "0px"  
            justify = model.Dictionary(j_k) if model.DataHas(j_k) else ""  
            if justify not in BOX_JUSTIFY_OPTS:  
                justify = read_box_justify(html, primary)  
            html = apply_box_align(  
                html, box_align_selectors(f), justify, gl, gr)  
        elif typ == "font":  
            sel = f["loc"][1]  
            html = ensure_selector_rule(html, sel)  
            html = apply_font(html, sel, f["key"])  
        elif typ == "textstyle":  
            loc = f["loc"]  
            sel = loc[1]  
            colorprop = loc[2] if len(loc) > 2 else "color"  
            fk = f["key"]  
            # textstyle has no companion color field that creates the rule —  
            # ensure first or set_css silently no-ops (e.g. footer link).  
            html = ensure_selector_rule(html, sel)  
            if model.DataHas(fk):  
                html = write_css_prop(html, sel, colorprop, model.Dictionary(fk))  
            html = apply_font(html, sel, fk)  
        elif typ == "btnstyle":  
            html = apply_btnstyle(html, f)  
        elif typ == "formborder":  
            html = apply_formborder(html, f)  
        elif typ == "image":  
            if model.DataHas(f["key"]):  
                image_writes.append((f, model.Dictionary(f["key"])))  
                html = write_field(html, f, image_writes[-1][1])  
        else:  
            if model.DataHas(f["key"]):  
                val = model.Dictionary(f["key"])  
                html = write_field(html, f, val)  
    if SHELL_KIND == "giving":  
        html = heal_giving_signin_icon(html)  
    # Beat injected form CSS by marking every shell declaration !important.  
    html = ensure_all_css_important(html)  
    # Logo <img> tags must win over any heal that rebuilt nearby markup.  
    for f, val in image_writes:  
        html = write_field(html, f, val)  
    # Keep format version stamped after save-time heals.  
    if get_shell_version(html) < SHELL_FORMAT_VERSION:  
        html = set_shell_version_marker(html, SHELL_KIND, SHELL_FORMAT_VERSION)  
    elif get_shell_version(html) == 0:  
        html = set_shell_version_marker(html, SHELL_KIND, SHELL_FORMAT_VERSION)  
    return html  
  
