def _parse_border_shorthand(border):  
    """Pull width/color/style out of a CSS border shorthand value."""  
    width, color, style = "", "", ""  
    if not border:  
        return width, color, style  
    for part in str(border).split():  
        pl = part.lower()  
        if re.match(r'^-?[\d.]+(px|em|rem|%)?$', pl):  
            if not width:  
                width = part if re.search(r'[a-z%]', pl) else part + "px"  
        elif pl in ("solid", "dashed", "dotted", "none", "double", "groove",  
                    "ridge", "inset", "outset", "hidden"):  
            if not style:  
                style = pl  
        elif (pl.startswith("#") or pl.startswith("rgb") or pl.startswith("hsl")  
              or pl == "transparent"):  
            if not color:  
                color = part  
    return width, color, style  

def read_border_parts(html, sel):  
    width = get_css(html, sel, "border-width")  
    color = get_css(html, sel, "border-color")  
    style = get_css(html, sel, "border-style")  
    if not width or not color or not style:  
        sw, sc, ss = _parse_border_shorthand(get_css(html, sel, "border"))  
        if not width:  
            width = sw  
        if not color:  
            color = sc  
        if not style:  
            style = ss  
    return width or "", color or "", style or ""  

