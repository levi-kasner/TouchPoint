def installer_url(focus=""):  
    url = "/PyScriptForm/" + INSTALLER_SCRIPT  
    if focus:  
        url += "?focus=" + focus  
    return url  

def parse_version_tuple(ver):  
    parts = []  
    for p in re.split(r"[^\d]+", str(ver or "").strip()):  
        if p.isdigit():  
            parts.append(int(p))  
    return tuple(parts or [0])  
  
def fetch_update_manifest():  
    """Return remote manifest dict, or None when unset/unreachable."""  
    url = (UPDATE_MANIFEST_URL or "").strip()  
    if not url:  
        return None  
    try:  
        raw = model.RestGet(url, {})  
        data = json.loads(raw)  
        return data if isinstance(data, dict) else None  
    except Exception:  
        return None  
  
def check_editor_update():  
    """If a newer editorVersion is published, return the manifest; else None."""  
    data = fetch_update_manifest()  
    if not data:  
        return None  
    remote = str(data.get("editorVersion") or "").strip()  
    if not remote:  
        return None  
    if parse_version_tuple(remote) > parse_version_tuple(EDITOR_VERSION):  
        return data  
    return None  

def parse_installer_payloads(installer_text):  
    """Parse PAYLOADS from a ShellEditorInstaller script body."""  
    begin = "# ==== BEGIN EMBEDDED PAYLOADS (generated; do not edit) ===="  
    end = "# ==== END EMBEDDED PAYLOADS ===="  
    text = installer_text or ""  
    i = text.find(begin)  
    j = text.find(end)  
    if i < 0 or j < 0 or j <= i:  
        raise ValueError("Installer payloads not found")  
    block = text[i + len(begin):j]  
    payloads = {}  
    for m in re.finditer(  
        r"'([A-Za-z][A-Za-z0-9_]*)'\s*:\s*\{\s*"  
        r"'kind'\s*:\s*'([^']+)'\s*,\s*"  
        r"'data'\s*:\s*\((.*?)\)\s*,?\s*\}",  
        block,  
        re.S,  
    ):  
        name, kind, data_part = m.group(1), m.group(2), m.group(3)  
        chunks = re.findall(r"'([^']*)'", data_part)  
        payloads[name] = {"kind": kind, "data": "".join(chunks)}  
    if "ShellEditor" not in payloads:  
        raise ValueError("Installer is missing the ShellEditor payload")  
    return payloads  

def decode_package_payload(entry):  
    raw = (entry or {}).get("data") or ""  
    return zlib.decompress(base64.b64decode(raw.encode("ascii")))  

def python_content_exists(name):  
    try:  
        return bool(model.PythonContent(name))  
    except Exception:  
        return False  

def apply_editor_update_from_github():  
    """Fetch latest installer from GitHub and apply the embedded ShellEditor package.

    Always refreshes ShellEditor + ShellEditorInstaller. Creates missing HTML
    templates only (never overwrites existing HTML Special Content).
    """  
    manifest = fetch_update_manifest()  
    if not manifest:  
        return False, "Could not download the update manifest."  
    remote = str(manifest.get("editorVersion") or "").strip()  
    if remote and parse_version_tuple(remote) <= parse_version_tuple(EDITOR_VERSION):  
        return False, "Already on the latest version (v" + EDITOR_VERSION + ")."  
    installer_url = str(manifest.get("installerScript") or "").strip()  
    if not installer_url:  
        return False, "Update manifest is missing installerScript."  
    try:  
        installer_text = model.RestGet(installer_url, {})  
    except Exception as e:  
        return False, "Could not download installer: " + str(e)  
    if not installer_text or "PAYLOADS" not in installer_text:  
        return False, "Downloaded installer looks invalid."  
    try:  
        payloads = parse_installer_payloads(installer_text)  
    except Exception as e:  
        return False, "Could not read installer package: " + str(e)  

    # Keep the Special Content installer in sync for optional module setup.  
    try:  
        model.WriteContentPython(INSTALLER_SCRIPT, installer_text)  
    except Exception as e:  
        return False, "Could not update ShellEditorInstaller: " + str(e)  

    kind_map = {  
        "ShellLoginTemplate": "login",  
        "ShellGivingTemplate": "giving",  
        "ShellRegistrationTemplate": "registration",  
        "ShellGivingWorkingCopy": "giving",  
    }  
    results = []  
    for name, entry in payloads.items():  
        kind = entry.get("kind") or "html"  
        try:  
            data = decode_package_payload(entry)  
            text = data.decode("utf-8")  
        except Exception as e:  
            return False, "Could not decode " + name + ": " + str(e)  
        if kind == "python" or name == SCRIPT_NAME:  
            try:  
                existed = python_content_exists(name)  
                model.WriteContentPython(name, text)  
                results.append(name + (": updated" if existed else ": created"))  
            except Exception as e:  
                return False, "Could not write " + name + ": " + str(e)  
            continue  
        # HTML templates / working copy: create only when missing.  
        if content_exists(name) or python_content_exists(name):  
            results.append(name + ": skipped")  
            continue  
        shell_kind = kind_map.get(name, "registration")  
        try:  
            write_shell_file(name, text, shell_kind)  
            results.append(name + ": created")  
        except Exception as e:  
            return False, "Could not create " + name + ": " + str(e)  
    msg = "Updated to v" + (remote or "?")  
    if results:  
        msg += " (" + "; ".join(results) + ")"  
    return True, msg  
  
