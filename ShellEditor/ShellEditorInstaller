            var o=document.createElement('option');
            o.value=p.url||'';
            o.textContent=(p.name||p.url||'')+' — /Give/'+(p.url||'');
            give.appendChild(o);
          });
          if(cur) give.value=cur;
        })["catch"](function(){});
    }
    give.addEventListener('focus', refreshGiving);
    give.addEventListener('click', refreshGiving);
  }
})();
