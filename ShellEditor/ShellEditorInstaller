      Array.prototype.forEach.call(sel.options, function(opt, idx){
        if(idx===0){ opt.hidden=true; return; }
        var label=opt.getAttribute('data-label')||(opt.textContent||'').toLowerCase();
        opt.hidden = q && label.indexOf(q)<0;
      });
    }
    function expandRegList(){
      sel.classList.remove('is-collapsed');
      if(picked) picked.classList.remove('on');
    }
    function collapseRegList(opt){
      if(!opt || !opt.value) return;
      hid.value=opt.value;
      search.value=opt.textContent||'';
      sel.classList.add('is-collapsed');
      if(picked){
        picked.textContent='Selected: '+opt.textContent;
        picked.classList.add('on');
      }
    }
    function fillRegOptions(rows){
      var cur=hid.value||'';
      sel.innerHTML='';
