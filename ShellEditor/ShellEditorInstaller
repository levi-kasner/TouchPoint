def action_configure_menu(add_it, column_choice="", header_choice="", new_header_name=""):
    xml = read_menu_xml()
    in_menu = menu_has_editor(xml)
    if not add_it:
        # Skipping only marks complete when a link already exists; otherwise record skip.
        set_flag(CFG_MENU_INSTALLED, True if in_menu else False)
        if in_menu:
            return True, "Kept the current menu location."
        return True, "Menu entry skipped."
    updated, changed, msg = add_menu_entry(
        xml, column_choice, header_choice, new_header_name
    )
    if not changed:
        return False, msg
    write_menu_xml(updated)
    set_flag(CFG_MENU_INSTALLED, True)
    return True, msg

def action_uninstall(remove_templates):
    """Clear menu/settings; return Special Content targets for browser delete.

    Returns (ok, msg, meta) where meta includes:
      delete_targets — files for the browser to DELETE via /api/v1
      unassign_reg — optional {orgId, shellName} to clear before template delete
    """
    if not is_developer():
        return False, "Uninstall requires the Developer role.", {}
    # Capture before clearing settings — needed to unassign the live reg shell.
    inv = get_setting(CFG_INVOLVEMENT_ID)
    unassign_reg = None
    if remove_templates and inv.isdigit() and int(inv) > 0:
        unassign_reg = {"orgId": int(inv), "shellName": REG_TEMPLATE}
    # 1) Admin reports menu
    try:
        ok_menu, menu_msg = remove_editor_from_admin_menu()
        if not ok_menu:
            return False, menu_msg, {}
    except Exception as e:
        return False, "Could not update the Admin reports menu: " + str(e), {}
    # 2) Settings + people ExtraValues (ShellEdit%)
    clear_shell_editor_settings()
    try:
        model.DeleteAllExtraValueLike("ShellEdit%")
    except Exception:
        pass
    targets = uninstall_content_targets(remove_templates)
    msg = "Shell Editor settings and menu link removed."
    if not remove_templates:
        msg += " Template files will be left in place."
    meta = {"delete_targets": targets}
    if unassign_reg:
        meta["unassign_reg"] = unassign_reg
    if remove_templates:
        # Client must clear live shell assignments before DELETE (API returns 400 otherwise).
        meta["clear_reg_shell_name"] = REG_TEMPLATE
        meta["unassign_reg_org_ids"] = orgs_using_reg_shell(REG_TEMPLATE)
    return True, msg, meta

