                +'Shell could not be assigned automatically: '
                +((err&&err.message)||err);
              data.notice_kind='warn';
            });
        }
        return chain.then(function(){
          goStep(data.step||'welcome', data.notice||'', data.notice_kind||'info');
        });
      })
      .catch(function(err){
        Array.prototype.forEach.call(btns, function(b){ b.disabled=false; });
