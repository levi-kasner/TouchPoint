        if(hdrVal==='new'){
          var nm=document.getElementById('sei-menu-new-name');
          if(!nm || !String(nm.value||'').trim()){
            alert('Enter a name for the new section.');
            return;
          }
        }
      }
    }
    var body=new FormData(form);
    var submitter=ev.submitter;
    if(submitter && submitter.name){
      body.set(submitter.name, submitter.value||'');
    }
    var btns=form.querySelectorAll('button[type="submit"],input[type="submit"]');
    Array.prototype.forEach.call(btns, function(b){ b.disabled=true; });
    fetch(window.location.pathname, {method:'POST', body:body, credentials:'same-origin'})
      .then(function(r){ return r.text(); })
      .then(function(txt){
        var data=parseSeiJson(txt);
        if(!data){
          throw new Error('Unexpected installer response');
        }
        if(data.ok===false){
          goStep(data.step||'welcome', data.notice||'Request failed', data.notice_kind||'err');
          return;
        }
        var chain=Promise.resolve();
        if(data.assign_shell && data.assign_shell.orgId && data.assign_shell.shellName){
          chain=assignRegShell(data.assign_shell.orgId, data.assign_shell.shellName)
            .catch(function(err){
              data.notice=(data.notice?data.notice+' ':'')
                +'Shell could not be assigned automatically: '
                +((err&&err.message)||err);
              data.notice_kind='warn';
            });
        }
        // Templates still assigned in Organizations.RegSetting return HTTP 400 on delete.
        if(data.clear_reg_shell_name){
          chain=chain.then(function(){
            var ids=(data.unassign_reg_org_ids||[]).slice();
            if(data.unassign_reg && data.unassign_reg.orgId){
              ids.push(data.unassign_reg.orgId);
            }
            return clearRegShellAssignments(data.clear_reg_shell_name, ids);
          });
        }
        if(data.delete_targets && data.delete_targets.length){
          chain=chain.then(function(){
            return deleteSpecialContentTargets(data.delete_targets);
          }).then(function(results){
            var deleted=(results||[]).filter(function(r){ return String(r).indexOf(': deleted')>=0; });
            if(!deleted.length){
              throw new Error('No Special Content files were deleted.');
            }
            if(data.notice){
              data.notice=data.notice+' ('+deleted.join('; ')+')';
            }
          }).catch(function(err){
            throw new Error('Special Content delete failed: '+((err&&err.message)||err));
          });
        }
        // After installer delete, paint Finish here (script can no longer be loaded).
        if(data.finish_after_delete){
          return chain.then(function(){
            showUninstallFinish(data.notice||'Installer removed.');
          });
        }
        return chain.then(function(){
          goStep(data.step||'welcome', data.notice||'', data.notice_kind||'info');
        });
      })
      .catch(function(err){
        Array.prototype.forEach.call(btns, function(b){ b.disabled=false; });
        alert('Installer request failed: '+((err&&err.message)||err));
      });
  });
  var search=document.getElementById('sei-reg-search');
