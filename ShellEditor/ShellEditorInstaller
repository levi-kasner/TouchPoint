        method:'GET',
        credentials:'same-origin',
        headers:{'Accept':'application/json'}
      }).then(function(r){
        if(!r.ok) throw new Error('Could not list Special Content ('+r.status+')');
        return r.json();
      }).then(function(payload){
        var files=asSpecialContentList(payload);
        return (targets||[]).map(function(t){
          if(t.id!=null && String(t.id)!=='') return t;
          var typeId=parseInt(t.typeId,10);
          var f=findSpecialContentFile(files, t.name, typeId);
          if(!f) return t;
          var copy={};
          for(var k in t){ if(Object.prototype.hasOwnProperty.call(t,k)) copy[k]=t[k]; }
          copy.id=fId(f);
          if(fTypeId(f)!=null) copy.typeId=fTypeId(f);
          return copy;
        });
      });
    }
    function deleteOne(t){
      var name=String(t.name||'');
      var id=t.id;
      if(id==null || String(id)===''){
        if(t.required) throw new Error('NOT FOUND: '+name+' (no content id)');
        return Promise.resolve(name+': not found');
      }
      var paths=[
        '/Display/ContentDelete/'+encodeURIComponent(id),
        '/Manage/Display/ContentDelete/'+encodeURIComponent(id)
      ];
      var attempt=function(url){
        return fetch(url,{
          method:'GET',
          credentials:'same-origin',
          redirect:'follow'
        }).then(function(r){
          // MVC action redirects to the Special Content index on success.
          if(r.ok || (r.status>=300 && r.status<400)) return name+': deleted';
          throw new Error('HTTP '+r.status);
        });
      };
      return attempt(paths[0]).catch(function(){
        return attempt(paths[1]);
      }).catch(function(err){
        throw new Error(
          'Could not delete '+name+' (id '+id+'): '
          +((err&&err.message)||err)
        );
      });
    }
    return resolveIds().then(function(list){
      var chain=Promise.resolve();
      var results=[];
      list.forEach(function(t){
        chain=chain.then(function(){
          return deleteOne(t).then(function(line){ results.push(line); });
        });
      });
      return chain.then(function(){ return results; });
    });
  }
  // PyScriptForm only paints model.Form on GET. Submit actions via AJAX, then navigate.
  document.addEventListener('submit', function(ev){
    var form=ev.target;
    if(!form || form.tagName!=='FORM' || !form.classList.contains('sei-form')) return;
    ev.preventDefault();
