        )) return;
      }
    }
    if(form.id==='sei-menu-form'){
      var addMenu=document.getElementById('sei-add-menu');
      if(addMenu && addMenu.checked){
        var col=document.getElementById('sei-menu-column');
        var hdr=document.getElementById('sei-menu-header');
