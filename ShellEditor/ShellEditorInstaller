    function refreshRegList(){
      var body=new FormData();
      body.append('action','list_reg_involvements');
      fetch(window.location.pathname, {method:'POST', body:body, credentials:'same-origin'})
        .then(function(r){ return r.text(); })
        .then(function(txt){
          var data=parseSeiJson(txt);
          if(!data || !data.involvements) return;
          fillRegOptions(data.involvements);
          filterRegList();
        })["catch"](function(){});
    }
    // Hide the placeholder option from the open list.
    if(sel.options.length) sel.options[0].hidden=true;
    search.addEventListener('focus', function(){
      refreshRegList();
      expandRegList();
      filterRegList();
    });
    search.addEventListener('click', function(){
      refreshRegList();
      expandRegList();
      filterRegList();
    });
    search.addEventListener('input', function(){
      hid.value='';
      expandRegList();
      filterRegList();
    });
    sel.addEventListener('change', function(){
      var opt=sel.options[sel.selectedIndex];
      collapseRegList(opt);
    });
    sel.addEventListener('click', function(){
      var opt=sel.options[sel.selectedIndex];
      if(opt && opt.value) collapseRegList(opt);
    });
  }
  var addMenu=document.getElementById('sei-add-menu');
  var menuOpts=document.getElementById('sei-menu-opts');
