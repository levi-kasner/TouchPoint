# ========================= HELPERS =========================
def esc(s):
    if s is None:
        return ""
    s = str(s)
    return (s.replace("&", "&amp;").replace("<", "&lt;")
             .replace(">", "&gt;").replace('"', "&quot;"))

def get_setting(key):
    try:
        return str(model.GetSetting(key) or "").strip()
    except Exception:
        try:
            return str(model.Setting(key) or "").strip()
        except Exception:
            return ""

def set_setting(key, value):
    model.SetSetting(key, value)

def flag_on(key):
    return get_setting(key).lower() in ("1", "true", "yes", "on")

def set_flag(key, on):
    set_setting(key, "1" if on else "0")

def html_exists(name):
    try:
        return bool(model.HtmlContent(name))
    except Exception:
        return False

def python_exists(name):
    try:
        return bool(model.PythonContent(name))
    except Exception:
        return False

def content_exists_any(name):
    return html_exists(name) or python_exists(name)

def decode_payload(entry):
    raw = entry.get("data") or ""
    if isinstance(raw, (list, tuple)):
        raw = "".join(raw)
    return zlib.decompress(base64.b64decode(raw.encode("ascii")))

SHELL_FORMAT_VERSION = 1

def kind_marker_block(kind):
    return (
        "<!-- SHELL-EDITOR-KIND:" + kind + "\n"
        "     =====================================================================\n"
        "     DO NOT REMOVE OR EDIT THIS COMMENT.\n"
        "     The Shell Editor identifies this Special Content as a shell\n"
        "     using this marker at the top of the file.\n"
        "     Content Keyword must be exactly: Shell\n"
        "     =====================================================================\n"
        "-->\n"
    )

def shell_version_marker(version):
    return "<!-- SHELL-EDITOR-SHELL-VERSION:" + str(int(version)) + " -->\n"

def strip_shell_meta(html):
    """Remove leading kind + shell-version markers."""
    s = (html or "").lstrip("\ufeff").lstrip()
    s = re.sub(
        r'^<!--\s*SHELL-EDITOR-KIND:(?:registration|giving|login)\b.*?-->\s*',
        "",
        s, count=1, flags=re.I | re.S,
    )
    s = re.sub(
        r'^<!--\s*SHELL-EDITOR-SHELL-VERSION:\s*\d+\s*-->\s*',
        "",
        s, count=1, flags=re.I,
    )
    return s

def ensure_kind_marker(html, kind):
    """Guarantee kind marker first; preserve/re-stamp shell version."""
    ver_m = re.search(
        r'<!--\s*SHELL-EDITOR-SHELL-VERSION:\s*(\d+)\s*-->',
        html or "",
        re.I,
    )
    ver = int(ver_m.group(1)) if ver_m else SHELL_FORMAT_VERSION
    body = strip_shell_meta(html).lstrip()
    return kind_marker_block(kind) + shell_version_marker(ver) + body

def write_html_shell(name, html, kind):
    model.WriteContentHtml(name, ensure_kind_marker(html, kind), SHELL_KEYWORD)

def patch_editor_involvement_id(org_id):
    """Write the preview involvement id into the installed ShellEditor script."""
    try:
        org_id = int(org_id)
    except Exception:
        return False
    if org_id <= 0:
        return False
    try:
        text = model.PythonContent(EDITOR_NAME) or ""
    except Exception:
        text = ""
    if not text:
        return False
    new_text, n = re.subn(
        r"(?m)^(INVOLVEMENT_ID\s*=\s*)\d+",
        r"\g<1>" + str(org_id),
        text,
        count=1,
    )
    if not n or new_text == text:
        return False
    model.WriteContentPython(EDITOR_NAME, new_text)
    return True

def install_payload(name):
    """Install embedded payload.

    The ShellEditor Python script is always written (create or update).
    HTML templates / working copy are created only when missing — never overwritten.
    """
    entry = PAYLOADS.get(name)
    if not entry:
        return "missing_payload"
    kind = entry.get("kind") or "html"
    # Always refresh the editor script so re-running the installer upgrades it.
    if kind == "python":
        data = decode_payload(entry)
        text = data.decode("utf-8")
        existed = python_exists(name)
        model.WriteContentPython(name, text)
        return "updated" if existed else "created"
    if content_exists_any(name):
        return "skipped"
    data = decode_payload(entry)
    text = data.decode("utf-8")
    if kind == "html_copy_from":
        # Working copy shares template bytes; still tagged as giving.
        write_html_shell(name, text, "giving")
        return "created"
    # Map template names to kind markers.
    kind_map = {
        LOGIN_TEMPLATE: "login",
        GIVING_TEMPLATE: "giving",
        REG_TEMPLATE: "registration",
        GIVING_WORKING_COPY: "giving",
    }
    write_html_shell(name, text, kind_map.get(name, "registration"))
    return "created"

def list_giving_pages():
    sql = """
SELECT gp.PageName, gp.PageUrl
FROM dbo.GivingPages gp
JOIN dbo.Content c ON c.Id = gp.SkinFileId
WHERE gp.Enabled = 1
  AND c.Name = 'ShellGivingWorkingCopy'
ORDER BY gp.PageName
"""
    rows = []
    try:
        for row in q.QuerySql(sql):
            rows.append({
                "name": str(getattr(row, "PageName", "") or ""),
                "url": str(getattr(row, "PageUrl", "") or ""),
            })
    except Exception:
        rows = []
    return rows

def list_reg_involvements():
    sql = """
SELECT o.OrganizationId,
       o.OrganizationName,
       o.RegStart,
       o.RegEnd
FROM dbo.Organizations o
WHERE o.RegistrationTypeId = 26
  AND ISNULL(o.RegistrationClosed, 0) = 0
  AND (o.RegStart IS NULL OR o.RegStart <= GETDATE())
  AND (o.RegEnd   IS NULL OR o.RegEnd   >= GETDATE())
ORDER BY o.OrganizationName
"""
    rows = []
    try:
        for row in q.QuerySql(sql):
            rows.append({
                "id": int(getattr(row, "OrganizationId", 0) or 0),
                "name": str(getattr(row, "OrganizationName", "") or ""),
                "start": str(getattr(row, "RegStart", "") or ""),
                "end": str(getattr(row, "RegEnd", "") or ""),
            })
    except Exception:
        rows = []
    return rows

def registration_settings_url(orgid):
    host = str(getattr(model, "CmsHost", "") or "").rstrip("/")
    return host + "/api/v1/Involvements/" + str(int(orgid)) + "/Registrations/Settings"

def set_org_reg_shell(orgid, shell_name):
    """Pin a registration shell using the same Settings API the editor uses."""
    orgid = int(orgid)
    shell_name = (shell_name or "").strip()
    if orgid <= 0 or not shell_name:
        raise Exception("Missing involvement id or shell name.")
    url = registration_settings_url(orgid)
    headers = {"Accept": "application/json", "Content-Type": "application/json"}
    raw = model.RestGet(url, headers)
    settings = json.loads(raw or "{}")
    if not isinstance(settings, dict):
        raise Exception("Registration settings response was invalid.")
    if str(settings.get("regShellId") or "").strip() == shell_name:
        return
    settings["regShellId"] = shell_name
    model.RestPostJson(url, headers, settings)

def menu_has_editor(xml):
    """True when Shell Editor is currently linked in the admin reports menu XML."""
    return bool(re.search(r"ShellEditor", xml or "", re.I))

def menu_editor_present():
    """Live menu check (not the installer flag — the link can be removed later)."""
    return menu_has_editor(read_menu_xml())

def sync_menu_installed_flag():
    """Clear a stale installed flag when the live menu link was removed."""
    present = menu_editor_present()
    if (not present) and get_setting(CFG_MENU_INSTALLED) == "1":
        set_setting(CFG_MENU_INSTALLED, "")
    return present

def menu_report_entry():
    return (
        '<Report link="' + MENU_LINK + '" roles="' + MENU_ROLES + '">'
        + MENU_LABEL + "</Report>"
    )

def _strip_xml_text(s):
    s = re.sub(r"<[^>]+>", "", s or "")
    return re.sub(r"\s+", " ", s).strip()

def find_menu_column(xml, num):
    """Return regex match for <ColumnN>...</ColumnN>, or None."""
    tag = "Column" + str(int(num))
    return re.search(
        r"<" + tag + r"\b([^>]*)>(.*?)</" + tag + r">",
        xml or "",
        re.I | re.S,
    )

def list_menu_columns(xml):
    """Return [{num, label, headers:[{index,name}]}] for Column1..Column4 present."""
    cols = []
    for num in range(1, MENU_MAX_COLUMNS + 1):
        m = find_menu_column(xml, num)
        if not m:
            continue
        body = m.group(2) or ""
        headers = []
        for i, h in enumerate(
            re.findall(r"<Header\b[^>]*>(.*?)</Header>", body, re.I | re.S)
        ):
            name = _strip_xml_text(h)
            if name:
                headers.append({"index": i, "name": name})
        label = headers[0]["name"] if headers else ("Column " + str(num))
        cols.append({"num": num, "label": label, "headers": headers})
    return cols

def next_menu_column_num(xml):
    """Lowest free ColumnN slot (1-4), or None when all four are used."""
    used = set()
    for num in range(1, MENU_MAX_COLUMNS + 1):
        if find_menu_column(xml, num):
            used.add(num)
    for num in range(1, MENU_MAX_COLUMNS + 1):
        if num not in used:
            return num
    return None

def valid_menu_column_name(name):
    return bool(name and MENU_COLUMN_NAME_RE.match(name.strip()))

def _replace_menu_column(xml, num, col_attrs, new_body):
    m = find_menu_column(xml, num)
    if not m:
        return None
    tag = "Column" + str(int(num))
    return (
        xml[: m.start()]
        + "<" + tag + (col_attrs or "") + ">"
        + new_body
        + "</" + tag + ">"
        + xml[m.end() :]
    )

def _cleanup_empty_header_sections(col_body):
    """Drop headers that no longer have any Report entries beneath them."""
    col_body = col_body or ""
    headers = list(
        re.finditer(r"<Header\b[^>]*>.*?</Header>\s*", col_body, re.I | re.S)
    )
    if not headers:
        return col_body
    parts = [col_body[: headers[0].start()]]
    for i, hm in enumerate(headers):
        start = hm.end()
        end = headers[i + 1].start() if i + 1 < len(headers) else len(col_body)
        section = col_body[start:end]
        if re.search(r"<Report\b", section, re.I):
            parts.append(hm.group(0))
            parts.append(section)
    return "".join(parts)

def remove_menu_editor_reports(xml):
    """Remove every Shell Editor <Report> node (keeps headers so indexes stay stable)."""
    xml = xml or ""

    def report_repl(m):
        return "" if re.search(r"ShellEditor", m.group(0), re.I) else m.group(0)

    return re.sub(
        r"<Report\b[^>]*>.*?</Report>",
        report_repl,
        xml,
        flags=re.I | re.S,
    )

def cleanup_menu_empty_headers(xml):
    """Remove headers that have no Report entries left beneath them."""
    xml = xml or ""
    for num in range(1, MENU_MAX_COLUMNS + 1):
        m = find_menu_column(xml, num)
        if not m:
            continue
        body = _cleanup_empty_header_sections(m.group(2) or "")
        replaced = _replace_menu_column(xml, num, m.group(1) or "", body)
        if replaced is not None:
            xml = replaced
    return xml

def _insert_report_under_header(col_body, header_index, entry):
    headers = list(
        re.finditer(r"<Header\b[^>]*>.*?</Header>\s*", col_body or "", re.I | re.S)
    )
    if header_index < 0 or header_index >= len(headers):
        return None, "That menu section is no longer available. Refresh and try again."
    start = headers[header_index].end()
    end = (
        headers[header_index + 1].start()
        if header_index + 1 < len(headers)
        else len(col_body)
    )
    section = col_body[start:end]
    new_section = section.rstrip() + "\n    " + entry + "\n  "
    return col_body[:start] + new_section + col_body[end:], None

def _append_column_block(xml, num, name, entry):
    """Create <ColumnN> with an Admin-only section header + Shell Editor report."""
    tag = "Column" + str(int(num))
    block = (
        "  <" + tag + ">\n"
        '    <Header roles="' + MENU_NEW_HEADER_ROLES + '">'
        + esc(name) + "</Header>\n"
        "    " + entry + "\n"
        "  </" + tag + ">\n"
    )
    m = re.search(r"</ReportsMenu>", xml or "", flags=re.I)
    if m:
        return xml[: m.start()] + block + xml[m.start() :]
    if re.search(r"<ReportsMenu\b", xml or "", re.I):
        return (xml or "").rstrip() + "\n" + block
    return (
        '<?xml version="1.0" encoding="utf-8" ?>\n'
        "<ReportsMenu>\n"
        + block
        + "</ReportsMenu>\n"
    )

def add_menu_entry(xml, column_choice, header_choice="", new_header_name=""):
    """Place Shell Editor under one column/section (moving it if already present).

    column_choice: '1'..'4'
    header_choice: section index as string, or 'new'
    New sections use Header roles=\"Admin\".
    Returns (xml, changed, message).
    """
    xml = xml or ""
    was_present = menu_has_editor(xml)
    if was_present:
        # Remove old link first, but keep empty sections until after insert so
        # section indexes from the form still match.
        xml = remove_menu_editor_reports(xml)
    entry = menu_report_entry()
    col_choice = (column_choice or "").strip().lower()
    hdr_choice = (header_choice or "").strip().lower()
    name = (new_header_name or "").strip()
    verb = "Moved" if was_present else "Added"

    try:
        num = int(col_choice)
    except Exception:
        return xml, False, "Select a menu section."
    if num < 1 or num > MENU_MAX_COLUMNS:
        return xml, False, "Select a menu section."

    m = find_menu_column(xml, num)

    if hdr_choice == "new":
        if not valid_menu_column_name(name):
            return (
                xml,
                False,
                "Enter a section name using letters, numbers, spaces, or - _ . /",
            )
        if not m:
            updated = _append_column_block(xml, num, name, entry)
            updated = cleanup_menu_empty_headers(updated)
            return updated, True, verb + ' Shell Editor under new section "' + name + '".'
        col_attrs = m.group(1) or ""
        col_body = m.group(2) or ""
        new_body = (
            col_body.rstrip()
            + "\n    <Header roles=\"" + MENU_NEW_HEADER_ROLES + '">'
            + esc(name) + "</Header>\n"
            "    " + entry + "\n  "
        )
        updated = _replace_menu_column(xml, num, col_attrs, new_body)
        updated = cleanup_menu_empty_headers(updated)
        return updated, True, verb + ' Shell Editor under new section "' + name + '".'

    if not m:
        return xml, False, "That menu column is no longer available. Refresh and try again."

    col_attrs = m.group(1) or ""
    col_body = m.group(2) or ""

    try:
        header_index = int(hdr_choice)
    except Exception:
        return xml, False, "Select a menu section, or choose + Add Section."

    new_body, err = _insert_report_under_header(col_body, header_index, entry)
    if err:
        return xml, False, err
    updated = _replace_menu_column(xml, num, col_attrs, new_body)
    # Capture label before cleanup shifts section lists.
    cols = list_menu_columns(xml)
    section_label = "selected section"
    for c in cols:
        if c["num"] == num:
            for h in c["headers"]:
                if h["index"] == header_index:
                    section_label = h["name"]
                    break
            break
    updated = cleanup_menu_empty_headers(updated)
    return updated, True, verb + ' Shell Editor under "' + section_label + '".'

