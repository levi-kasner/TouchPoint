"""

# ========================= MAIN =========================
try:
    action = request_val("action").lower()
    method = http_method()

    # POST: mutate state and return JSON (AJAX). Full-page POSTs cannot use model.Form.
    if method == "post":
        if action == "list_giving_pages":
            emit_json({"pages": list_giving_pages()})
        elif action == "list_reg_involvements":
            emit_json({"involvements": list_reg_involvements()})
        else:
            notice = ""
            notice_kind = "info"
            next_step = "welcome"
            ok = True
            assign_shell = None
            delete_targets = None
            unassign_reg = None
            clear_reg_shell_name = None
            unassign_reg_org_ids = None
            finish_after_delete = False
            if action == "install_files":
                ok, msg = action_install_files()
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "registration" if ok else "files"
            elif action == "configure_registration":
                org_arg = request_val("preview_org_id") or request_val("template_org_id")
                ok, msg, new_id, needs_client_assign = action_configure_registration(org_arg)
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "giving" if ok else "registration"
                # Always ask the browser to pin the shell (same path as Shell Editor).
                # Server-side RestGet often lacks the interactive user session.
                if ok and new_id:
                    assign_shell = {
                        "orgId": int(new_id),
                        "shellName": REG_TEMPLATE,
                    }
                    if needs_client_assign:
                        notice = msg  # client will warn if assign fails
            elif action == "configure_giving":
                ok, msg = action_configure_giving(request_val("giving_page_url"))
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "login" if ok else "giving"
            elif action == "skip_giving":
                ok, msg = action_skip_giving()
                notice, notice_kind = msg, "info"
                next_step = "login"
            elif action == "configure_login":
                confirmed = request_val("login_confirm") in ("1", "true", "on", "yes")
                ok, msg = action_configure_login(confirmed)
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "menu" if ok else "login"
            elif action == "skip_login":
                ok, msg = action_skip_login()
                notice, notice_kind = msg, "info"
                next_step = "menu"
            elif action == "configure_menu":
                add_it = request_val("add_menu") in ("1", "true", "on", "yes")
                ok, msg = action_configure_menu(
                    add_it,
                    request_val("menu_column"),
                    request_val("menu_header"),
                    request_val("new_header_name"),
                )
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "done" if ok else "menu"
            elif action == "uninstall":
                remove_templates = request_val("remove_templates") in (
                    "1", "true", "on", "yes"
                )
                ok, msg, meta = action_uninstall(remove_templates)
                meta = meta or {}
                delete_targets = meta.get("delete_targets")
                unassign_reg = meta.get("unassign_reg")
                clear_reg_shell_name = meta.get("clear_reg_shell_name")
                unassign_reg_org_ids = meta.get("unassign_reg_org_ids")
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "uninstall_installer" if ok else "uninstall"
            elif action == "uninstall_installer":
                if not is_developer():
                    ok = False
                    notice, notice_kind = "Uninstall requires the Developer role.", "err"
                    next_step = "uninstall_installer"
                else:
                    ok = True
                    notice, notice_kind = "Installer removed.", "ok"
                    next_step = "uninstall_done"
                    delete_targets = [installer_delete_target()]
                    finish_after_delete = True
            elif action == "keep_installer":
                ok = True
                notice, notice_kind = "Installer kept.", "info"
                next_step = "uninstall_done"
            else:
                ok = False
                notice = "Unknown installer action."
                notice_kind = "err"
                next_step = resolve_step()
            payload = {
                "ok": bool(ok),
                "step": next_step,
                "notice": notice,
                "notice_kind": notice_kind,
            }
            if assign_shell:
                payload["assign_shell"] = assign_shell
            if unassign_reg:
                payload["unassign_reg"] = unassign_reg
            if clear_reg_shell_name:
                payload["clear_reg_shell_name"] = clear_reg_shell_name
            if unassign_reg_org_ids:
                payload["unassign_reg_org_ids"] = unassign_reg_org_ids
            if delete_targets:
                payload["delete_targets"] = delete_targets
            if finish_after_delete:
                payload["finish_after_delete"] = True
            emit_json(payload)
    else:
        # GET: render the wizard page.
        next_step = resolve_step()
        notice = request_val("notice") or None
        notice_kind = request_val("notice_kind") or "info"
        if notice_kind not in ("info", "ok", "warn", "err"):
            notice_kind = "info"
        model.Title = (
            "Shell Editor Uninstall"
            if next_step in UNINSTALL_STEPS
            else "Shell Editor Installer"
        )
        model.Header = ""
        model.Styles = STYLES
        model.Form = render_page(next_step, notice, notice_kind)
        model.Script = SCRIPT

except Exception:
    err = "<pre style='color:red'>" + traceback.format_exc() + "</pre>"
    if http_method() == "post":
        emit_json({"ok": False, "step": "welcome", "notice": traceback.format_exc(),
                   "notice_kind": "err"})
