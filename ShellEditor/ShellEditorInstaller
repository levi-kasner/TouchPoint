# ========================= MAIN =========================
try:
    action = request_val("action").lower()
    method = http_method()

    # POST: mutate state and return JSON (AJAX). Full-page POSTs cannot use model.Form.
    if method == "post":
        if action == "list_giving_pages":
            emit_json({"pages": list_giving_pages()})
        else:
            notice = ""
            notice_kind = "info"
            next_step = "welcome"
            ok = True
            assign_shell = None
            if action == "install_files":
                ok, msg = action_install_files()
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "registration" if ok else "files"
            elif action == "configure_registration":
                ok, msg, new_id, needs_client_assign = action_configure_registration(
                    request_val("template_org_id")
                )
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "giving" if ok else "registration"
                # Always ask the browser to pin the shell (same path as Shell Editor).
                # Server-side RestGet often lacks the interactive user session.
                if ok and new_id:
                    assign_shell = {
                        "orgId": int(new_id),
                        "shellName": REG_TEMPLATE,
                    }
                    if needs_client_assign:
                        notice = msg  # client will warn if assign fails
            elif action == "configure_giving":
                ok, msg = action_configure_giving(request_val("giving_page_url"))
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "login" if ok else "giving"
            elif action == "skip_giving":
                ok, msg = action_skip_giving()
                notice, notice_kind = msg, "info"
                next_step = "login"
            elif action == "configure_login":
                confirmed = request_val("login_confirm") in ("1", "true", "on", "yes")
                ok, msg = action_configure_login(confirmed)
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "menu" if ok else "login"
            elif action == "skip_login":
                ok, msg = action_skip_login()
                notice, notice_kind = msg, "info"
                next_step = "menu"
            elif action == "configure_menu":
                add_it = request_val("add_menu") in ("1", "true", "on", "yes")
                ok, msg = action_configure_menu(add_it)
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "done"
            else:
                ok = False
                notice = "Unknown installer action."
                notice_kind = "err"
                next_step = resolve_step()
            payload = {
                "ok": bool(ok),
                "step": next_step,
                "notice": notice,
                "notice_kind": notice_kind,
            }
            if assign_shell:
                payload["assign_shell"] = assign_shell
            emit_json(payload)
    else:
        # GET: render the wizard page.
        next_step = resolve_step()
        notice = request_val("notice") or None
        notice_kind = request_val("notice_kind") or "info"
        if notice_kind not in ("info", "ok", "warn", "err"):
            notice_kind = "info"
        model.Title = "Shell Editor Installer"
        model.Header = ""
        model.Styles = STYLES
        model.Form = render_page(next_step, notice, notice_kind)
        model.Script = SCRIPT

except Exception:
    err = "<pre style='color:red'>" + traceback.format_exc() + "</pre>"
    if http_method() == "post":
        emit_json({"ok": False, "step": "welcome", "notice": traceback.format_exc(),
                   "notice_kind": "err"})
    else:
        model.Form = err
