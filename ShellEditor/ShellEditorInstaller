# ========================= HELPERS =========================
def esc(s):
    if s is None:
        return ""
    s = str(s)
    return (s.replace("&", "&amp;").replace("<", "&lt;")
             .replace(">", "&gt;").replace('"', "&quot;"))

def get_setting(key):
    try:
        return str(model.GetSetting(key) or "").strip()
    except Exception:
        try:
            return str(model.Setting(key) or "").strip()
        except Exception:
            return ""

def set_setting(key, value):
    model.SetSetting(key, value)

def flag_on(key):
    return get_setting(key).lower() in ("1", "true", "yes", "on")

def set_flag(key, on):
    set_setting(key, "1" if on else "0")

def html_exists(name):
    try:
        return bool(model.HtmlContent(name))
    except Exception:
        return False

def python_exists(name):
    try:
        return bool(model.PythonContent(name))
    except Exception:
        return False

def content_exists_any(name):
    return html_exists(name) or python_exists(name)

def decode_payload(entry):
    raw = entry.get("data") or ""
    if isinstance(raw, (list, tuple)):
        raw = "".join(raw)
    return zlib.decompress(base64.b64decode(raw.encode("ascii")))

SHELL_FORMAT_VERSION = 1

def kind_marker_block(kind):
    return (
        "<!-- SHELL-EDITOR-KIND:" + kind + "\n"
        "     =====================================================================\n"
        "     DO NOT REMOVE OR EDIT THIS COMMENT.\n"
        "     The Shell Editor identifies this Special Content as a shell\n"
        "     using this marker at the top of the file.\n"
        "     Content Keyword must be exactly: Shell\n"
        "     =====================================================================\n"
        "-->\n"
    )

def shell_version_marker(version):
    return "<!-- SHELL-EDITOR-SHELL-VERSION:" + str(int(version)) + " -->\n"

def strip_shell_meta(html):
    """Remove leading kind + shell-version markers."""
    s = (html or "").lstrip("\ufeff").lstrip()
    s = re.sub(
        r'^<!--\s*SHELL-EDITOR-KIND:(?:registration|giving|login)\b.*?-->\s*',
        "",
        s, count=1, flags=re.I | re.S,
    )
    s = re.sub(
        r'^<!--\s*SHELL-EDITOR-SHELL-VERSION:\s*\d+\s*-->\s*',
        "",
        s, count=1, flags=re.I,
    )
    return s

def ensure_kind_marker(html, kind):
    """Guarantee kind marker first; preserve/re-stamp shell version."""
    ver_m = re.search(
        r'<!--\s*SHELL-EDITOR-SHELL-VERSION:\s*(\d+)\s*-->',
        html or "",
        re.I,
    )
    ver = int(ver_m.group(1)) if ver_m else SHELL_FORMAT_VERSION
    body = strip_shell_meta(html).lstrip()
    return kind_marker_block(kind) + shell_version_marker(ver) + body

def write_html_shell(name, html, kind):
    model.WriteContentHtml(name, ensure_kind_marker(html, kind), SHELL_KEYWORD)

def install_payload(name):
    """Install embedded payload.

    The ShellEditor Python script is always written (create or update).
    HTML templates / working copy are created only when missing — never overwritten.
    """
    entry = PAYLOADS.get(name)
    if not entry:
        return "missing_payload"
    kind = entry.get("kind") or "html"
    # Always refresh the editor script so re-running the installer upgrades it.
    if kind == "python":
        data = decode_payload(entry)
        text = data.decode("utf-8")
        existed = python_exists(name)
        model.WriteContentPython(name, text)
        return "updated" if existed else "created"
    if content_exists_any(name):
        return "skipped"
    data = decode_payload(entry)
    text = data.decode("utf-8")
    if kind == "html_copy_from":
        # Working copy shares template bytes; still tagged as giving.
        write_html_shell(name, text, "giving")
        return "created"
    # Map template names to kind markers.
    kind_map = {
        LOGIN_TEMPLATE: "login",
        GIVING_TEMPLATE: "giving",
        REG_TEMPLATE: "registration",
        GIVING_WORKING_COPY: "giving",
    }
    write_html_shell(name, text, kind_map.get(name, "registration"))
    return "created"

def list_giving_pages():
    sql = """
SELECT gp.PageName, gp.PageUrl
FROM dbo.GivingPages gp
JOIN dbo.Content c ON c.Id = gp.SkinFileId
WHERE gp.Enabled = 1
  AND c.Name = 'ShellGivingWorkingCopy'
ORDER BY gp.PageName
"""
    rows = []
    try:
        for row in q.QuerySql(sql):
            rows.append({
                "name": str(getattr(row, "PageName", "") or ""),
                "url": str(getattr(row, "PageUrl", "") or ""),
            })
    except Exception:
        rows = []
    return rows

def list_reg_involvements():
    sql = """
SELECT o.OrganizationId,
       o.OrganizationName,
       o.RegStart,
       o.RegEnd
FROM dbo.Organizations o
WHERE o.RegistrationTypeId = 26
  AND ISNULL(o.RegistrationClosed, 0) = 0
  AND (o.RegStart IS NULL OR o.RegStart <= GETDATE())
  AND (o.RegEnd   IS NULL OR o.RegEnd   >= GETDATE())
ORDER BY o.OrganizationName
"""
    rows = []
    try:
        for row in q.QuerySql(sql):
            rows.append({
                "id": int(getattr(row, "OrganizationId", 0) or 0),
                "name": str(getattr(row, "OrganizationName", "") or ""),
                "start": str(getattr(row, "RegStart", "") or ""),
                "end": str(getattr(row, "RegEnd", "") or ""),
            })
    except Exception:
        rows = []
    return rows

def registration_settings_url(orgid):
    host = str(getattr(model, "CmsHost", "") or "").rstrip("/")
    return host + "/api/v1/Involvements/" + str(int(orgid)) + "/Registrations/Settings"

def set_org_reg_shell(orgid, shell_name):
    """Pin a registration shell using the same Settings API the editor uses."""
    orgid = int(orgid)
    shell_name = (shell_name or "").strip()
    if orgid <= 0 or not shell_name:
        raise Exception("Missing involvement id or shell name.")
    url = registration_settings_url(orgid)
    headers = {"Accept": "application/json", "Content-Type": "application/json"}
    raw = model.RestGet(url, headers)
    settings = json.loads(raw or "{}")
    if not isinstance(settings, dict):
        raise Exception("Registration settings response was invalid.")
    if str(settings.get("regShellId") or "").strip() == shell_name:
        return
    settings["regShellId"] = shell_name
    model.RestPostJson(url, headers, settings)

def menu_has_editor(xml):
    return bool(re.search(r"ShellEditor", xml or "", re.I))

def add_menu_entry(xml):
    xml = xml or ""
    if menu_has_editor(xml):
        return xml, False
    entry = (
        '<Report link="' + MENU_LINK + '" roles="' + MENU_ROLES + '">'
        + MENU_LABEL + "</Report>"
    )
    # Prefer inserting under an existing Header named Custom / Tools / Reports.
    m = re.search(
        r"(<(?:Header)[^>]*>\s*(?:Custom|Tools|Reports)\s*</Header>\s*)",
        xml, flags=re.I,
    )
    if m:
        return xml[: m.end()] + "\n    " + entry + xml[m.end() :], True
    # Else before first column close.
    m = re.search(r"</Column>", xml, flags=re.I)
    if m:
        return xml[: m.start()] + "    " + entry + "\n  " + xml[m.start() :], True
    # Else before root close.
    m = re.search(r"</ReportsMenu>", xml, flags=re.I)
    if m:
        return (
            xml[: m.start()]
            + "  <Column>\n    <Header>Custom</Header>\n    "
            + entry + "\n  </Column>\n"
            + xml[m.start() :],
            True,
        )
    # Empty / unknown — create a minimal menu file.
    return (
        '<?xml version="1.0" encoding="utf-8" ?>\n'
        "<ReportsMenu>\n"
        "  <Column>\n"
        "    <Header>Custom</Header>\n"
        "    " + entry + "\n"
        "  </Column>\n"
        "</ReportsMenu>\n"
    ), True

def read_menu_xml():
    try:
        return model.Content(MENU_XML_NAME) or ""
    except Exception:
        try:
            return model.TextContent(MENU_XML_NAME) or ""
        except Exception:
            return ""

def write_menu_xml(xml):
    model.WriteContentText(MENU_XML_NAME, xml)

def request_val(key, default=""):
    if model.DataHas(key):
        return str(model.Dictionary(key) or "").strip()
    return default

def http_method():
    try:
        return str(model.HttpMethod or "get").lower()
    except Exception:
        return "get"

def emit_json(payload):
    """Return JSON for PyScriptForm AJAX POSTs (model.Form is GET-only)."""
    body = "<!--SEI_JSON-->" + json.dumps(payload) + "<!--/SEI_JSON-->"
    model.Header = ""
    model.Styles = ""
    model.Script = ""
    model.Form = body
    try:
        print(body)
    except Exception:
        pass

def resolve_step():
    focus = ""
    if model.DataHas("focus"):
        focus = str(model.Dictionary("focus") or "").strip().lower()
    if focus in STEPS:
        if focus == "giving" and not flag_on(CFG_REGISTRATION_INSTALLED):
            return "registration"
        if focus == "login" and not flag_on(CFG_REGISTRATION_INSTALLED):
            return "registration"
        return focus
    step = request_val("step")
    if step in STEPS:
        return step
    files_ready = flag_on(CFG_FILES_INSTALLED) or (
        python_exists(EDITOR_NAME) and html_exists(REG_TEMPLATE)
    )
    if not files_ready:
        return "welcome"
    if not flag_on(CFG_REGISTRATION_INSTALLED):
        return "registration"
    # Continue optional steps only until each has an explicit 1/0 setting.
    if get_setting(CFG_GIVING_INSTALLED) == "":
        return "giving"
    if get_setting(CFG_LOGIN_INSTALLED) == "":
        return "login"
    if get_setting(CFG_MENU_INSTALLED) == "" and not menu_has_editor(read_menu_xml()):
        return "menu"
    return "done"

# ========================= ACTIONS =========================
def action_install_files():
    if not PAYLOADS:
        return False, ("Installer payloads are empty. Run build_installer.py locally, "
                       "then re-upload ShellEditorInstaller.")
    order = [
        EDITOR_NAME,
        LOGIN_TEMPLATE,
        GIVING_TEMPLATE,
        REG_TEMPLATE,
        GIVING_WORKING_COPY,
    ]
    results = []
    for name in order:
        results.append(name + ": " + install_payload(name))
    set_flag(CFG_FILES_INSTALLED, True)
    return True, "; ".join(results)

def action_configure_registration(template_org_id):
    """Create preview involvement. Returns (ok, msg, new_id, needs_client_shell_assign)."""
    try:
        tid = int(template_org_id)
    except Exception:
        return False, "Select a registration involvement to copy settings from.", 0, False
    if tid <= 0:
        return False, "Select a registration involvement to copy settings from.", 0, False
    # Create preview involvement from template (copy settings).
    try:
        new_id = model.AddOrganization(PREVIEW_ORG_NAME, tid, True)
    except Exception as e:
        return False, "Could not create preview involvement: " + str(e), 0, False
    try:
        new_id = int(new_id)
    except Exception:
        return False, "AddOrganization did not return an involvement id.", 0, False
    if new_id <= 0:
        return False, "AddOrganization failed.", 0, False
    # Ensure registration template exists, then pin it on the new org.
    if not html_exists(REG_TEMPLATE):
        st, msg = action_install_files()
        if not st:
            return False, msg, new_id, False
    needs_client_assign = False
    try:
        set_org_reg_shell(new_id, REG_TEMPLATE)
    except Exception:
        # Browser session can set regShellId via the same API the editor uses.
        needs_client_assign = True
    set_setting(CFG_INVOLVEMENT_ID, str(new_id))
    set_flag(CFG_REGISTRATION_INSTALLED, True)
    return (
        True,
        "Created involvement #" + str(new_id) + " (" + PREVIEW_ORG_NAME + ").",
        new_id,
        needs_client_assign,
    )

def action_configure_giving(page_url):
    page_url = (page_url or "").strip()
    if not page_url:
        return False, "Select a giving page that uses ShellGivingWorkingCopy."
    # Validate against current SQL list.
    urls = set((r.get("url") or "").strip().lower() for r in list_giving_pages())
    if page_url.lower() not in urls:
        return False, ("That page is not in the eligible list. Enable a giving page "
                       "and set its shell to ShellGivingWorkingCopy, then try again.")
    if not html_exists(GIVING_WORKING_COPY) or not html_exists(GIVING_TEMPLATE):
        st, msg = action_install_files()
        if not st:
            return False, msg
    set_setting(CFG_GIVING_PAGE_URL, page_url)
    set_flag(CFG_GIVING_INSTALLED, True)
    return True, "Giving preview linked to /Give/" + page_url.lstrip("/")

def action_skip_giving():
    set_flag(CFG_GIVING_INSTALLED, False)
    return True, "Giving module skipped. You can install it later from the editor."

def action_configure_login(confirmed):
    if not confirmed:
        return False, "Check the confirmation box to install the login module."
    if not html_exists(LOGIN_TEMPLATE):
        st, msg = action_install_files()
        if not st:
            return False, msg
    set_setting(LOGIN_SHELL_SETTING, LOGIN_TEMPLATE)
    set_flag(CFG_LOGIN_INSTALLED, True)
    return True, "Login shell setting set to " + LOGIN_TEMPLATE + "."

def action_skip_login():
    set_flag(CFG_LOGIN_INSTALLED, False)
    return True, "Login module skipped. You can install it later from the editor."

def action_configure_menu(add_it):
    if not add_it:
        set_flag(CFG_MENU_INSTALLED, False)
        return True, "Menu entry skipped."
    xml = read_menu_xml()
    updated, changed = add_menu_entry(xml)
    if changed:
        write_menu_xml(updated)
        set_flag(CFG_MENU_INSTALLED, True)
        return True, "Added Shell Editor to " + MENU_XML_NAME + "."
    set_flag(CFG_MENU_INSTALLED, True)
    return True, "Shell Editor was already present in the admin reports menu."

