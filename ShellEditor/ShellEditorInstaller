def content_rows_by_name(names):
    """Read-only lookup of Special Content Id/TypeID by name."""
    clean = []
    for n in names or []:
        n = str(n or "").strip()
        if n and n not in clean:
            clean.append(n)
    if not clean:
        return {}
    in_list = ",".join("'" + n.replace("'", "''") + "'" for n in clean)
    sql = (
        "SELECT c.Id, c.Name, c.TypeID "
        "FROM dbo.Content c "
        "WHERE c.Name IN (" + in_list + ")"
    )
    found = {}
    try:
        for row in q.QuerySql(sql):
            name = str(getattr(row, "Name", "") or "")
            try:
                cid = int(getattr(row, "Id", 0) or 0)
            except Exception:
                cid = 0
            tid = getattr(row, "TypeID", None)
            try:
                tid = int(tid) if tid is not None and str(tid) != "" else None
            except Exception:
                tid = None
            if name and cid > 0:
                found[name] = {"id": cid, "typeId": tid}
    except Exception:
        found = {}
    return found

def _attach_content_ids(targets):
    rows = content_rows_by_name([t.get("name") for t in targets])
    for t in targets:
        info = rows.get(t.get("name"))
        if not info:
            continue
        t["id"] = info["id"]
        if info.get("typeId") is not None:
            t["typeId"] = info["typeId"]
    return targets

# SpecialContentTypes ids for DELETE ?type= (Html=0, PythonScript=5).
CONTENT_TYPE_HTML = 0
CONTENT_TYPE_PYTHON = 5

def uninstall_content_targets(remove_templates):
    """Special Content targets the browser deletes with session auth.

    typeId is the numeric SpecialContentTypes id required by the delete API.
    """
    targets = [{
        "name": EDITOR_NAME,
        "typeId": CONTENT_TYPE_PYTHON,
        "required": True,
    }]
    if remove_templates:
        for n in (REG_TEMPLATE, GIVING_TEMPLATE, GIVING_WORKING_COPY, LOGIN_TEMPLATE):
            targets.append({
                "name": n,
                "typeId": CONTENT_TYPE_HTML,
                "required": True,
            })
    # Prefer SQL Ids when available; keep declared typeIds as source of truth.
    rows = content_rows_by_name([t.get("name") for t in targets])
    for t in targets:
        info = rows.get(t.get("name"))
        if info:
            t["id"] = info["id"]
    return targets

def installer_delete_target():
    target = {
        "name": INSTALLER_NAME,
        "typeId": CONTENT_TYPE_PYTHON,
        "required": True,
    }
    rows = content_rows_by_name([INSTALLER_NAME])
    info = rows.get(INSTALLER_NAME)
    if info:
        target["id"] = info["id"]
    return target

def orgs_using_reg_shell(shell_name):
    """Involvement ids whose RegSetting still references the given shell name."""
    shell_name = (shell_name or "").strip()
    if not shell_name:
        return []
    safe = shell_name.replace("'", "''")
    sql = (
        "SELECT o.OrganizationId "
        "FROM dbo.Organizations o "
        "WHERE o.RegSetting LIKE '%" + safe + "%'"
    )
    ids = []
    try:
        for row in q.QuerySql(sql):
            try:
                oid = int(getattr(row, "OrganizationId", 0) or 0)
            except Exception:
                oid = 0
            if oid > 0 and oid not in ids:
                ids.append(oid)
    except Exception:
        ids = []
    return ids

