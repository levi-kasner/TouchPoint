        return False, "Admin reports menu file not found."
    if not menu_has_editor(xml):
        set_setting(CFG_MENU_INSTALLED, "")
        return True, "Shell Editor was not in the Admin reports menu."
    updated = remove_menu_editor_reports(xml)
    updated = cleanup_menu_empty_headers(updated)
    write_menu_xml(updated)
