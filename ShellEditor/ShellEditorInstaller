        var o=document.createElement('option');
        o.value=id;
        o.textContent=label;
        o.setAttribute('data-label', label.toLowerCase());
        sel.appendChild(o);
      });
      if(regCount) regCount.textContent=String((rows||[]).length);
      if(cur){
        sel.value=cur;
        var match=sel.options[sel.selectedIndex];
        if(match && match.value) collapseRegList(match);
        else hid.value='';
      }
