def action_install_files():
    if not PAYLOADS:
        return False, ("Installer payloads are empty. Run build_installer.py locally, "
                       "then re-upload ShellEditorInstaller.")
    order = [
        EDITOR_NAME,
        LOGIN_TEMPLATE,
        GIVING_TEMPLATE,
        REG_TEMPLATE,
        GIVING_WORKING_COPY,
    ]
    results = []
    for name in order:
        results.append(name + ": " + install_payload(name))
    # File install overwrites ShellEditor from the package; re-apply the preview id.
    inv = get_setting(CFG_INVOLVEMENT_ID)
    if inv.isdigit() and int(inv) > 0:
        if patch_editor_involvement_id(int(inv)):
            results.append("ShellEditor preview involvement: " + inv)
    set_flag(CFG_FILES_INSTALLED, True)
    return True, "; ".join(results)

def _finalize_registration_preview(org_id):
    """Pin shell, save setting, patch editor. Returns (ok, msg, org_id, needs_client_assign)."""
    org_id = int(org_id)
    if not html_exists(REG_TEMPLATE):
        st, msg = action_install_files()
        if not st:
            return False, msg, org_id, False
    needs_client_assign = False
    try:
        set_org_reg_shell(org_id, REG_TEMPLATE)
    except Exception:
        # Browser session can set regShellId via the same API the editor uses.
        needs_client_assign = True
    set_setting(CFG_INVOLVEMENT_ID, str(org_id))
    set_flag(CFG_REGISTRATION_INSTALLED, True)
    if not python_exists(EDITOR_NAME):
        action_install_files()
    patch_editor_involvement_id(org_id)
    return True, "", org_id, needs_client_assign

def action_configure_registration_select(preview_org_id):
    """Point the editor at an existing registration involvement (workaround path)."""
    try:
        org_id = int(preview_org_id)
    except Exception:
        return False, "Select a registration form involvement to use for preview.", 0, False
    if org_id <= 0:
        return False, "Select a registration form involvement to use for preview.", 0, False
    allowed = set(int(r["id"]) for r in list_reg_involvements() if r.get("id"))
    if org_id not in allowed:
        return (
            False,
            "That involvement is not in the eligible list. Create or open a registration "
            "form involvement, then refresh the list and try again.",
            0,
            False,
        )
    ok, msg, org_id, needs_client = _finalize_registration_preview(org_id)
    if not ok:
        return False, msg, org_id, False
    return (
        True,
        "Registration preview linked to involvement #" + str(org_id) + ".",
        org_id,
        needs_client,
    )

def action_configure_registration_create(template_org_id):
    """Create preview involvement via AddOrganization (preferred when platform bug is fixed)."""
    try:
        tid = int(template_org_id)
    except Exception:
        return False, "Select a registration involvement to copy settings from.", 0, False
    if tid <= 0:
        return False, "Select a registration involvement to copy settings from.", 0, False
    try:
        new_id = model.AddOrganization(PREVIEW_ORG_NAME, tid, True)
    except Exception as e:
        return False, "Could not create preview involvement: " + str(e), 0, False
    try:
        new_id = int(new_id)
    except Exception:
        return False, "AddOrganization did not return an involvement id.", 0, False
    if new_id <= 0:
        return False, "AddOrganization failed.", 0, False
    ok, msg, new_id, needs_client = _finalize_registration_preview(new_id)
    if not ok:
        return False, msg, new_id, False
    return (
        True,
        "Created involvement #" + str(new_id) + " (" + PREVIEW_ORG_NAME + ").",
        new_id,
        needs_client,
    )

def action_configure_registration(org_id):
    """Configure registration preview. Returns (ok, msg, org_id, needs_client_shell_assign).

    Strategy is controlled by USE_ADD_ORGANIZATION_FOR_REGISTRATION:
      False — select an existing registration form involvement (current workaround)
      True  — create a dedicated preview involvement from a template (preferred)
    """
    if USE_ADD_ORGANIZATION_FOR_REGISTRATION:
        return action_configure_registration_create(org_id)
    return action_configure_registration_select(org_id)

def action_configure_giving(page_url):
    page_url = (page_url or "").strip()
    if not page_url:
        return False, "Select a giving page that uses ShellGivingWorkingCopy."
    # Validate against current SQL list.
    urls = set((r.get("url") or "").strip().lower() for r in list_giving_pages())
    if page_url.lower() not in urls:
        return False, ("That page is not in the eligible list. Enable a giving page "
                       "and set its shell to ShellGivingWorkingCopy, then try again.")
    if not html_exists(GIVING_WORKING_COPY) or not html_exists(GIVING_TEMPLATE):
        st, msg = action_install_files()
        if not st:
            return False, msg
    set_setting(CFG_GIVING_PAGE_URL, page_url)
