def resolve_step():
    focus = ""
    if model.DataHas("focus"):
        focus = str(model.Dictionary("focus") or "").strip().lower()
    step = request_val("step").lower()
    # Developer-only uninstall wizard (separate from install progress).
    if focus == "uninstall" or step in UNINSTALL_STEPS:
        if not is_developer():
            return "welcome"
        if focus == "uninstall" and step not in UNINSTALL_STEPS:
            return "uninstall"
        if step in UNINSTALL_STEPS:
            return step
        return "uninstall"
    if focus in STEPS:
        if focus == "giving" and not flag_on(CFG_REGISTRATION_INSTALLED):
            return "registration"
        if focus == "login" and not flag_on(CFG_REGISTRATION_INSTALLED):
            return "registration"
        return focus
    if step in STEPS:
        return step
    files_ready = flag_on(CFG_FILES_INSTALLED) or (
        python_exists(EDITOR_NAME) and html_exists(REG_TEMPLATE)
    )
    if not files_ready:
        return "welcome"
    if not flag_on(CFG_REGISTRATION_INSTALLED):
        return "registration"
    # Continue optional steps only until each has an explicit 1/0 setting.
    if get_setting(CFG_GIVING_INSTALLED) == "":
        return "giving"
    if get_setting(CFG_LOGIN_INSTALLED) == "":
        return "login"
    # Menu step until the user decides. Presence comes from live XML (can be removed later).
    sync_menu_installed_flag()
    if get_setting(CFG_MENU_INSTALLED) == "":
        return "menu"
    return "done"

