def step_pills(current):
    labels = {
        "welcome": "1. Welcome",
        "files": "2. Files",
        "registration": "3. Registration",
        "giving": "4. Giving",
        "login": "5. Login",
        "menu": "6. Menu",
        "done": "Done",
    }
    order = STEPS
    html = ['<div class="sei-steps">']
    seen = True
    for s in order:
        cls = "sei-step"
        if s == current:
            cls += " on"
            seen = False
        elif seen:
            cls += " done"
        html.append('<span class="' + cls + '">' + esc(labels[s]) + "</span>")
    html.append("</div>")
    return "".join(html)

