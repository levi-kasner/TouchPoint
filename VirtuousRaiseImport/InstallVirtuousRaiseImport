def action_save_email_notice(send_notices, to_people_id, from_people_id):
    enabled = str(send_notices or "").strip().lower() in ("1", "true", "yes", "on")
    if not enabled:
        set_setting(SETTING_SEND_EMAIL, "")
        set_setting(SETTING_EMAIL_TO, "")
        set_setting(SETTING_EMAIL_SENDER, "")
        return True, "Email notices disabled."

    to_pid = parse_people_id(to_people_id)
    from_pid = parse_people_id(from_people_id)
    if not to_pid:
        return False, "Select who should receive success/failure email notices."
    if not from_pid:
        return False, "Select the sender (from) people record for email notices."
    if not person_exists(to_pid):
        return False, "Recipient PeopleId {0} was not found.".format(to_pid)
    if not person_exists(from_pid):
        return False, "Sender PeopleId {0} was not found.".format(from_pid)
    if not person_has_email(to_pid):
        return False, (
            "{0} has no primary email address. "
            "Choose a recipient with an email.".format(person_label(to_pid))
        )
    if not person_has_email(from_pid):
        return False, (
            "{0} has no primary email address. "
            "Choose a sender with an email.".format(person_label(from_pid))
        )

    set_setting(SETTING_SEND_EMAIL, "true")
    set_setting(SETTING_EMAIL_TO, str(to_pid))
    set_setting(SETTING_EMAIL_SENDER, str(from_pid))
    return True, "Email notices enabled (to {0}, from {1}).".format(
        person_label(to_pid), person_label(from_pid)
    )

def action_check_person_email(people_id):
    pid = parse_people_id(people_id)
    if not pid:
        return False, "Select a people record."
    if not person_exists(pid):
        return False, "PeopleId {0} was not found.".format(pid)
    if not person_has_email(pid):
        return False, (
            "{0} has no primary email address and cannot be used for notices.".format(
                person_label(pid)
            )
        )
    return True, person_label(pid)

def action_install():
    if not find_bundle_header_type():
        return False, (
            'A batch type (bundle header type) with Code "{0}" is required '
            "before installing.".format(BUNDLE_TYPE_CODE)
        )
    if not settings_complete():
        return False, "Complete every settings step before installing."
    if not (importBody or "").strip():
        return False, ("Installer is missing the embedded import script. "
                       "Run python build_installer.py locally, then re-upload.")
    model.WriteContentPython(IMPORT_SCRIPT_NAME, importBody, CONTENT_KEYWORD)
    try:
        existing = model.Content(MORNING_BATCH_NAME)
    except Exception:
        existing = None
    if existing is None:
        existing = ""
    existing = str(existing)
    if CALL_LINE not in existing:
        if existing.strip() == "":
            new_body = CALL_LINE + "\n"
        else:
            new_body = existing.rstrip() + "\n" + CALL_LINE + "\n"
        model.WriteContentPython(MORNING_BATCH_NAME, new_body)
    return True, "VirtuousRaiseImport installed and MorningBatch updated."

def import_delete_target():
    target = {
        "name": IMPORT_SCRIPT_NAME,
        "typeId": CONTENT_TYPE_PYTHON,
        "required": True,
    }
    rows = content_rows_by_name([IMPORT_SCRIPT_NAME])
    info = rows.get(IMPORT_SCRIPT_NAME)
    if info:
        target["id"] = info["id"]
    return target

def clear_integration_settings():
    for key in ALL_SETTINGS:
        try:
            set_setting(key, "")
        except Exception:
            pass

def remove_morning_batch_call():
    try:
        existing = model.Content(MORNING_BATCH_NAME)
    except Exception:
        existing = None
    if existing is None:
        return False
    existing = str(existing)
    if CALL_LINE not in existing:
        return False
    lines = []
    for line in existing.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if line.strip() == CALL_LINE.strip():
            continue
        lines.append(line)
    # Trim trailing blank lines introduced by removal, keep a final newline.
    while lines and lines[-1].strip() == "":
        lines.pop()
    new_body = "\n".join(lines)
    if new_body:
        new_body = new_body + "\n"
    model.WriteContentPython(MORNING_BATCH_NAME, new_body)
    return True

def action_uninstall():
    clear_integration_settings()
    removed_batch = remove_morning_batch_call()
    delete_targets = []
    if python_exists(IMPORT_SCRIPT_NAME):
        delete_targets.append(import_delete_target())
    msg = "Virtuous Raise import settings cleared"
    if removed_batch:
        msg += ", MorningBatch call removed"
    if delete_targets:
        msg += ", import script will be deleted"
    msg += "."
    return True, msg, delete_targets

