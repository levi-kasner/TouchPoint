  }
  function bindPeoplePicker(picker){
    if(!picker) return;
    var input=picker.querySelector('.vri-people-search');
    var hidden=picker.querySelector('.vri-people-id');
    var selected=picker.querySelector('.vri-people-selected');
    var results=picker.querySelector('.vri-people-results');
    if(!input || !hidden || !selected || !results) return;
    var timer=null;
    function setSelected(pid, name){
      hidden.value=String(pid||'');
      if(pid && name){
        selected.textContent='Selected: '+name+' (#'+pid+')';
        selected.className='vri-selected on vri-people-selected';
      } else if(pid){
        selected.textContent='Selected: #'+pid;
        selected.className='vri-selected on vri-people-selected';
      } else {
        selected.textContent='';
        selected.className='vri-selected vri-people-selected';
      }
    }
    function renderRows(rows){
      results.innerHTML='';
      if(!rows || !rows.length){
        results.innerHTML='<div class="vri-ac-empty">No matches.</div>';
        results.hidden=false;
        return;
      }
      rows.forEach(function(row){
        var pid=pidOf(row);
        var name=nameOf(row);
        if(!pid || !name) return;
        var btn=document.createElement('button');
        btn.type='button';
        btn.className='vri-ac-item';
        btn.innerHTML=name.replace(/&/g,'&amp;').replace(/</g,'&lt;')
          +'<span class="vri-ac-meta">PeopleId '+pid
          +(deceasedOf(row)?' · deceased':'')+'</span>';
        btn.addEventListener('click', function(){
          var requireEmail=picker.getAttribute('data-require-email')==='1';
          function accept(){
            setSelected(pid, name);
            input.value=name;
            results.hidden=true;
          }
          if(!requireEmail){
            accept();
