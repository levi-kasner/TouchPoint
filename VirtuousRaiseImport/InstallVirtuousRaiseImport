          }
          btn.disabled=true;
          var fd=new FormData();
          fd.set('action','check_person_email');
          fd.set('people_id',String(pid));
          fetch(window.location.pathname,{method:'POST',body:fd,credentials:'same-origin'})
            .then(function(r){ return r.text(); })
            .then(function(txt){
              var data=parseVriJson(txt);
              if(!data || data.ok===false || data.has_email===false){
                alert((data&&data.notice)||'This person has no primary email address.');
                return;
              }
              accept();
            })
            .catch(function(err){
              alert((err&&err.message)||'Could not verify email address.');
            })
            .then(function(){ btn.disabled=false; });
        });
        results.appendChild(btn);
      });
      results.hidden=false;
    }
    function search(q){
      results.innerHTML='<div class="vri-ac-status">Searching…</div>';
      results.hidden=false;
      fetch('/api/v1/People/Search/Autocomplete?q='+encodeURIComponent(q),{
        method:'GET',
        credentials:'same-origin',
        headers:{'Accept':'application/json'}
      }).then(function(r){
        if(!r.ok) throw new Error('People search failed ('+r.status+')');
        return r.json();
      }).then(function(rows){
        renderRows(Array.isArray(rows)?rows:[]);
      }).catch(function(err){
        results.innerHTML='<div class="vri-ac-empty">'
          +((err&&err.message)||'Search failed')+'</div>';
        results.hidden=false;
      });
    }
    input.addEventListener('input', function(){
      clearTimeout(timer);
      var q=String(input.value||'').trim();
      if(q.length<2){
        results.innerHTML='';
        results.hidden=true;
        return;
      }
      timer=setTimeout(function(){ search(q); }, 250);
    });
    document.addEventListener('click', function(ev){
      if(!results.contains(ev.target) && ev.target!==input){
        results.hidden=true;
      }
    });
  }
  function bindPeopleSearch(){
