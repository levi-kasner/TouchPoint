# ========================= MAIN =========================
try:
    action = request_val("action").lower()
    method = http_method()

    if method == "post":
        notice = ""
        notice_kind = "info"
        next_step = "welcome"
        ok = True
        delete_targets = None
        finish_after_delete = False
        if action == "check_person_email":
            ok, msg = action_check_person_email(request_val("people_id"))
            emit_json({
                "ok": bool(ok),
                "has_email": bool(ok),
                "notice": msg,
                "notice_kind": ("ok" if ok else "err"),
            })
        else:
            if action == "save_api_key":
                ok, msg = action_save_api_key(request_val("api_key"))
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "start_date" if ok else "api_key"
            elif action == "save_start_date":
                ok, msg = action_save_start_date(request_val("start_date"))
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "anonymous" if ok else "start_date"
            elif action == "save_anonymous":
                ok, msg = action_save_anonymous(request_val("people_id"))
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "email_notice" if ok else "anonymous"
            elif action == "save_email_notice":
                ok, msg = action_save_email_notice(
                    request_val("send_notices"),
                    request_val("to_people_id"),
                    request_val("from_people_id"),
                )
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "install" if ok else "email_notice"
            elif action == "install":
                ok, msg = action_install()
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "done" if ok else "install"
            elif action == "uninstall":
                ok, msg, delete_targets = action_uninstall()
                notice, notice_kind = msg, ("ok" if ok else "err")
                next_step = "uninstall_installer" if ok else "uninstall"
            elif action == "uninstall_installer":
                ok = True
                notice, notice_kind = "Installer removed.", "ok"
                next_step = "uninstall_done"
                delete_targets = [installer_delete_target()]
                finish_after_delete = True
            elif action == "keep_installer":
                ok = True
                notice, notice_kind = "Installer kept.", "info"
                next_step = "uninstall_done"
            else:
                ok = False
                notice = "Unknown installer action."
                notice_kind = "err"
                next_step = resolve_step()
            payload = {
                "ok": bool(ok),
                "step": next_step,
                "notice": notice,
                "notice_kind": notice_kind,
            }
            if finish_after_delete:
                payload["finish_after_delete"] = True
            if delete_targets:
                payload["delete_targets"] = delete_targets
            emit_json(payload)
    else:
        next_step = resolve_step()
        notice = request_val("notice") or None
        notice_kind = request_val("notice_kind") or "info"
        if notice_kind not in ("info", "ok", "warn", "err"):
            notice_kind = "info"
        model.Title = (
            "Virtuous Raise Import Uninstall"
            if next_step in UNINSTALL_STEPS
            else "Virtuous Raise Import Installer"
        )
        model.Header = ""
        model.Styles = STYLES
        model.Form = render_page(next_step, notice, notice_kind)
        model.Script = SCRIPT

except Exception:
    err = "<pre style='color:red'>" + traceback.format_exc() + "</pre>"
    if http_method() == "post":
        emit_json({
            "ok": False,
            "step": "welcome",
            "notice": traceback.format_exc(),
            "notice_kind": "err",
        })
    else:
        model.Form = err
