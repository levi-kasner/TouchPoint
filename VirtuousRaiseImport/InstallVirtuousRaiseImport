    uninstalling = step in UNINSTALL_STEPS
    if step == "welcome":
        body = render_welcome()
    elif step == "batch_type":
        body = render_batch_type()
    elif step == "api_key":
        body = render_api_key()
    elif step == "start_date":
        body = render_start_date()
    elif step == "anonymous":
        body = render_anonymous()
    elif step == "overwrite":
        body = render_overwrite()
    elif step == "email_notice":
        body = render_email_notice()
    elif step == "install":
        body = render_install()
    elif step == "uninstall":
        body = render_uninstall()
    elif step == "uninstall_installer":
        body = render_uninstall_installer()
    elif step == "uninstall_done":
        body = render_uninstall_done()
    else:
        body = render_done()

