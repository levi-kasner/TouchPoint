  function asSpecialContentList(payload){
    if(Array.isArray(payload)) return payload;
    if(!payload || typeof payload!=='object') return [];
    if(Array.isArray(payload.files)) return payload.files;
    if(Array.isArray(payload.items)) return payload.items;
    if(Array.isArray(payload.value)) return payload.value;
    if(Array.isArray(payload.data)) return payload.data;
    return [];
  }
  function fTypeId(f){
    if(!f) return null;
    var v=(f.type!=null?f.type:(f.Type!=null?f.Type:(f.typeId!=null?f.typeId:f.TypeId)));
    var n=parseInt(v,10);
    return isNaN(n)?null:n;
  }
  function fId(f){
    if(!f) return null;
    var v=(f.id!=null?f.id:f.Id);
    return v!=null?v:null;
  }
  function fName(f){
    if(!f) return '';
    return String(f.name!=null?f.name:(f.Name||''));
  }
  function findSpecialContentFile(files, name, typeId){
    var want=String(name||'').toLowerCase();
    var wantType=parseInt(typeId,10);
    var match=null;
    (files||[]).forEach(function(f){
      if(fName(f).toLowerCase()!==want) return;
      if(!isNaN(wantType) && fTypeId(f)===wantType) match=f;
    });
    return match;
  }
  function deleteSpecialContentTargets(targets){
    // Prefer Display/ContentDelete (removes ContentKeywords) over CmsApi DELETE.
    function resolveIds(){
      var missing=(targets||[]).some(function(t){ return t.id==null || String(t.id)===''; });
      if(!missing) return Promise.resolve(targets||[]);
      return fetch('/api/v1/SpecialContentFiles',{
        method:'GET',
        credentials:'same-origin',
        headers:{'Accept':'application/json'}
      }).then(function(r){
        if(!r.ok) throw new Error('Could not list Special Content ('+r.status+')');
        return r.json();
      }).then(function(payload){
        var files=asSpecialContentList(payload);
        return (targets||[]).map(function(t){
          if(t.id!=null && String(t.id)!=='') return t;
          var f=findSpecialContentFile(files, t.name, t.typeId);
          if(!f) return t;
          var copy={};
          for(var k in t){ if(Object.prototype.hasOwnProperty.call(t,k)) copy[k]=t[k]; }
          copy.id=fId(f);
          if(fTypeId(f)!=null) copy.typeId=fTypeId(f);
          return copy;
        });
      });
    }
    function deleteOne(t){
      var name=String(t.name||'');
      var id=t.id;
      if(id==null || String(id)===''){
        if(t.required) throw new Error('NOT FOUND: '+name+' (no content id)');
        return Promise.resolve(name+': not found');
      }
      var paths=[
        '/Display/ContentDelete/'+encodeURIComponent(id),
        '/Manage/Display/ContentDelete/'+encodeURIComponent(id)
      ];
      var attempt=function(url){
        return fetch(url,{
          method:'GET',
          credentials:'same-origin',
          redirect:'follow'
        }).then(function(r){
          if(r.ok || (r.status>=300 && r.status<400)) return name+': deleted';
          throw new Error('HTTP '+r.status);
        });
      };
      return attempt(paths[0]).catch(function(){
        return attempt(paths[1]);
      }).catch(function(err){
        throw new Error(
          'Could not delete '+name+' (id '+id+'): '
          +((err&&err.message)||err)
        );
      });
    }
    return resolveIds().then(function(list){
      var chain=Promise.resolve();
      var results=[];
      list.forEach(function(t){
        chain=chain.then(function(){
          return deleteOne(t).then(function(line){ results.push(line); });
        });
      });
      return chain.then(function(){ return results; });
    });
  }
  function pidOf(row){
    var v=row && (row.PeopleId!=null?row.PeopleId:row.peopleId);
    var n=parseInt(v,10);
