    return get_setting(SETTING_SEND_EMAIL).lower() in ("true", "1", "yes")

def overwrite_contact_info_enabled():
    # Default on when unset (matches historical import behavior).
    raw = get_setting(SETTING_OVERWRITE)
    if raw == "":
        return True
    return raw.lower() in ("true", "1", "yes")

def email_settings_ok():
    # Enabled => both people required with primary email. Disabled/empty => ok.
    if not send_email_notices_enabled():
        return True
    return (
        person_has_email(get_setting(SETTING_EMAIL_TO))
        and person_has_email(get_setting(SETTING_EMAIL_SENDER))
    )

def settings_complete():
    # From-start may be empty after the first successful import run; that is fine.
    if not find_bundle_header_type():
        return False
    if not get_setting(SETTING_API_KEY):
        return False
    if not get_setting(SETTING_START_DATE):
        return False
    if not person_exists(get_setting(SETTING_ANONYMOUS_ID)):
        return False
    if get_setting(SETTING_OVERWRITE) == "":
        return False
    return email_settings_ok()

def resolve_step():
    focus = ""
    if model.DataHas("focus"):
        focus = str(model.Dictionary("focus") or "").strip().lower()
    step = request_val("step").lower()
    if focus == "uninstall" or step in UNINSTALL_STEPS:
        if focus == "uninstall" and step not in UNINSTALL_STEPS:
            return "uninstall"
        if step in UNINSTALL_STEPS:
            return step
        return "uninstall"
    if step in STEPS:
        return step
    if not find_bundle_header_type():
        return "welcome" if not get_setting(SETTING_API_KEY) else "batch_type"
    if not get_setting(SETTING_API_KEY):
        return "welcome"
    if not get_setting(SETTING_START_DATE):
        return "start_date"
    if not person_exists(get_setting(SETTING_ANONYMOUS_ID)):
        return "anonymous"
    if get_setting(SETTING_OVERWRITE) == "":
        return "overwrite"
    if send_email_notices_enabled() and not email_settings_ok():
        return "email_notice"
    if not (python_exists(IMPORT_SCRIPT_NAME) and morning_batch_wired()):
        return "install"
    return "done"

