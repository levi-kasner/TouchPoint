      if(String(parts[i]).toLowerCase()==='pyscriptform' && parts[i+1]){
        return decodeURIComponent(parts[i+1]);
      }
    }
    return parts.length?decodeURIComponent(parts[parts.length-1]):'';
  }
  (function syncInstallerNameField(){
