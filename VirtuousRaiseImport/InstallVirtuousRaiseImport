def render_uninstall():
    return (
        "<p>This removes the Virtuous Raise import script, clears its settings, "
        "and removes its call from MorningBatch.</p>"
        '<div class="vri-alert warn">Contribution history already imported is not '
        "deleted. Only the integration configuration and scheduled import script "
        "are removed.</div>"
        '<form method="post" class="vri-form" id="vri-uninstall-form">'
        '<input type="hidden" name="step" value="uninstall" />'
