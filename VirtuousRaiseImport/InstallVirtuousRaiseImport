def render_uninstall_installer():
    name = resolve_installer_name()
    return (
        '<div class="vri-alert ok">Virtuous Raise import has been uninstalled.</div>'
        "<p>Do you also want to remove the installer script "
        '(<span class="vri-code">' + esc(name) + "</span>)?</p>"
        '<form method="post" class="vri-form" id="vri-uninstall-installer-form">'
        '<input type="hidden" name="step" value="uninstall_installer" />'
        '<input type="hidden" name="installer_name" id="vri-installer-name" value="'
        + esc(name) + '" />'
        '<div class="vri-actions">'
        '<button class="btn btn-primary" type="submit" name="action" '
        'value="uninstall_installer">Remove installer</button> '
        '<button class="btn btn-default" type="submit" name="action" '
        'value="keep_installer">Keep installer</button>'
        "</div></form>"
    )

def render_uninstall_done():
    return (
        "<p>Uninstall is complete.</p>"
        '<div class="vri-actions">'
        '<a class="btn btn-primary" href="/">Finish</a>'
        "</div>"
    )

def render_page(step, notice=None, notice_kind="info"):
    uninstalling = step in UNINSTALL_STEPS
    if step == "welcome":
        body = render_welcome()
    elif step == "batch_type":
        body = render_batch_type()
    elif step == "api_key":
        body = render_api_key()
    elif step == "start_date":
        body = render_start_date()
    elif step == "anonymous":
        body = render_anonymous()
    elif step == "email_notice":
        body = render_email_notice()
    elif step == "install":
        body = render_install()
    elif step == "uninstall":
        body = render_uninstall()
    elif step == "uninstall_installer":
        body = render_uninstall_installer()
    elif step == "uninstall_done":
        body = render_uninstall_done()
    else:
        body = render_done()

    notice_html = ""
    if notice:
        notice_html = (
            '<div class="vri-alert ' + esc(notice_kind) + '">' + notice + "</div>"
        )
    if uninstalling:
        title = "Virtuous Raise Import Uninstall"
        sub = "Remove the Virtuous Raise import from this church database."
        pills = uninstall_step_pills(step)
    else:
        title = "Virtuous Raise Import Installer"
        sub = "Configure settings, then install the morning-batch import."
        pills = step_pills(step)
    return "".join([
        '<div class="vri-wrap">',
        '<div class="vri-card">',
        '<h1 class="vri-h1">' + esc(title) + "</h1>",
        '<p class="vri-sub">' + esc(sub) + "</p>",
        pills,
        notice_html,
        body,
        "</div></div>",
    ])

SCRIPT = r"""
<script>
(function(){
