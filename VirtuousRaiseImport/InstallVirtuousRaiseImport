def verify_api_key(api_key):
    """POST a tiny Gift/query using the provided key; require a gift-query-shaped JSON body."""
    headers = {
        "Authorization": "Bearer " + api_key,
        "Content-Type": "application/json",
        "Accept": "text/plain",
    }
    # Far-future Create Date keeps the result empty while still exercising auth + query parsing.
    body = {
        "take": 1,
        "skip": 0,
        "sortBy": "createdate",
        "descending": True,
        "queryType": 3,
        "selectedColumns": ["Id", "Date", "Amount", "Status"],
        "groups": [{
            "conditions": [{
                "parameter": "Create Date",
                "operator": "GreaterThanOrEqual",
                "value": "2099-01-01",
            }]
        }],
    }
    try:
        raw = model.RestPostJson(GIFT_URL, headers, body)
    except Exception as e:
        return False, "Could not reach the Raise API: {0}".format(e)

    if raw is None or str(raw).strip() == "":
        return False, "Raise API returned an empty response. Check the key and try again."

    try:
        parsed = json.loads(str(raw))
    except Exception:
        snippet = str(raw).replace("\r", " ").replace("\n", " ").strip()
        if len(snippet) > 160:
            snippet = snippet[:160] + "…"
        return False, "Raise API did not return JSON. Response starts with: {0}".format(snippet)

    if not isinstance(parsed, dict):
        return False, "Raise API returned an unexpected response shape."

    keys = dict((str(k).lower(), k) for k in parsed.keys())
    if "items" in keys or "total" in keys:
        return True, "API key verified."

    err = (
        parsed.get("message")
        or parsed.get("Message")
        or parsed.get("error")
        or parsed.get("Error")
        or parsed.get("title")
        or parsed.get("Title")
    )
    if err:
        return False, "Raise API rejected the key: {0}".format(err)
    return False, "Raise API response did not look like a gift query result."

def action_save_api_key(api_key):
    api_key = (api_key or "").strip()
    if not api_key:
        return False, "Enter the Virtuous / Raise API key."
    ok, msg = verify_api_key(api_key)
    if not ok:
        return False, msg
    set_setting(SETTING_API_KEY, api_key)
    return True, msg

def action_save_start_date(start_date):
    start_date = (start_date or "").strip()
    if not start_date:
        return False, "Enter the Virtuous Import Start Date."
    parsed = model.ParseDate(start_date)
    if parsed is None:
        return False, 'Could not parse "{0}" as a date.'.format(start_date)
    normalized = parsed.ToString("yyyy-MM-dd")
    set_setting(SETTING_START_DATE, normalized)
    # Always reach back to the start date on the first import run after install.
    set_setting(SETTING_FROM_START, "true")
    return True, "Start date saved. First import will reach back to {0}.".format(normalized)

