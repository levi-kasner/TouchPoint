# ========================= HELPERS =========================
def esc(s):
    if s is None:
        return ""
    s = str(s)
    return (s.replace("&", "&amp;").replace("<", "&lt;")
             .replace(">", "&gt;").replace('"', "&quot;"))

def get_setting(key):
    try:
        return str(model.GetSetting(key) or "").strip()
    except Exception:
        try:
            return str(model.Setting(key) or "").strip()
        except Exception:
            return ""

def set_setting(key, value):
    model.SetSetting(key, "" if value is None else str(value))

def request_val(key, default=""):
    if model.DataHas(key):
        return str(model.Dictionary(key) or "").strip()
    return default

def http_method():
    try:
        return str(model.HttpMethod or "get").lower()
    except Exception:
        return "get"

def emit_json(payload):
    """Return JSON for PyScriptForm AJAX POSTs (model.Form is GET-only)."""
    body = "<!--VRI_JSON-->" + json.dumps(payload) + "<!--/VRI_JSON-->"
    model.Header = ""
    model.Styles = ""
    model.Script = ""
    model.Form = body
    try:
        print(body)
    except Exception:
        pass

def python_exists(name):
    try:
        return bool(model.PythonContent(name))
    except Exception:
        return False

def content_rows_by_name(names):
    """Read-only lookup of Special Content Id/TypeID by name."""
    clean = []
    for n in names or []:
        n = str(n or "").strip()
        if n and n not in clean:
            clean.append(n)
    if not clean:
        return {}
    in_list = ",".join("'" + n.replace("'", "''") + "'" for n in clean)
    sql = (
        "SELECT c.Id, c.Name, c.TypeID "
        "FROM dbo.Content c "
        "WHERE c.Name IN (" + in_list + ")"
    )
    found = {}
    try:
        for row in q.QuerySql(sql):
            name = str(getattr(row, "Name", "") or "")
            try:
                cid = int(getattr(row, "Id", 0) or 0)
            except Exception:
                cid = 0
            tid = getattr(row, "TypeID", None)
            try:
                tid = int(tid) if tid is not None and str(tid) != "" else None
            except Exception:
                tid = None
            if name and cid > 0:
                found[name] = {"id": cid, "typeId": tid}
    except Exception:
        found = {}
    return found

def installer_name_from_path(path):
    """Extract Special Content name from a /PyScriptForm/<Name> path."""
    path = str(path or "").strip()
    if not path:
        return ""
    # Drop query/fragment if present.
    if "?" in path:
        path = path.split("?", 1)[0]
    if "#" in path:
        path = path.split("#", 1)[0]
    parts = [p for p in path.replace("\\", "/").split("/") if p]
    for i, part in enumerate(parts):
        if part.lower() == "pyscriptform" and i + 1 < len(parts):
            return parts[i + 1]
    if parts:
        return parts[-1]
    return ""

def resolve_installer_name():
    """Prefer the live script name so renamed installer copies still clean up."""
    # TouchPoint sets model.Data.pyscript to the Python Special Content name.
    try:
        if model.DataHas("pyscript"):
            name = str(model.Dictionary("pyscript") or "").strip()
            if name:
                return name
    except Exception:
        pass
    try:
        name = str(getattr(model.Data, "pyscript", "") or "").strip()
        if name:
            return name
    except Exception:
        pass

    # Fall back to request URL / referrer path when available.
    for attr in ("Url", "RawUrl", "RequestUrl", "PathAndQuery", "Path"):
        try:
            name = installer_name_from_path(getattr(model, attr, ""))
            if name:
                return name
        except Exception:
            pass

    # Client can pass the pathname segment on finish POSTs.
    posted = request_val("installer_name")
    if posted:
        return posted

    return INSTALLER_NAME

def installer_delete_target():
    name = resolve_installer_name()
    target = {
        "name": name,
        "typeId": CONTENT_TYPE_PYTHON,
        "required": True,
    }
    rows = content_rows_by_name([name])
    info = rows.get(name)
    if info:
        target["id"] = info["id"]
    return target

def morning_batch_wired():
    try:
        existing = model.Content(MORNING_BATCH_NAME) or ""
    except Exception:
        existing = ""
    return CALL_LINE in existing

def parse_people_id(raw):
    try:
        pid = int(str(raw or "").strip())
        return pid if pid > 0 else 0
    except Exception:
        return 0

def person_label(pid):
    pid = parse_people_id(pid)
    if not pid:
        return ""
    try:
        rows = q.QuerySql(
            "select top 1 Name from dbo.People where PeopleId = {0}".format(pid)
        )
        for row in rows:
            name = str(getattr(row, "Name", "") or "").strip()
            if name:
                return name + " (#" + str(pid) + ")"
    except Exception:
        pass
    return "#" + str(pid)

def person_exists(pid):
    pid = parse_people_id(pid)
    if not pid:
        return False
    try:
        return q.QuerySqlInt(
            "select count(*) from dbo.People where PeopleId = {0}".format(pid)
        ) > 0
    except Exception:
        return False

def person_has_email(pid):
    """True when the person exists and has a non-empty primary EmailAddress."""
    pid = parse_people_id(pid)
    if not pid:
        return False
    try:
        return q.QuerySqlInt(
            "select count(*) from dbo.People "
            "where PeopleId = {0} "
            "and nullif(ltrim(rtrim(EmailAddress)), '') is not null".format(pid)
        ) > 0
    except Exception:
        return False

def find_bundle_header_type():
    """Return {id, code, description} for Code=VRDI, or None."""
    sql = (
        "select top 1 Id, Code, Description "
        "from lookup.BundleHeaderTypes "
        "where Code = '{0}'".format(BUNDLE_TYPE_CODE.replace("'", "''"))
    )
    try:
        for row in q.QuerySql(sql):
            return {
                "id": int(row.Id),
                "code": str(getattr(row, "Code", "") or ""),
                "description": str(getattr(row, "Description", "") or ""),
            }
    except Exception:
        return None
    return None

def send_email_notices_enabled():
    return get_setting(SETTING_SEND_EMAIL).lower() in ("true", "1", "yes")

def email_settings_ok():
    # Enabled => both people required with primary email. Disabled/empty => ok.
    if not send_email_notices_enabled():
        return True
    return (
        person_has_email(get_setting(SETTING_EMAIL_TO))
        and person_has_email(get_setting(SETTING_EMAIL_SENDER))
    )

def settings_complete():
    # From-start may be empty after the first successful import run; that is fine.
    if not find_bundle_header_type():
        return False
    if not get_setting(SETTING_API_KEY):
        return False
    if not get_setting(SETTING_START_DATE):
        return False
    if not person_exists(get_setting(SETTING_ANONYMOUS_ID)):
        return False
    return email_settings_ok()

def resolve_step():
    focus = ""
    if model.DataHas("focus"):
        focus = str(model.Dictionary("focus") or "").strip().lower()
    step = request_val("step").lower()
    if focus == "uninstall" or step in UNINSTALL_STEPS:
        if focus == "uninstall" and step not in UNINSTALL_STEPS:
            return "uninstall"
        if step in UNINSTALL_STEPS:
            return step
        return "uninstall"
    if step in STEPS:
        return step
    if not find_bundle_header_type():
        return "welcome" if not get_setting(SETTING_API_KEY) else "batch_type"
    if not get_setting(SETTING_API_KEY):
        return "welcome"
    if not get_setting(SETTING_START_DATE):
        return "start_date"
    if not person_exists(get_setting(SETTING_ANONYMOUS_ID)):
        return "anonymous"
    if send_email_notices_enabled() and not email_settings_ok():
        return "email_notice"
    if not (python_exists(IMPORT_SCRIPT_NAME) and morning_batch_wired()):
        return "install"
    return "done"

