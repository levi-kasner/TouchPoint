#### Start-date resolution -----------------------------------------------------  
  
def ResolveStartDates():  
    # Returns (approvedStart, returnsStart) as 'YYYY-MM-DD' strings.  
    # Virtuous Import Start Date is a permanent floor (never look earlier).  
    # When "Virtuous Import From Start Date" is true, both passes start at  
    # that floor for this run; otherwise use the default lookback windows,  
    # still clamped to the floor.  
    global emailNotes  
    defaultApproved = (date.today() - timedelta(days=daysBack)).strftime('%Y-%m-%d')  
    defaultReturns  = (date.today() - timedelta(days=returnsDaysBack)).strftime('%Y-%m-%d')  
  
    floor = None  
    raw = model.Setting(startDateSetting, '')  
    if raw is not None and str(raw).strip() != '':  
        parsed = model.ParseDate(raw)  
        if parsed is None:  
            emailNotes += ('Invalid Virtuous Import Start Date setting "{0}". '  
                           'Ignoring floor.\n').format(raw)  
        else:  
            floor = parsed.ToString("yyyy-MM-dd")  
  
    if IsTruthySetting(model.Setting(fromStartDateSetting, '')):  
        if floor:  
            return floor, floor  
        emailNotes += ('Virtuous Import From Start Date is set, but '  
                       'Virtuous Import Start Date is empty/invalid. '  
                       'Fell back to default lookback.\n')  
        return defaultApproved, defaultReturns  
  
    approvedStart = defaultApproved  
    returnsStart  = defaultReturns  
    # zero-padded ISO strings compare lexicographically == chronologically  
    if floor:  
        if approvedStart < floor:  
            approvedStart = floor  
        if returnsStart < floor:  
            returnsStart = floor  
    return approvedStart, returnsStart  
  
  
#### Raise API -----------------------------------------------------------------  
  
def BuildQueryBody(startDate, statuses, skip):  
    statusCondition = { "parameter": "Status", "operator": "IsAnyOf", "values": statuses }  
  
    return {  
        "take": take,  
        "skip": skip,  
        "sortBy": "createdate",  
        "descending": False,  # oldest first so batches are created chronologically  
        "queryType": 3,  
        "selectedColumns": selectedColumns,  
        "groups": [  
            { "conditions": [  
                { "parameter": "Create Date", "operator": "GreaterThanOrEqual", "value": startDate },  
                statusCondition  
            ] }  
        ]  
    }  
  
def FetchGifts(startDate, statuses, skip):  
    body = BuildQueryBody(startDate, statuses, skip)  
    results = model.RestPostJson(giftUrl, header, body)
    # print results
    return model.DynamicDataFromJson(results)  
  
  
#### Mapping helpers -----------------------------------------------------------  
  
def FindContributionSourceId(description):  
    sql = "select top 1 Id from lookup.ContributionSources where Description = '{0}'".format(description)  
    sid = q.QuerySqlInt(sql)  
    return sid if sid else None  
  
def GetSourceIdForPaymentInfo(paymentInfo):  
    # paymentInfo looks like "Visa x7923" or "ACH Checking x0556"; map the leading token  
    if not paymentInfo:  
        return None  
    token = str(paymentInfo).strip().split(' ')[0].lower()  
    mapping = {  
        'ach':        'ACH',  
        'visa':       'Bankcard',  
        'mastercard': 'Bankcard',  
        'discover':   'Bankcard',  
        'amex':       'Bankcard',  
        'american':   'Bankcard',  
        'credit':     'Bankcard',  
        'debit':      'Bankcard',  
        'cash':       'Offering Plate',  
        'check':      'Offering Plate',  
    }  
    desc = mapping.get(token)  
    return FindContributionSourceId(desc) if desc else None  
  
def ParseAmount(raw, negate):  
    # raw looks like "$60.00" or "$1,200.00"  
    val = str(raw).replace('$', '').replace(',', '').strip()  
    if negate:  
        val = '-' + val  
    return val  
  
  
#### People --------------------------------------------------------------------  
  
def GetOrCreatePerson(t):  
    m = t.metadata  
    donorId   = int(m[metaIndex["Donor Id"]])  
    first     = m[metaIndex["Donor First Name"]]  
    last      = m[metaIndex["Donor Last Name"]]  
    email     = m[metaIndex["Donor Email"]]  
    phone     = m[metaIndex["Donor Phone"]]  
    addr1     = m[metaIndex["Billing Address Line 1"]]  
    addr2     = m[metaIndex["Billing Address Line 2"]]  
    city      = m[metaIndex["Billing Address City"]]  
    stateName = m[metaIndex["Billing Address State"]]  
    zipCode   = m[metaIndex["Billing Address Postal"]]  
    state     = states.get(stateName, stateName)  
  
    # 1. match on the RaiseDonorId extra value (read-write context, no raw SQL fn)  
    pid = model.FindPersonIdExtraValueInt(donorIdField, donorId)  
    # 2. match on name/email/phone  
    if not pid:  
        pid = model.FindPersonId(first, last, None, email, phone)  
    # 3. otherwise create  
    if not pid:  
        pid = model.AddPerson(first, first, last, email)  
  
    # keep contact info current  
    if addr1:   model.UpdateNamedField(pid, 'AddressLineOne', addr1)  
    if addr2:   model.UpdateNamedField(pid, 'AddressLineTwo', addr2)  
    if city:    model.UpdateNamedField(pid, 'CityName', city)  
    if state:   model.UpdateNamedField(pid, 'StateCode', state)  
    if zipCode: model.UpdateNamedField(pid, 'ZipCode', zipCode)  
    if email:   model.UpdateNamedField(pid, 'EmailAddress', email)  
    if phone:   model.UpdateNamedField(pid, 'CellPhone', phone)  
  
    # stamp the donor id so future matches hit step 1  
    model.AddExtraValueInt(pid, donorIdField, donorId)  
    return pid  
  
  
#### De-dup --------------------------------------------------------------------  
  
def IsNewGift(giftId, negate):  
    prefix = "Raise Refund" if negate else "Raise Gift"  
    meta = "{0} #{1}".format(prefix, giftId)  
    sql = "select count(*) from dbo.Contribution where MetaInfo = '{0}'".format(meta)  
    return q.QuerySqlInt(sql) == 0  
  
  
#### Bundles -------------------------------------------------------------------  
  
def FindBundleByCodeAndRef(refId):  
    # Find an existing bundle by BundleHeaderTypes.Code + ReferenceId (not Description).  
    # FindBundleHeader still needs a description string to return the object, so once we  
    # confirm a VRDI match via SQL, load it with that row's Description.  
    sql = (  
        "select top 1 t.Description "  
        "from dbo.BundleHeader h "  
        "join lookup.BundleHeaderTypes t on t.Id = h.BundleHeaderTypeId "  
        "where t.Code = '{0}' and h.ReferenceId = '{1}'".format(  
            bundleTypeCode.replace("'", "''"),  
            str(refId).replace("'", "''"),  
        )  
    )  
    for row in q.QuerySql(sql):  
        desc = str(getattr(row, "Description", "") or "").strip()  
        if desc:  
            return model.FindBundleHeader(desc, refId)  
        break  
    return None  
  
def GetOrCreateBundle(bundleDate):  
    # bundleDate is a .NET DateTime; reference id = the calendar date so the same  
    # day's gifts land in one bundle and get reused across pages / runs  
    refId = bundleDate.ToString("yyyy-MM-dd")  
    bh = FindBundleByCodeAndRef(refId)  
    if bh is None:  
        # date, now, bundleTypeId, depositDate, bundleTotal  
        bh = model.GetBundleHeader(bundleDate, model.DateTime.Now, bundleTypeId, bundleDate, None)  
        bh.ReferenceId = refId  
    return bh  
  
  
#### Gift processing -----------------------------------------------------------  
  
def ProcessGift(t, bundleHeader, negate):  
    pid = anonymousId if t.isAnonymous else GetOrCreatePerson(t)  
    giftId      = t.id  
    Date        = model.ParseDate(t.metadata[metaIndex["Date"]])  
    paymentInfo = t.metadata[metaIndex["Tender Type Info"]]  
    sourceId    = GetSourceIdForPaymentInfo(paymentInfo)  
    metaPrefix  = "Raise Refund" if negate else "Raise Gift"  
  
    for p in t.projects:  
        Amount = ParseAmount(p.amount, negate)  
        cf = model.FetchOrCreateFund(p.name)  
        bd = model.AddContributionDetail(Date, cf.FundId, Amount, None, None, None)  
        bd.Contribution.PeopleId = pid  
        bd.Contribution.ContributionTypeId = 1  
        bd.Contribution.MetaInfo = "{0} #{1}".format(metaPrefix, giftId)  
        if sourceId is not None:  
            bd.Contribution.ContributionSourceId = sourceId  
        bundleHeader.BundleDetails.Add(bd)  
  
  
#### Passes --------------------------------------------------------------------  
  
def ImportPass(startDate, statuses, negate):  
    skip = 0  
    bundles = {}  
    while True:  
        gifts = FetchGifts(startDate, statuses, skip)  
        if gifts is None:  
            break  
        items = gifts.items  
        if not items:  
            break  
        for t in items:  
            if not IsNewGift(t.id, negate):  
                continue  
            bundleDate = model.ParseDate(t.metadata[metaIndex["Date"]])  
            if bundleDate is None:  
                continue  
            refId = bundleDate.ToString("yyyy-MM-dd")  
            if refId in bundles:  
                bh = bundles[refId]  
            else:  
                bh = GetOrCreateBundle(bundleDate)  
                bundles[refId] = bh  
            ProcessGift(t, bh, negate)  
        skip += take  
        if skip >= gifts.total:  
            break  
  
    # Finish oldest date first (refId is yyyy-MM-dd).  
    for refId in sorted(bundles.keys()):  
        model.FinishBundle(bundles[refId])  
  
  
def ProcessMain():  
    approvedStart, returnsStart = ResolveStartDates()  
    ImportPass(approvedStart, ['Approved'], False)  
    ImportPass(returnsStart, ['ChargeBack', 'Refunded'], True)  
    # one-shot flag; leave Virtuous Import Start Date intact as the permanent floor  
    model.SetSetting(fromStartDateSetting, '')  
  
  
#### Entry point ---------------------------------------------------------------  
  
def SendNoticeEmail(subject, body):  
    # Never let notice delivery abort the import (missing/invalid from/to email, etc.).  
    if not sendEmailNotices:  
        return  
    if not emailNoticeToId or not emailNoticeSenderId:  
        return  
    try:  
        model.Email(  
            emailNoticeToId, emailNoticeSenderId,  
            "info@touchpointsoftware.com", "TouchPoint Admin",  
            subject, body  
        )  
    except Exception as e:  
        print("Raise import notice email failed: %s" % e)  
  
try:  
    ProcessMain()  
    body = "The Raise import has run."  
    if emailNotes:  
        body = body + "\n\n" + emailNotes  
    SendNoticeEmail("Raise Import", body)  
except Exception as e:  
    msg = "Error running the Raise Import module: %s\n" % e  
    print(msg)  
    SendNoticeEmail("Raise Import failure", msg)